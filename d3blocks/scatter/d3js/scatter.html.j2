  for (var k = 0; k < pts.length; k += 2) {
    var cx = Math.min(cellsX - 1, Math.max(0, Math.floor((pts[k] - minX) / cellW)));
    var cy = Math.min(cellsY - 1, Math.max(0, Math.floor((pts[k + 1] - minY) / cellH)));
