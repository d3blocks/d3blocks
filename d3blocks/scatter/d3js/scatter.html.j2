function applySizeMode(key){
  if(!key){for(var i=0;i<jsonData.length;i++)if(jsonData[i])jsonData[i][3]=initialRadii[i];refreshPhysicsCollisionRadii();scheduleRender();return;}
  var min=Infinity,max=-Infinity;
  for(var i=0;i<jsonData.length;i++){var v=jsonData[i]&&jsonData[i][13]?jsonData[i][13][key]:NaN;if(typeof v==='number'&&Number.isFinite(v)){if(v<min)min=v;if(v>max)max=v;}}
