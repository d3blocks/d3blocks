    if (!Number.isFinite(currentXVal[i]) || !Number.isFinite(currentYVal[i])) continue;
    var prev = physicsNodeByIndex && physicsNodeByIndex.get(i);
    nodes.push({
      i: i,
      x: prev ? prev.x : physicsAnchorX(i),
      y: prev ? prev.y : physicsAnchorY(i),
      vx: prev ? prev.vx : 0,
