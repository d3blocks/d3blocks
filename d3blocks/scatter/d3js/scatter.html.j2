// max radius.
var SIZE_RANGE_MIN_GAP = 0.5; // smallest allowed px distance between thumbs, so they never fully collide
var sizeRangeMinSlider = document.getElementById('sizeRangeMinSlider');
var sizeRangeMaxSlider = document.getElementById('sizeRangeMaxSlider');
var sizeRangeVal = document.getElementById('sizeRangeVal');
var sizeRangeFill = document.getElementById('sizeRangeFill');

function updateSizeRangeUI(activeInput) {
  if (!sizeRangeMinSlider || !sizeRangeMaxSlider) return;
  var minPos = parseFloat(sizeRangeMinSlider.value);
  var maxPos = parseFloat(sizeRangeMaxSlider.value);
  if (maxPos - minPos < SIZE_RANGE_MIN_GAP) {
    // Keep the thumb the user is actually dragging in control; push the
    // other one out of the way rather than letting them swap past each other.
    if (activeInput === sizeRangeMaxSlider) {
      maxPos = minPos + SIZE_RANGE_MIN_GAP;
      sizeRangeMaxSlider.value = maxPos;
    } else {
      minPos = maxPos - SIZE_RANGE_MIN_GAP;
      sizeRangeMinSlider.value = minPos;
    }
  }
  radiusClampMin = minPos;
  radiusClampMax = maxPos;
  if (sizeRangeVal) sizeRangeVal.textContent = radiusClampMin.toFixed(1) + 'px – ' + radiusClampMax.toFixed(1) + 'px';
  if (sizeRangeFill) {
    var lo = parseFloat(sizeRangeMinSlider.min), hi = parseFloat(sizeRangeMinSlider.max);
    var leftPct = (minPos - lo) / (hi - lo) * 100;
    var rightPct = (maxPos - lo) / (hi - lo) * 100;
    sizeRangeFill.style.left = leftPct + '%';
    sizeRangeFill.style.width = Math.max(0, rightPct - leftPct) + '%';
