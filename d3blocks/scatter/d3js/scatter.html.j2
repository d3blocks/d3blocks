}

function startPhysicsSimulation(settleOnly) {
  if (!physicsSupported) return;
  physicsNodes = buildPhysicsNodes();
  physicsNodeByIndex = new Map();
  physicsNodes.forEach(function(n) { physicsNodeByIndex.set(n.i, n); });

  if (forceSim) forceSim.stop();
  forceSim = d3.forceSimulation(physicsNodes)
    .alpha(1)
