  if(numeric&&has){currentColorScale=d3.scaleSequential(d3.interpolateViridis).domain([min,max]);currentColorAccessor=function(d){var v=d&&d[11]?d[11][key]:null;return typeof v==='number'&&Number.isFinite(v)?currentColorScale(v):d[2];};}
  else {var uniq=Array.from(new Set(vals.filter(function(v){return v!=null;}))),palette=d3.schemeCategory10.concat(d3.schemeSet3||[]),scale=d3.scaleOrdinal().domain(uniq).range(palette);currentColorScale=scale;currentColorAccessor=function(d){var v=d&&d[11]?d[11][key]:null;return v!=null?scale(v):d[2];};}
  scheduleRender();
}
function applyShapeMode(val){
  categoricalShapeMap=null;categoricalShapeKey=null;
  if(!val||SHAPE_MAP[val]){currentShapeMode=val||'circle';scheduleRender();return;}
  if(val.indexOf('prop:')===0){var key=val.slice(5),uniq=[],seen=new Set();
    for(var i=0;i<jsonData.length;i++){var v=jsonData[i]&&jsonData[i][11]?jsonData[i][11][key]:null;if(v!=null&&!seen.has(v)){seen.add(v);uniq.push(v);}}
    var names=Object.keys(SHAPE_MAP);categoricalShapeMap={};uniq.forEach(function(v,i){categoricalShapeMap[v]=names[i%names.length];});categoricalShapeKey=key;scheduleRender();
  }
}

// —— Point labels (only drawn when zoomed in enough) ——
var currentLabelKey = null; // null | '__tooltip__' | property key
var labelGroup = svg.append('g').attr('class', 'point-labels').style('pointer-events', 'none');
var LABEL_ZOOM_THRESHOLD = 2.0; // show labels when domain is at least this factor smaller than original

function currentCoordIndices() {
  var modeNode = d3.select('input[name="radio_states"]:checked').node();
  var mode = modeNode ? modeNode.value : 'radiobutton1';
  if (mode === 'radiobutton2') return [7, 8];
  if (mode === 'radiobutton3') return [9, 10];
  return [0, 1];
}

// Tracks the coordinate pair actually on screen right now. Needed because a
// radio 'change' event fires AFTER the DOM's :checked state has already
// flipped to the new button, so currentCoordIndices() can't be used to find
// the *previous* position from inside the handler -- it would return the
// same (new) indices as the target, collapsing the slide into an instant
// jump. This variable is only updated once an animation finishes.
var activeCoordIndices = currentCoordIndices();

// Per-point live on-screen position (in data space), kept up to date every
// animation frame during a coordinate-mode transition. If the user picks a
// new target mid-transition, the next animation reads its starting point
// from here -- the points' actual current position -- rather than from
// activeCoordIndices (which only updates when a transition finishes and
// would otherwise be stale, making points visibly snap back to where the
// PREVIOUS transition started before animating to the new target).
var currentXVal = new Array(jsonData.length);
var currentYVal = new Array(jsonData.length);
(function initCurrentCoordVals() {
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    currentXVal[i] = d ? +d[activeCoordIndices[0]] : NaN;
    currentYVal[i] = d ? +d[activeCoordIndices[1]] : NaN;
  }
})();

function labelTextFor(d) {
  if (!currentLabelKey) return '';
  if (currentLabelKey === '__tooltip__') return (d && d[6] != null) ? String(d[6]) : '';
  if (d && d[11] && d[11][currentLabelKey] != null) {
    var v = d[11][currentLabelKey];
    return (typeof v === 'object') ? JSON.stringify(v) : String(v);
  }
  return '';
}

function isZoomedInEnough() {
  var xd = x.domain(), yd = y.domain();
  var xSpan = Math.abs(xd[1] - xd[0]);
  var ySpan = Math.abs(yd[1] - yd[0]);
  var x0Span = Math.abs(x0[1] - x0[0]) || 1;
  var y0Span = Math.abs(y0[1] - y0[0]) || 1;
  var zoomFactor = Math.min(x0Span / xSpan, y0Span / ySpan);
  return zoomFactor >= LABEL_ZOOM_THRESHOLD;
}

function updatePointLabels() {
  if (!currentLabelKey || !isZoomedInEnough()) {
    labelGroup.selectAll('text').remove();
    return;
  }
  var coords = currentCoordIndices();
  var xi = coords[0], yi = coords[1];
  var xd = x.domain(), yd = y.domain();
  // Only label points currently in the visible domain (keeps cost low when zoomed in)
  var visible = [];
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    if (!d) continue;
    var xv = d[xi], yv = d[yi];
    if (xv >= xd[0] && xv <= xd[1] && yv >= yd[0] && yv <= yd[1]) {
      visible.push({ d: d, i: i });
    }
  }
  var labels = labelGroup.selectAll('text').data(visible, function(v){ return v.i; });
  labels.exit().remove();
  labels.enter().append('text')
    .attr('class', 'point-label')
    .style('font-size', '11px')
    .style('paint-order', 'stroke')
    .style('stroke', 'var(--bg, #fff)')
    .style('stroke-width', '3px')
    .style('stroke-linejoin', 'round')
    .style('fill', 'var(--text, #222)')
    .merge(labels)
    .text(function(v){ return labelTextFor(v.d); })
    .attr('x', function(v){ return jitteredPoint(v.i, x(v.d[xi]), y(v.d[yi])).px + 8; })
    .attr('y', function(v){ return jitteredPoint(v.i, x(v.d[xi]), y(v.d[yi])).py + 3; });
}

function applyLabelMode(key) {
  currentLabelKey = key || null;
  updatePointLabels();
}

