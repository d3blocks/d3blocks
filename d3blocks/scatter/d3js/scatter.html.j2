// Node panel DOM refs and behavior
const nodePanel = document.getElementById("nodePanel");
const nodePanelTitle = document.getElementById("nodePanelTitle");
const nodePanelSub = document.getElementById("nodePanelSub");
const nodeStatsGrid = document.getElementById("nodeStatsGrid");
const nodePanelClose = document.getElementById("nodePanelClose");

function escapeHtml(v) {
  if (v == null) return '';
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// URLs (http/https/ftp/www.) and absolute file paths (unix or Windows) are
// rendered as clickable links; everything else is shown as plain text.
var URL_RE = /^(https?:\/\/|ftp:\/\/)\S+$/i;
var WWW_RE = /^www\.\S+\.\S+$/i;
var FILE_URL_RE = /^file:\/\/\S+$/i;
var UNIX_PATH_RE = /^\/[^\s]+$/;
var WIN_PATH_RE = /^[A-Za-z]:\\[^\s]+$/;

function formatPropertyValue(v) {
  if (v == null) return '';
  if (typeof v === 'string') {
    var s = v.trim();
    var isLink = URL_RE.test(s) || WWW_RE.test(s) || FILE_URL_RE.test(s) || UNIX_PATH_RE.test(s) || WIN_PATH_RE.test(s);
    if (isLink) {
      var href = (WWW_RE.test(s)) ? ('https://' + s)
                : (UNIX_PATH_RE.test(s) || WIN_PATH_RE.test(s)) ? ('file://' + s)
                : s;
      return '<a class="node-info-link" href="' + escapeHtml(href) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(s) + '</a>';
    }
  }
  return escapeHtml(v);
}

function showNodePanel(d) {
  // d is an array of values: use d[6] as tooltip if present
  const title = (d && d[6]) ? d[6] : (d && d[0] != null ? String(d[0]) : 'Point');
  nodePanelTitle.textContent = title;
  const sub = (d && d[0] != null && d[1] != null) ? `x: ${d[0]}, y: ${d[1]}` : '';
  nodePanelSub.textContent = sub;
  // Render some basic stats
  if (nodeStatsGrid) {
    // Basic stats
    var html = '<div class="node-info-grid">';
    html += '<span class="node-info-label">Radius</span><span class="node-info-value">' + escapeHtml(d[3]) + '</span>';
    html += '<span class="node-info-label">Opacity</span><span class="node-info-value">' + escapeHtml(d[4]) + '</span>';
    html += '<span class="node-info-label">Stroke</span><span class="node-info-value">' + escapeHtml(d[5]) + '</span>';
    // Additional user properties (if present as last element d[11])
    var props = (d && d[11]) ? d[11] : null;
    if (props && typeof props === 'object') {
      html += '<div class="node-info-section-title">Properties</div>';
      // Property list
      Object.keys(props).forEach(function(k){
        var v = props[k];
        // stringify objects/arrays
        if (typeof v === 'object' && v !== null) v = JSON.stringify(v);
        html += '<span class="node-info-label">' + escapeHtml(k) + '</span><span class="node-info-value">' + formatPropertyValue(v) + '</span>';
      });
    }
    html += '</div>';
    nodeStatsGrid.innerHTML = html;
  }
  if (nodePanel) nodePanel.classList.add('open');
}

function closeNodePanel() {
  if (nodePanel) nodePanel.classList.remove('open');
}

if (nodePanelClose) nodePanelClose.addEventListener('click', closeNodePanel);

// Bottom panel resize: drag the top-center handle to change height.
// Panel is bottom-anchored, so decreasing clientY increases height.
(function setupNodePanelResize() {
  var handle = document.getElementById('nodePanelResizeHandle');
  if (!handle || !nodePanel) return;
  var minH = 120;
  var maxHRatio = 0.85;
  var startY = 0;
  var startH = 0;
  function onMove(e) {
    var clientY = e.touches ? e.touches[0].clientY : e.clientY;
    var dy = startY - clientY; // drag up → taller
    var maxH = Math.floor(window.innerHeight * maxHRatio);
    var next = Math.max(minH, Math.min(maxH, startH + dy));
    nodePanel.style.height = next + 'px';
  }
  function onUp() {
    handle.classList.remove('dragging');
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
    document.removeEventListener('touchmove', onMove);
    document.removeEventListener('touchend', onUp);
  }
  function onDown(e) {
    e.preventDefault();
    e.stopPropagation();
    startY = e.touches ? e.touches[0].clientY : e.clientY;
    startH = nodePanel.getBoundingClientRect().height;
    handle.classList.add('dragging');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    document.addEventListener('touchmove', onMove, { passive: false });
    document.addEventListener('touchend', onUp);
  }
  handle.addEventListener('mousedown', onDown);
  handle.addEventListener('touchstart', onDown, { passive: false });
})();

// —— Search & jump (basic, adapted from radialgraph) ——
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');
let searchActiveIndex = -1;
let searchMatches = [];

function clearSearchHighlight() {
