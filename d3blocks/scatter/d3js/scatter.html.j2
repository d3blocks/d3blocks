<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ TITLE }}</title>

    {{ SUPPORT }}

    <style>
      body { background: {{ COLOR_BACKGROUND }} }
      .search-hit{stroke:#ff9900!important;stroke-width:3px!important}
    </style>
    <style>{% include "scatter.css" %}</style>

    <style>
    /* Floating left layout panel (d3graph-style): overlays the plot, does not shift it.
       top/margin-top below are pre-JS fallbacks only -- positionBelowTopBar()
       (see script) measures the top-panel's actual rendered height at
       runtime and overrides these, since that height varies with the logo
       image load, font rendering, and wrapping on narrow screens. */
    #layoutPanel.stats-panel {
      top: 80px;
      left: 10px;
      z-index: 60;
    }
    /* Keep the fixed-size scatterplot centered in the viewport */
    #scatter-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      position: relative;
      margin-top: 80px;
    }
    #scatterSvg {
      display: block;
      margin: 0 auto;
      position: relative;
      z-index: 0;
      pointer-events: none;
    }
    #scatterCanvas {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      pointer-events: auto;
    }
    #my_dataviz {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    </style>

</head>

<body>

<!-- Top panel (search centered, controls on right) -->
<div class="top-panel" role="toolbar" aria-label="Top controls">

    <div class="top-panel-left">
        <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
            <img src="https://raw.githubusercontent.com/d3blocks/d3blocks/main/logo.png" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
        </a>
    </div>

    <div class="top-panel-center">
        <div class="search-wrap top-search">
        <input class="search-input" id="searchInput" type="search" placeholder="Find a point…" autocomplete="off" spellcheck="false" />
        <div class="search-results" id="searchResults"></div>
        </div>
    </div>

  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button">Theme: Dark</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch">Save</button>{{ SAVE_BUTTON_STOP }}
  </div>
</div>

<!-- Side panel: Size / Color / Shape (collapsible, floats over the plot like index.html.j2) -->
<div class="stats-panel" id="layoutPanel">
  <div class="stats-panel-title">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="layoutSizeSelect">Size</label>
      <select id="layoutSizeSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
      <div class="slider-row" style="margin-top:8px">
        <label for="sizeMultiplierSlider">Size multiplier <span class="val" id="sizeMultiplierVal">1.0×</span></label>
        <input type="range" id="sizeMultiplierSlider" min="-1" max="1" step="0.01" value="0">
      </div>
    </div>
    <div class="physics-control">
      <label for="layoutColorSelect">Color</label>
      <select id="layoutColorSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="physics-control">
      <label for="layoutShapeSelect">Shape</label>
      <select id="layoutShapeSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="circle">Default</option>
      </select>
    </div>
    <div class="physics-control">
      <label for="layoutLabelSelect">Label</label>
      <select id="layoutLabelSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="">None</option>
        <option value="__tooltip__">Name / tooltip</option>
      </select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Labels appear when zoomed in</div>
    </div>
    <div class="physics-control">
      <div class="slider-row">
        <label for="jitterSlider">Jitter <span class="val" id="jitterVal">0px</span></label>
        <input type="range" id="jitterSlider" min="0" max="200" step="1" value="0">
      </div>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Separates fully overlapping points</div>
    </div>
  </div>
</div>

<!-- Main visualization: full width / centered; left panel floats over it -->
<div id="scatter-main">
<svg id="scatterSvg" width="{{ WIDTH }}" height="{{ HEIGHT }}"></svg>

<script>
	{% include "d3.v4.min.js" %}
</script>


<form>
    <div style="max-width:{{ WIDTH }}px;">
        <center>
        	<input type="radio" name="radio_states" value="radiobutton1" style="{{ RADIO_VISIBLE1 }}" checked="checked"> <label> {{ RADIO_LABEL1 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton2" style="{{ RADIO_VISIBLE2 }}"> <label> {{ RADIO_LABEL2 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton3" style="{{ RADIO_VISIBLE3 }}"> <label> {{ RADIO_LABEL3 }} </label>
        </center>
    </div>
</form>


<!-- Create a div where the graph will take place -->
<div id="my_dataviz"></div>
</div><!-- /#scatter-main -->

<!-- Bottom slide-up point info panel -->
<div id="nodePanel" role="dialog" aria-label="Point details">
  <div class="node-panel-header">
    <div>
      <div class="node-panel-title" id="nodePanelTitle">—</div>
      <div class="node-panel-sub" id="nodePanelSub"></div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="node-panel-close" id="nodePanelClose" type="button">✕</button>
    </div>
  </div>
  <div id="nodeStatsGrid" style="padding:8px 12px;"></div>
</div>

<!-- Circle are black when hovered-->
<style>
	.myCircle:hover {
	  stroke: black;
	}
</style>



<script>
	var jsonData = {{ json_data }};

// Use the main scatter SVG (must not use d3.select("svg") — the Layout
// panel chevron is also an <svg> and comes first in the DOM).
var svg = d3.select("#scatterSvg"),
    width = +svg.attr("width"),
    height = +svg.attr("height")-1;

var k = height / width,
    x0 = [{{MIN_X}}, {{MAX_X}}],
    y0 = [{{MIN_Y}}, {{MAX_Y}}],
    x = d3.scaleLinear().domain(x0).range([0, width]),
    y = d3.scaleLinear().domain(y0).range([height, 0]),
    z = d3.scaleOrdinal(d3.schemeCategory10);

var xAxis = d3.axisTop(x).ticks(12),
    yAxis = d3.axisRight(y).ticks(12 * height / width);

// create a tooltip with the box ****************************
// Fixed positioning + pageX/pageY so the box tracks the cursor next to the point
// (appending to #my_dataviz with SVG-local mouse coords put it far off-screen).
var Tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip")
  .style("opacity", 0)
  .style("position", "fixed")
  .style("pointer-events", "none")
  .style("z-index", 200)
  .style("background-color", "var(--tooltip-bg, white)")
  .style("color", "var(--tooltip-text, #111)")
  .style("border", "1px solid rgba(0,0,0,0.15)")
  .style("border-radius", "5px")
  .style("padding", "5px 8px")
  .style("font-size", "12px")
  .style("box-shadow", "0 2px 8px rgba(0,0,0,0.15)")
  .style("max-width", "280px")
  .style("white-space", "nowrap");

// Canvas uses one delegated interaction layer instead of one DOM listener per point.
var hoveredPointIndex = -1;
function showPointTooltip(d, event) {
  if (!d) return;
  Tooltip.style('opacity', 1)
    .html(d[6] != null ? d[6] : '')
    .style('left', (event.clientX + 14) + 'px')
    .style('top', (event.clientY + 12) + 'px');
}
function hidePointTooltip() {
  Tooltip.style('opacity', 0);
}
// ************************************************


// Add X axis
svg.append("g")
    .attr("class", "axis axis--x")
    .attr("transform", "translate(0," + (height - 10) + ")")
    .call(xAxis);

// Add Y axis
svg.append("g")
    .attr("class", "axis axis--y")
    .attr("transform", "translate(10,0)")
    .call(yAxis);

// Canvas rendering layer: one element replaces one SVG element per point.
var canvas = document.createElement('canvas');
canvas.id = 'scatterCanvas';
document.getElementById('scatter-main').insertBefore(canvas, document.getElementById('scatterSvg'));
var canvasCtx = canvas.getContext('2d');
var dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));
canvas.style.width = width + 'px';
canvas.style.height = (height + 1) + 'px';
canvas.width = Math.round(width * dpr);
canvas.height = Math.round((height + 1) * dpr);
canvasCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

var hitCellSize = 32;
var hitGrid = new Map();
var visiblePointIndices = [];
var renderFramePending = false;
var isPanning = false, didPan = false, panStart = null;
var searchHighlightIndex = -1;
var currentColorAccessor = null;
var categoricalShapeMap = null, categoricalShapeKey = null;

function canvasPointFromEvent(event) {
  var rect = canvas.getBoundingClientRect();
  return {
    px: (event.clientX - rect.left) * width / (rect.width || width),
    py: (event.clientY - rect.top) * (height + 1) / (rect.height || (height + 1))
  };
}
function scheduleRender() {
  if (renderFramePending) return;
  renderFramePending = true;
  requestAnimationFrame(function() {
    renderFramePending = false;
    renderPoints();
    // Labels are a separate SVG layer drawn on top of the canvas points, so
    // they must be refreshed in the SAME frame as renderPoints() -- not
    // just on mouseup/dblclick/etc -- or they visibly lag/freeze behind the
    // points while panning/zooming is in progress. updatePointLabels()
    // already no-ops cheaply when no label key is active or not zoomed in
    // enough, so doing this every frame is safe.
    updatePointLabels();
  });
}
function addHit(i, px, py) {
  var key = Math.floor(px / hitCellSize) + ',' + Math.floor(py / hitCellSize);
  var bucket = hitGrid.get(key);
  if (!bucket) hitGrid.set(key, bucket = []);
  bucket.push(i);
}
function rebuildHitGrid() {
  hitGrid.clear();
  visiblePointIndices.length = 0;
  var c = currentCoordIndices(), xi = c[0], yi = c[1];
  var xd = x.domain(), yd = y.domain();
  for (var i=0; i<jsonData.length; i++) {
    var d=jsonData[i];
    if (!d || !Number.isFinite(+d[xi]) || !Number.isFinite(+d[yi])) continue;
    var xv=+d[xi], yv=+d[yi];
    if (xv<xd[0] || xv>xd[1] || yv<yd[0] || yv>yd[1]) continue;
    var px=x(xv), py=y(yv); var jp=jitteredPoint(i,px,py);
    visiblePointIndices.push(i);
    addHit(i,jp.px,jp.py);
  }
}
function hitTest(event) {
  var p=canvasPointFromEvent(event), gx=Math.floor(p.px/hitCellSize), gy=Math.floor(p.py/hitCellSize);
  var c=currentCoordIndices(), best=-1, bestDist=Infinity;
  for(var yy=gy-1;yy<=gy+1;yy++) for(var xx=gx-1;xx<=gx+1;xx++) {
    var bucket=hitGrid.get(xx+','+yy); if(!bucket) continue;
    for(var j=0;j<bucket.length;j++) {
      var i=bucket[j], d=jsonData[i], px=x(d[c[0]]), py=y(d[c[1]]); var jp=jitteredPoint(i,px,py); px=jp.px; py=jp.py;
      var r=Math.max(3, baseRadius(d)), dx=px-p.px, dy=py-p.py, dist=dx*dx+dy*dy;
      if(dist<=r*r && dist<bestDist){bestDist=dist;best=i;}
    }
  }
  return best;
}
function drawSymbol(ctx,shape,r) {
  if(shape==='circle'){ctx.arc(0,0,r,0,Math.PI*2);return;}
  if(shape==='square'){ctx.rect(-r,-r,2*r,2*r);return;}
  if(shape==='triangle'){var h=r*1.8;ctx.moveTo(0,-h);ctx.lineTo(-h*.866,h*.5);ctx.lineTo(h*.866,h*.5);ctx.closePath();return;}
  if(shape==='diamond'){var q=r*1.35;ctx.moveTo(0,-q);ctx.lineTo(q*.78,0);ctx.lineTo(0,q);ctx.lineTo(-q*.78,0);ctx.closePath();return;}
  var q=r*.45;ctx.moveTo(-r,-q);ctx.lineTo(-q,-q);ctx.lineTo(-q,-r);ctx.lineTo(q,-r);ctx.lineTo(q,-q);ctx.lineTo(r,-q);ctx.lineTo(r,q);ctx.lineTo(q,q);ctx.lineTo(q,r);ctx.lineTo(-q,r);ctx.lineTo(-q,q);ctx.lineTo(-r,q);ctx.closePath();
}
function renderPoints() {
  var ctx=canvasCtx; ctx.clearRect(0,0,width,height+1); rebuildHitGrid();
  var c=currentCoordIndices(), xi=c[0], yi=c[1];
  for(var n=0;n<visiblePointIndices.length;n++){
    var i=visiblePointIndices[n], d=jsonData[i], px=x(d[xi]), py=y(d[yi]); var jp=jitteredPoint(i,px,py); px=jp.px; py=jp.py;
    var r=baseRadius(d)*(i===hoveredPointIndex?1.4:1);
    var shape=currentShapeMode;
    if(categoricalShapeMap && d[11] && categoricalShapeMap[d[11][categoricalShapeKey]]) shape=categoricalShapeMap[d[11][categoricalShapeKey]];
    ctx.save(); ctx.globalAlpha=Number.isFinite(+d[4])?+d[4]:1; ctx.translate(px,py); ctx.beginPath(); drawSymbol(ctx,shape,r);
    ctx.fillStyle=(currentColorAccessor?currentColorAccessor(d):d[2])||'transparent'; ctx.fill();
    if(d[5]){ctx.strokeStyle=d[5];ctx.lineWidth=1;ctx.stroke();}
    if(i===hoveredPointIndex || i===searchHighlightIndex){ctx.strokeStyle=i===searchHighlightIndex?'#ff9900':'#000';ctx.lineWidth=i===searchHighlightIndex?3:2;ctx.stroke();}
    ctx.restore();
  }
}
function updateAxes(){svg.select(".axis--x").call(xAxis);svg.select(".axis--y").call(yAxis);}

canvas.addEventListener('mousedown',function(e){
  if(e.button!==0)return;
  if(hitTest(e)>=0)return;
  isPanning=true;didPan=false;var p=canvasPointFromEvent(e);
  panStart={px:p.px,py:p.py,xDomain:x.domain().slice(),yDomain:y.domain().slice()};
  canvas.style.cursor='grabbing';e.preventDefault();
});
window.addEventListener('mousemove',function(e){
  if(isPanning){
    var p=canvasPointFromEvent(e),dx=p.px-panStart.px,dy=p.py-panStart.py;
    if(Math.abs(dx)>2||Math.abs(dy)>2)didPan=true;
    var xs=panStart.xDomain[1]-panStart.xDomain[0],ys=panStart.yDomain[1]-panStart.yDomain[0];
    var ddx=dx*xs/(width||1),ddy=dy*ys/(height||1);
    x.domain([panStart.xDomain[0]-ddx,panStart.xDomain[1]-ddx]);
    y.domain([panStart.yDomain[0]+ddy,panStart.yDomain[1]+ddy]);
    updateAxes();scheduleRender();return;
  }
  var idx=hitTest(e);
  if(idx!==hoveredPointIndex){hoveredPointIndex=idx;if(idx>=0)showPointTooltip(jsonData[idx],e);else hidePointTooltip();scheduleRender();}
  else if(idx>=0)showPointTooltip(jsonData[idx],e);
});
window.addEventListener('mouseup',function(){
  if(isPanning){isPanning=false;panStart=null;canvas.style.cursor='default';updatePointLabels();setTimeout(function(){didPan=false;},0);}
});
canvas.addEventListener('click',function(e){
  if(didPan)return;
  var idx=hitTest(e);
  if(idx>=0)showNodePanel(jsonData[idx]); else if(!isPanning)closeNodePanel();
});
canvas.addEventListener('dblclick',function(){
  x.domain(x0.slice());y.domain(y0.slice());updateAxes();scheduleRender();updatePointLabels();
});
scheduleRender();

// Mouse-wheel zoom (centered on cursor). Render is immediate and coalesced.
(function setupWheelZoom() {
  canvas.addEventListener('wheel',function(event){
    event.preventDefault();event.stopPropagation();
    var factor=event.deltaY<0?.85:1.18,p=canvasPointFromEvent(event);
    var mx=x.invert(p.px),my=y.invert(p.py),xd=x.domain(),yd=y.domain();
    var nx=[mx-(mx-xd[0])*factor,mx+(xd[1]-mx)*factor];
    var ny=[my-(my-yd[0])*factor,my+(yd[1]-my)*factor];
    if(Math.abs(nx[1]-nx[0])>Math.abs(x0[1]-x0[0]))nx=x0.slice();
    if(Math.abs(ny[1]-ny[0])>Math.abs(y0[1]-y0[0]))ny=y0.slice();
    if(nx[0]===nx[1]||ny[0]===ny[1])return;
    x.domain(nx);y.domain(ny);updateAxes();scheduleRender();updatePointLabels();
  },{passive:false});
})();

// Keep the floating Layout panel and the scatterplot itself clear of the
// fixed top bar. The bar's rendered height varies (logo image load, font
// rendering, and it may wrap onto two lines on a narrow screen), so this
// measures it at runtime instead of assuming a fixed pixel offset -- the
// same approach index.html.j2 uses for its positionSidePanels().
function positionBelowTopBar() {
  var bar = document.querySelector('.top-panel');
  var layoutPanel = document.getElementById('layoutPanel');
  var main = document.getElementById('scatter-main');
  if (!bar) return;
  var bottom = bar.getBoundingClientRect().bottom;
  if (layoutPanel) layoutPanel.style.top = (bottom + 8) + 'px';
  if (main) main.style.marginTop = (bottom + 12) + 'px';
}
window.addEventListener('resize', positionBelowTopBar);
window.addEventListener('load', positionBelowTopBar);
positionBelowTopBar();

// Collapsible layout panel (same interaction as index.html.j2 stats-panels)
(function () {
  var panel = document.getElementById('layoutPanel');
  if (!panel) return;
  var title = panel.querySelector('.stats-panel-title');
  if (!title) return;
  title.addEventListener('click', function () {
    var collapsing = !panel.classList.contains('collapsed');
    if (collapsing) {
      if (panel.style.height) {
        panel.dataset.expandedHeight = panel.style.height;
      }
      panel.style.height = '';
    } else if (panel.dataset.expandedHeight) {
      panel.style.height = panel.dataset.expandedHeight;
    }
    panel.classList.toggle('collapsed');
  });
})();

// Point state. Rendering is done on a single canvas; this avoids the large
// DOM and attribute-update cost of one SVG node per datum.
var SHAPE_MAP={circle:d3.symbolCircle,square:d3.symbolSquare,triangle:d3.symbolTriangle,diamond:d3.symbolDiamond,cross:d3.symbolCross};
var currentShapeMode='circle';
var initialRadii=jsonData.map(function(d){return d&&Number.isFinite(+d[3])?+d[3]:1;});
// Global size multiplier (from the "Size multiplier" slider): scales every
// rendered point up/down without touching the underlying d[3] radius data,
// so it composes with whatever size-by property is active. Lets users
// shrink points when there are many of them (dense scatter) or enlarge them
// when there are few, so the plot always reads well on screen.
var sizeMultiplier = 1;
// The slider itself carries the EXPONENT (t in [-1, 1]), not the multiplier
// directly. multiplier = SIZE_MULT_BASE^t is an exponential (not linear)
// mapping: equal drag distance near either end of the slider produces a
// much bigger change in multiplier than the same drag near the middle, so
// size differences between points become easier to see as you push toward
// either extreme, while the center (t=0) stays pinned at a neutral 1x.

// var SIZE_MULT_BASE = 8; // t=-1 -> 0.25x, t=0 -> 1x, t=1 -> 4x
// function sizeMultiplierFromSlider(t) { return Math.pow(SIZE_MULT_BASE, t); }
// function baseRadius(d) { return Math.max(.5, +d[3]||1) * sizeMultiplier; }
function sizeMultiplierFromSlider(t) {
    var min = 0.05;
    var max = 4;
    var u = (t + 1) / 2;
    return min * Math.pow(max / min, u);
}

function baseRadius(d) {
    return Math.max(.5, +d[3] || 1) * sizeMultiplier;
}

// —— Jitter: nudges each point a small, stable amount so fully-overlapping
// points become distinguishable. The offset is seeded from the point's own
// index (not Math.random()) so it stays fixed across re-renders, pans, and
// zooms rather than reshuffling every frame; it's applied in screen pixels
// (after the x()/y() scales) so the amount of separation looks the same
// regardless of zoom level.
var jitterAmount = 0; // 0 = off; otherwise max offset radius in px
var jitterCache = new Map();
function seededRandom(seed) { var v = Math.sin(seed) * 10000; return v - Math.floor(v); }
function jitterOffset(i) {
  if (!jitterAmount) return null;
  var c = jitterCache.get(i);
  if (!c) { c = { a: seededRandom(i * 12.9898 + 1) * Math.PI * 2, r: Math.sqrt(seededRandom(i * 78.233 + 7)) }; jitterCache.set(i, c); }
  var mag = c.r * jitterAmount;
  return { dx: Math.cos(c.a) * mag, dy: Math.sin(c.a) * mag };
}
function jitteredPoint(i, px, py) {
  var j = jitterOffset(i);
  return j ? { px: px + j.dx, py: py + j.dy } : { px: px, py: py };
}
function transformForIndex(d,xi,yi,scale){scale=typeof scale==='number'?scale:1;return 'translate('+x(d[xi])+','+y(d[yi])+') scale('+scale+')';}
function symbolPathForRadius(r,shapeName){var s=d3.symbol().type(SHAPE_MAP[shapeName]||d3.symbolCircle).size(Math.PI*r*r);return s();}
function applySizeMode(key){
  if(!key){for(var i=0;i<jsonData.length;i++)if(jsonData[i])jsonData[i][3]=initialRadii[i];scheduleRender();return;}
  var min=Infinity,max=-Infinity;
  for(var i=0;i<jsonData.length;i++){var v=jsonData[i]&&jsonData[i][11]?jsonData[i][11][key]:NaN;if(typeof v==='number'&&Number.isFinite(v)){if(v<min)min=v;if(v>max)max=v;}}
  if(min===Infinity)return;
  var MAX_R=24;
  // Direct, proportional linear scale -- the same style of mapping people
  // write by hand in Python (e.g. `size=df['col'].values/10`): radius is
  // directly proportional to the value, anchored at 0 (not at the data's
  // min) so ratios are preserved -- a value twice as large renders at
  // roughly twice the radius. This reflects real magnitude differences
  // faithfully, instead of an area/sqrt scale that compresses them into a
  // fixed narrow pixel band (theoretically "perceptually corrected" for
  // area judgment, but at the cost of no longer looking proportional to
  // the underlying numbers -- which is what people actually expect here).
  var domainMin = Math.min(0, min); // keep 0 as the reference unless data goes negative
  var span = max - domainMin;
  var scale = span===0
    ? function(){ return MAX_R*0.5; }
    : function(v){ return Math.max(1, (v - domainMin) / span * MAX_R); };
  for(var j=0;j<jsonData.length;j++){var d=jsonData[j],v=d&&d[11]?d[11][key]:NaN;
    d[3]=(typeof v==='number'&&Number.isFinite(v))?scale(v):initialRadii[j];
  } scheduleRender();
}
function applyColorMode(key){
  currentColorAccessor=null;if(!key){scheduleRender();return;}
  var vals=[],numeric=true,min=Infinity,max=-Infinity,has=false;
  for(var i=0;i<jsonData.length;i++){var v=jsonData[i]&&jsonData[i][11]?jsonData[i][11][key]:null;vals.push(v);
    if(v!=null){if(typeof v==='number'&&Number.isFinite(v)){has=true;min=Math.min(min,v);max=Math.max(max,v);}else numeric=false;}}
  if(numeric&&has){currentColorScale=d3.scaleSequential(d3.interpolateViridis).domain([min,max]);currentColorAccessor=function(d){var v=d&&d[11]?d[11][key]:null;return typeof v==='number'&&Number.isFinite(v)?currentColorScale(v):d[2];};}
  else {var uniq=Array.from(new Set(vals.filter(function(v){return v!=null;}))),palette=d3.schemeCategory10.concat(d3.schemeSet3||[]),scale=d3.scaleOrdinal().domain(uniq).range(palette);currentColorScale=scale;currentColorAccessor=function(d){var v=d&&d[11]?d[11][key]:null;return v!=null?scale(v):d[2];};}
  scheduleRender();
}
function applyShapeMode(val){
  categoricalShapeMap=null;categoricalShapeKey=null;
  if(!val||SHAPE_MAP[val]){currentShapeMode=val||'circle';scheduleRender();return;}
  if(val.indexOf('prop:')===0){var key=val.slice(5),uniq=[],seen=new Set();
    for(var i=0;i<jsonData.length;i++){var v=jsonData[i]&&jsonData[i][11]?jsonData[i][11][key]:null;if(v!=null&&!seen.has(v)){seen.add(v);uniq.push(v);}}
    var names=Object.keys(SHAPE_MAP);categoricalShapeMap={};uniq.forEach(function(v,i){categoricalShapeMap[v]=names[i%names.length];});categoricalShapeKey=key;scheduleRender();
  }
}

// —— Point labels (only drawn once zoomed in; fade in/out gradually rather
// than popping in at a single hard threshold) ——
var currentLabelKey = null; // null | '__tooltip__' | property key
var labelGroup = svg.append('g').attr('class', 'point-labels').style('pointer-events', 'none');
var LABEL_ZOOM_FADE_START = 1.4; // opacity 0 at/below this zoom factor
var LABEL_ZOOM_FADE_END = 2.4;   // opacity 1 at/above this zoom factor

function currentCoordIndices() {
  var modeNode = d3.select('input[name="radio_states"]:checked').node();
  var mode = modeNode ? modeNode.value : 'radiobutton1';
  if (mode === 'radiobutton2') return [7, 8];
  if (mode === 'radiobutton3') return [9, 10];
  return [0, 1];
}

// Tracks the coordinate pair actually on screen right now. Needed because a
// radio 'change' event fires AFTER the DOM's :checked state has already
// flipped to the new button, so currentCoordIndices() can't be used to find
// the *previous* position from inside the handler -- it would return the
// same (new) indices as the target, collapsing the slide into an instant
// jump. This variable is only updated once an animation finishes.
var activeCoordIndices = currentCoordIndices();

// Per-point live on-screen position (in data space), kept up to date every
// animation frame during a coordinate-mode transition. If the user picks a
// new target mid-transition, the next animation reads its starting point
// from here -- the points' actual current position -- rather than from
// activeCoordIndices (which only updates when a transition finishes and
// would otherwise be stale, making points visibly snap back to where the
// PREVIOUS transition started before animating to the new target).
var currentXVal = new Array(jsonData.length);
var currentYVal = new Array(jsonData.length);
(function initCurrentCoordVals() {
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    currentXVal[i] = d ? +d[activeCoordIndices[0]] : NaN;
    currentYVal[i] = d ? +d[activeCoordIndices[1]] : NaN;
  }
})();

function labelTextFor(d) {
  if (!currentLabelKey) return '';
  if (currentLabelKey === '__tooltip__') return (d && d[6] != null) ? String(d[6]) : '';
  if (d && d[11] && d[11][currentLabelKey] != null) {
    var v = d[11][currentLabelKey];
    return (typeof v === 'object') ? JSON.stringify(v) : String(v);
  }
  return '';
}

function labelOpacity() {
  var xd = x.domain(), yd = y.domain();
  var xSpan = Math.abs(xd[1] - xd[0]);
  var ySpan = Math.abs(yd[1] - yd[0]);
  var x0Span = Math.abs(x0[1] - x0[0]) || 1;
  var y0Span = Math.abs(y0[1] - y0[0]) || 1;
  var zoomFactor = Math.min(x0Span / xSpan, y0Span / ySpan);
  if (zoomFactor <= LABEL_ZOOM_FADE_START) return 0;
  if (zoomFactor >= LABEL_ZOOM_FADE_END) return 1;
  return (zoomFactor - LABEL_ZOOM_FADE_START) / (LABEL_ZOOM_FADE_END - LABEL_ZOOM_FADE_START);
}

function updatePointLabels() {
  var op = labelOpacity();
  if (!currentLabelKey || op <= 0) {
    labelGroup.selectAll('text').remove();
    return;
  }
  var coords = currentCoordIndices();
  var xi = coords[0], yi = coords[1];
  var xd = x.domain(), yd = y.domain();
  // Only label points currently in the visible domain (keeps cost low when zoomed in)
  var visible = [];
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    if (!d) continue;
    var xv = d[xi], yv = d[yi];
    if (xv >= xd[0] && xv <= xd[1] && yv >= yd[0] && yv <= yd[1]) {
      visible.push({ d: d, i: i });
    }
  }
  var labels = labelGroup.selectAll('text').data(visible, function(v){ return v.i; });
  labels.exit().remove();
  labels.enter().append('text')
    .attr('class', 'point-label')
    .style('font-size', '11px')
    .style('paint-order', 'stroke')
    .style('stroke', 'var(--bg, #fff)')
    .style('stroke-width', '3px')
    .style('stroke-linejoin', 'round')
    .style('fill', 'var(--text, #222)')
    .style('opacity', 0)
    .merge(labels)
    .text(function(v){ return labelTextFor(v.d); })
    .attr('x', function(v){ return jitteredPoint(v.i, x(v.d[xi]), y(v.d[yi])).px + 8; })
    .attr('y', function(v){ return jitteredPoint(v.i, x(v.d[xi]), y(v.d[yi])).py + 3; })
    .style('opacity', op);
}

function applyLabelMode(key) {
  currentLabelKey = key || null;
  updatePointLabels();
}

// Wire up layout controls
var layoutSizeSelect = document.getElementById('layoutSizeSelect'); if (layoutSizeSelect) layoutSizeSelect.addEventListener('change', function(e){ applySizeMode(e.target.value); });
var layoutColorSelect = document.getElementById('layoutColorSelect'); if (layoutColorSelect) layoutColorSelect.addEventListener('change', function(e){ applyColorMode(e.target.value); });
var layoutShapeSelect = document.getElementById('layoutShapeSelect'); if (layoutShapeSelect) layoutShapeSelect.addEventListener('change', function(e){ applyShapeMode(e.target.value); });
var layoutLabelSelect = document.getElementById('layoutLabelSelect'); if (layoutLabelSelect) layoutLabelSelect.addEventListener('change', function(e){ applyLabelMode(e.target.value); });
var sizeMultiplierSlider = document.getElementById('sizeMultiplierSlider');
var sizeMultiplierVal = document.getElementById('sizeMultiplierVal');
