  const themeBtn = document.getElementById('themeBtn');
  const isLight = document.body.classList.toggle('light');
  if (themeBtn) themeBtn.textContent = isLight ? 'Theme: Light' : 'Theme: Dark';
}
const themeBtn = document.getElementById('themeBtn'); if (themeBtn) { themeBtn.addEventListener('click', toggleTheme); themeBtn.textContent = document.body.classList.contains('light') ? 'Theme: Light' : 'Theme: Dark'; }
window.addEventListener('keydown', function(e){ if ((e.key === 't' || e.key === 'T') && !(e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA'))) toggleTheme(); });

// Read checkboxes and create transition ****************************
const buttons = d3.selectAll('input');
buttons.on('change', function(d)
{
	// console.log('button changed to ' + this.value);
	var t;
	if (this.value == 'radiobutton1')
		t = points.transition()
			.delay(0)
			.duration(2500)
			.attr('transform', function(d){ return transformForIndex(d, 0, 1); })
	else if (this.value == 'radiobutton2')
		t = points.transition()
			.delay(0)
			.duration(2500)
			.attr('transform', function(d){ return transformForIndex(d, 7, 8); })
	else if (this.value == 'radiobutton3')
		t = points.transition()
			.delay(0)
			.duration(2500)
			.attr('transform', function(d){ return transformForIndex(d, 9, 10); })
	if (t) t.on('end', updatePointLabels);
	updatePointLabels();
;})


// *************************************************

function zoom(duration) {
  duration = (typeof duration === 'number') ? duration : 750;
  var modeNode = d3.select('input[name="radio_states"]:checked').node();
  var mode = modeNode ? modeNode.value : 'radiobutton1';
  function applyPointTransforms(selection) {
    if (mode == 'radiobutton1') selection.attr('transform', function(d){ return transformForIndex(d, 0, 1); });
    else if (mode == 'radiobutton2') selection.attr('transform', function(d){ return transformForIndex(d, 7, 8); });
    else if (mode == 'radiobutton3') selection.attr('transform', function(d){ return transformForIndex(d, 9, 10); });
  }

  // duration 0: immediate update for smooth pan dragging
  if (duration <= 0) {
    svg.select(".axis--x").call(xAxis);
    svg.select(".axis--y").call(yAxis);
    applyPointTransforms(points);
    updatePointLabels();
    return;
  }

  var t = svg.transition().duration(duration);
  svg.select(".axis--x").transition(t).call(xAxis);
  svg.select(".axis--y").transition(t).call(yAxis);
  applyPointTransforms(points.transition(t));

  // Labels only when zoomed in (cheap early-out when none selected / zoomed out)
  t.on('end', updatePointLabels);
  updatePointLabels();
	}

