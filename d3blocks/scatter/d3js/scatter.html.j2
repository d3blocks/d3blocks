function escapeHtml(v) {
  if (v == null) return '';
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// Property values: media refs become image/audio widgets; other URLs/paths
// become links; everything else is escaped text. Reuses tooltip media parsers.
function formatPropertyValue(v) {
  if (v == null) return '';

  if (typeof v === 'string') {
    var s = v.trim();

    // A bare filename (e.g. "car_horn_329.wav" or "image.jpg")
    // is not a media reference. Keep it as plain text.
    // var isBareFilename = /^[^\\/:*?"<>|]+$/.test(s) && /\.[A-Za-z0-9]+$/.test(s);
    var isBareFilename = /^[^\\/:*?"<>|]+\.[A-Za-z0-9]+$/.test(s);

    if (!isBareFilename &&
        (isImageRef(s) || isAudioRef(s) || /<(br|img|div|span|a)\b/i.test(s))) {
        return formatTooltipHtml(s);
    }

    // Plain URL / path → clickable link
    if (/^(https?:\/\/|ftp:\/\/|file:\/\/)/i.test(s) || /^www\./i.test(s) ||
        /^\/[^\s]+$/.test(s) || /^[A-Za-z]:[\\/][^\s]*$/.test(s)) {
      var href = hrefForRef(s);
      return '<a class="node-info-link" href="' + escapeHtml(href) +
             '" target="_blank" rel="noopener noreferrer">' +
             escapeHtml(s) + '</a>';
    }
  }

  return escapeHtml(v);
}

function showNodePanel(d) {
  // Stop any audio still playing in the bottom panel from a previous point.
  if (nodeStatsGrid) {
    nodeStatsGrid.querySelectorAll('audio').forEach(function(a) {
      try { a.pause(); a.currentTime = 0; } catch (e) {}
    });
  }

  var rawTip = (d && d[6] != null) ? String(d[6]) : '';
  // Plain-text title (strip tags / collapse whitespace) for the header line.
  var titlePlain = rawTip.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
  if (!titlePlain) titlePlain = (d && d[0] != null ? String(d[0]) : 'Point');
  if (titlePlain.length > 100) titlePlain = titlePlain.slice(0, 97) + '\u2026';
  nodePanelTitle.textContent = titlePlain;
  const sub = (d && d[0] != null && d[1] != null) ? `x: ${d[0]}, y: ${d[1]}` : '';
  nodePanelSub.textContent = sub;

  if (nodeStatsGrid) {
    var html = '<div class="node-info-grid">';
    var props = (d && d[13]) ? d[13] : null;
    if (props && typeof props === 'object') {
      html += '<div class="node-info-section-title">Properties</div>';
      html += '<div class="node-info-props-grid">';
      Object.keys(props).forEach(function(k){
        var v = props[k];
        if (typeof v === 'object' && v !== null) v = JSON.stringify(v);
        var rendered = formatPropertyValue(v);
        var isMedia = typeof v === 'string' && (isImageRef(v.trim()) || isAudioRef(v.trim()) || /<(br|img)\b/i.test(v));
        if (isMedia) {
          html += '<div class="node-info-prop-cell node-info-prop-media">' +
            '<span class="node-info-label">' + escapeHtml(k) + '</span>' +
            '<div class="node-info-media">' + rendered + '</div></div>';
        } else {
          html += '<div class="node-info-prop-cell">' +
            '<span class="node-info-label">' + escapeHtml(k) + '</span>' +
            '<span class="node-info-value">' + rendered + '</span></div>';
        }
      });
      html += '</div>';
    }
    html += '</div>';
    nodeStatsGrid.innerHTML = html;
    // Wire play/pause + waveform for any audio widgets in the panel.
    wireTooltipAudio(nodeStatsGrid);
  }
  if (nodePanel) nodePanel.classList.add('open');
}

function closeNodePanel() {
  if (nodeStatsGrid) {
    nodeStatsGrid.querySelectorAll('audio').forEach(function(a) {
      try { a.pause(); a.currentTime = 0; } catch (e) {}
    });
  }
  if (nodePanel) nodePanel.classList.remove('open');
  if (focusedPointIndex >= 0) {
    focusedPointIndex = -1;
    scheduleRender();
  }
}

if (nodePanelClose) nodePanelClose.addEventListener('click', closeNodePanel);

// Bottom panel resize: drag the top-center handle to change height.
// Panel is bottom-anchored, so decreasing clientY increases height.
(function setupNodePanelResize() {
  var handle = document.getElementById('nodePanelResizeHandle');
  if (!handle || !nodePanel) return;
  var minH = 120;
  var maxHRatio = 0.85;
  var startY = 0;
  var startH = 0;
  function onMove(e) {
    var clientY = e.touches ? e.touches[0].clientY : e.clientY;
    var dy = startY - clientY; // drag up → taller
    var maxH = Math.floor(window.innerHeight * maxHRatio);
    var next = Math.max(minH, Math.min(maxH, startH + dy));
    nodePanel.style.height = next + 'px';
  }
  function onUp() {
    handle.classList.remove('dragging');
    document.removeEventListener('mousemove', onMove);
    document.removeEventListener('mouseup', onUp);
    document.removeEventListener('touchmove', onMove);
    document.removeEventListener('touchend', onUp);
  }
  function onDown(e) {
    e.preventDefault();
    e.stopPropagation();
    startY = e.touches ? e.touches[0].clientY : e.clientY;
    startH = nodePanel.getBoundingClientRect().height;
    handle.classList.add('dragging');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
    document.addEventListener('touchmove', onMove, { passive: false });
    document.addEventListener('touchend', onUp);
  }
  handle.addEventListener('mousedown', onDown);
  handle.addEventListener('touchstart', onDown, { passive: false });
})();

// —— Search & jump (basic, adapted from radialgraph) ——
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');
let searchActiveIndex = -1;
let searchMatches = [];

function clearSearchHighlight() {
  searchHighlightIndex = -1;
  scheduleRender();
}
function highlightPoint(idx) {
  searchHighlightIndex = idx;
  scheduleRender();
}

function jumpToPoint(idx) {
  const i = parseInt(idx, 10);
  if (Number.isNaN(i) || i < 0 || i >= jsonData.length) return;
  // Show panel for the point and highlight it (search + focus ring)
  focusedPointIndex = i;
  showNodePanel(jsonData[i]);
  highlightPoint(i);
  scheduleRender();
  // Close results and set input value
  if (searchResults) searchResults.classList.remove('open');
  if (searchInput) {
    searchInput.value = (jsonData[i] && jsonData[i][6]) ? jsonData[i][6] : String(i);
    searchInput.blur();
  }
}

function renderSearchResults(query) {
  const q = (query || '').trim().toLowerCase();
  searchActiveIndex = -1;
  if (!q) {
    searchMatches = [];
    if (searchResults) { searchResults.innerHTML = ''; searchResults.classList.remove('open'); }
    return;
  }
  const all = jsonData.map(function(d,i){ return {id: (d && d[6]) ? String(d[6]) : String(i), idx: i, d: d}; });
  searchMatches = all
    .filter(function(it){ return it.id.toLowerCase().includes(q); })
    .sort(function(a,b){
      const al = a.id.toLowerCase(), bl = b.id.toLowerCase();
      const ap = al.startsWith(q) ? 0 : 1;
      const bp = bl.startsWith(q) ? 0 : 1;
      if (ap !== bp) return ap - bp;
      return a.id.length - b.id.length || a.id.localeCompare(b.id);
    })
    .slice(0, 12);

  if (!searchMatches.length) {
    if (searchResults) { searchResults.innerHTML = '<div class="search-item" style="opacity:0.5;cursor:default;padding:6px 10px">No matches</div>'; searchResults.classList.add('open'); }
    return;
  }
  if (searchResults) {
    searchResults.innerHTML = searchMatches.map(function(it, i){
      const d = it.d || {};
      const meta = (d[0] != null && d[1] != null) ? ('x:' + d[0] + ' · y:' + d[1]) : '';
      return '<div class="search-item" data-idx="'+it.idx+'" data-i="'+i+'" style="padding:6px 10px;cursor:pointer;display:flex;justify-content:space-between;align-items:center">' +
        '<div style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + it.id + '</div>' +
        (meta?('<div style="color:#666;font-size:0.9em;margin-left:8px">'+meta+'</div>'):'') +
        '</div>';
    }).join('');
    searchResults.classList.add('open');
  }
}

if (searchInput) searchInput.addEventListener('input', function(){ renderSearchResults(searchInput.value); });
if (searchInput) searchInput.addEventListener('focus', function(){ if (searchInput.value.trim()) renderSearchResults(searchInput.value); });

if (searchInput) searchInput.addEventListener('keydown', function(e){
  if (!searchResults || !searchResults.classList.contains('open') || !searchMatches.length) {
    if (e.key === 'Enter' && searchInput.value.trim()) {
      // Exact or first match
      const q = searchInput.value.trim();
      const exact = searchMatches.find(function(m){ return m.id === q; }) || searchMatches[0] || null;
      if (exact) jumpToPoint(exact.idx);
    }
    return;
  }
  if (e.key === 'ArrowDown') {
    e.preventDefault(); searchActiveIndex = Math.min(searchMatches.length - 1, searchActiveIndex + 1);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault(); searchActiveIndex = Math.max(0, searchActiveIndex - 1);
  } else if (e.key === 'Enter') {
    e.preventDefault(); const id = searchMatches[searchActiveIndex >= 0 ? searchActiveIndex : 0]; if (id) jumpToPoint(id.idx); return;
  } else if (e.key === 'Escape') {
    if (searchResults) { searchResults.classList.remove('open'); searchInput.blur(); } return;
  } else { return; }
  // update active class
  if (searchResults) {
    const items = searchResults.querySelectorAll('.search-item');
    items.forEach(function(el,i){ el.classList.toggle('active', i === searchActiveIndex); if (i === searchActiveIndex) el.scrollIntoView({block:'nearest'}); });
  }
});

if (searchResults) searchResults.addEventListener('mousedown', function(e){
  const item = e.target.closest('.search-item'); if (!item || !item.dataset.idx) return; e.preventDefault(); jumpToPoint(item.dataset.idx);
});

document.addEventListener('click', function(e){ if (!e.target.closest('.search-wrap')) { if (searchResults) searchResults.classList.remove('open'); } });

