<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ TITLE }}</title>

    {{ SUPPORT }}

    <style>
      body { background: {{ COLOR_BACKGROUND }} }
      .search-hit{stroke:#ff9900!important;stroke-width:3px!important}
    </style>
    <style>{% include "scatter.css" %}</style>

    <style>
    /* Floating left layout panel (d3graph-style): overlays the plot, does not shift it.
       top/margin-top below are pre-JS fallbacks only -- positionSidePanels()
       (see script) measures the top-panel's actual rendered height at
       runtime and overrides these, since that height varies with the logo
       image load, font rendering, and wrapping on narrow screens. */
    #exportPanel.stats-panel {
      top: 80px;
      left: 10px;
      z-index: 65;
    }
    #layoutPanel.stats-panel {
      top: 220px;
      left: 10px;
      z-index: 60;
    }
    #enrichPanel.stats-panel {
      top: 600px;
      left: 10px;
      z-index: 55;
    }
    /* Keep the fixed-size scatterplot centered in the viewport */
    #scatter-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      position: relative;
      margin-top: 80px;
    }
    #scatterSvg {
      display: block;
      margin: 0 auto;
      position: relative;
      z-index: 0;
      pointer-events: none;
    }
    #scatterCanvas {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      pointer-events: auto;
    }
    #my_dataviz {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    </style>

</head>

<body>

<!-- Top panel (search centered, controls on right) -->
<div class="top-panel" role="toolbar" aria-label="Top controls">

    <div class="top-panel-left">
        <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
            <img src="https://raw.githubusercontent.com/d3blocks/d3blocks/main/logo.png" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
        </a>
    </div>

    <div class="top-panel-center">
        <div class="search-wrap top-search">
        <input class="search-input" id="searchInput" type="search" placeholder="Find a point…" autocomplete="off" spellcheck="false" />
        <div class="search-results" id="searchResults"></div>
        </div>
    </div>

  <div class="top-panel-right">
    <span id="selectionCount" class="selection-count" style="display:none"></span>
    <button class="button-switch" id="selectModeBtn" type="button" title="Drag to select points; click a point to toggle it">Select</button>
    <button class="button-switch" id="themeBtn" type="button">Theme: Dark</button>
  </div>
</div>

<!-- Side panel: Export / Save (first in the left stack) -->
<div class="stats-panel" id="exportPanel">
  <div class="stats-panel-title">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button class="button-switch" id="exportButton" type="button" title="Export selected points (or all, if none selected)" style="width:100%;margin:4px 0 8px 0">Export</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch" style="width:100%;margin:0 0 4px 0">Save</button>{{ SAVE_BUTTON_STOP }}
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads selected points (or all if none selected) as JSON.</div>
  </div>
</div>

<!-- Side panel: Size / Color / Shape (collapsible, floats over the plot like index.html.j2) -->
<div class="stats-panel" id="layoutPanel">
  <div class="stats-panel-title">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="layoutSizeSelect">Size</label>
      <select id="layoutSizeSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
      <div class="slider-row" style="margin-top:8px">
        <label for="sizeMultiplierSlider">Size multiplier <span class="val" id="sizeMultiplierVal">1.0×</span></label>
        <input type="range" id="sizeMultiplierSlider" min="-1" max="1" step="0.01" value="0">
      </div>
      <div class="slider-row" style="margin-top:8px">
        <label for="jitterSlider">Jitter <span class="val" id="jitterVal">0px</span></label>
        <input type="range" id="jitterSlider" min="0" max="25" step="1" value="0">
      </div>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Separates fully overlapping points</div>
    </div>
    <div class="physics-control">
      <label for="layoutColorSelect">Color</label>
      <select id="layoutColorSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="physics-control">
      <label for="layoutShapeSelect">Shape</label>
      <select id="layoutShapeSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="circle">Default</option>
      </select>
    </div>
    <div class="physics-control">
      <label for="layoutLabelSelect">Label</label>
      <select id="layoutLabelSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="">None</option>
        <option value="__tooltip__">Name / tooltip</option>
      </select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Labels appear when zoomed in</div>
    </div>
  </div>
</div>

<div class="stats-panel collapsed" id="enrichPanel">
  <div class="stats-panel-title">Enrichments<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="enrichAlphaInput">Alpha cutoff</label>
      <input type="number" id="enrichAlphaInput" min="0" max="1" step="0.001" value="0.05" style="width:100%;box-sizing:border-box;margin-top:4px">
    </div>
    <div class="physics-control">
      <label for="enrichMultTestSelect">Multiple testing correction</label>
      <select id="enrichMultTestSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="holm" selected>Holm</option>
        <option value="bonferroni">Bonferroni</option>
      </select>
    </div>
    <button class="button-switch" id="assocButton" type="button" title="Select points first" disabled style="width:100%;margin:4px 0 10px 0">Compute Associations</button>
    <div style="font-size:11px;opacity:0.6;margin-bottom:8px">Variables to test for significance:</div>
    <div id="enrichVarList"><div class="node-info-placeholder">No properties found in this dataset.</div></div>
  </div>
</div>

<!-- Main visualization: full width / centered; left panel floats over it -->
<div id="scatter-main">
<svg id="scatterSvg" width="{{ WIDTH }}" height="{{ HEIGHT }}"></svg>

<script>
	{% include "d3.v4.min.js" %}
</script>


<form>
    <div style="max-width:{{ WIDTH }}px;">
        <center>
        	<input type="radio" name="radio_states" value="radiobutton1" style="{{ RADIO_VISIBLE1 }}" checked="checked"> <label> {{ RADIO_LABEL1 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton2" style="{{ RADIO_VISIBLE2 }}"> <label> {{ RADIO_LABEL2 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton3" style="{{ RADIO_VISIBLE3 }}"> <label> {{ RADIO_LABEL3 }} </label>
        </center>
    </div>
</form>


<!-- Create a div where the graph will take place -->
<div id="my_dataviz"></div>
</div><!-- /#scatter-main -->

<!-- Bottom slide-up point info panel (resize handle at middle top) -->
<div id="nodePanel" role="dialog" aria-label="Point details">
  <div id="nodePanelResizeHandle" title="Drag to resize" aria-label="Resize panel"></div>
  <div class="node-panel-header">
    <div>
      <div class="node-panel-title" id="nodePanelTitle">—</div>
      <div class="node-panel-sub" id="nodePanelSub"></div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="node-panel-close" id="nodePanelClose" type="button">✕</button>
    </div>
  </div>
  <div id="nodeStatsGrid" style="padding:8px 12px;"></div>
</div>

<!-- Circle are black when hovered-->
<style>
	.myCircle:hover {
	  stroke: black;
	}
</style>



<script>
	var jsonData = {{ json_data }};

// Use the main scatter SVG (must not use d3.select("svg") — the Layout
// panel chevron is also an <svg> and comes first in the DOM).
var svg = d3.select("#scatterSvg"),
    width = +svg.attr("width"),
    height = +svg.attr("height")-1;

var k = height / width,
    x0 = [{{MIN_X}}, {{MAX_X}}],
    y0 = [{{MIN_Y}}, {{MAX_Y}}],
    x = d3.scaleLinear().domain(x0).range([0, width]),
    y = d3.scaleLinear().domain(y0).range([height, 0]),
    z = d3.scaleOrdinal(d3.schemeCategory10);

var xAxis = d3.axisTop(x).ticks(12),
    yAxis = d3.axisRight(y).ticks(12 * height / width);

// create a tooltip with the box ****************************
// Fixed positioning + pageX/pageY so the box tracks the cursor next to the point
// (appending to #my_dataviz with SVG-local mouse coords put it far off-screen).
var Tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip")
  .style("opacity", 0)
  .style("position", "fixed")
  .style("pointer-events", "none")
  .style("z-index", 200)
  .style("background-color", "var(--tooltip-bg, white)")
  .style("color", "var(--tooltip-text, #111)")
  .style("border", "1px solid rgba(0,0,0,0.15)")
  .style("border-radius", "5px")
  .style("padding", "5px 8px")
  .style("font-size", "12px")
  .style("box-shadow", "0 2px 8px rgba(0,0,0,0.15)")
  .style("max-width", "280px")
  .style("white-space", "nowrap");

// Image URLs / file paths in tooltip text are rendered as fixed-size thumbnails
// so mixed tooltips stay visually consistent. Author-supplied HTML (<br>, spans,
// etc.) is preserved — only plain image URL/path tokens outside tags are rewritten.
var IMAGE_EXT_RE = /\.(png|jpe?g|gif|webp|svg|bmp|ico)(\?[^.\s]*)?$/i;
var IMAGE_URL_TOKEN_RE = /(?:https?:\/\/|ftp:\/\/|file:\/\/|www\.)[^\s<>"']+|\/[^\s<>"']+|[A-Za-z]:\\[^\s<>"']+/gi;

function isImageRef(s) {
  if (!s || typeof s !== 'string') return false;
  var t = s.trim();
  if (/^data:image\//i.test(t)) return true;
  return IMAGE_EXT_RE.test(t.split(/[?#]/)[0]);
}
function escapeHtmlTooltip(v) {
  if (v == null) return '';
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
function hrefForRef(s) {
  var t = String(s).trim();
  if (/^www\./i.test(t)) return 'https://' + t;
  if (/^\/[^\s]+$/.test(t) || /^[A-Za-z]:\\[^\s]+$/.test(t)) return 'file://' + t;
  return t;
}
// Preserve intentional HTML; convert plain image refs to fixed-size <img>.
function formatTooltipHtml(raw) {
  if (raw == null || raw === '') return '';
  var text = String(raw);
  // Whole-string image (no HTML tags) → single thumbnail
  if (text.indexOf('<') < 0 && isImageRef(text.trim())) {
    return '<img class="tooltip-img" src="' + escapeHtmlTooltip(hrefForRef(text.trim())) + '" alt="">';
  }
  // Walk the string: copy tags verbatim; in text nodes, rewrite image tokens.
  var result = '';
  var i = 0;
  while (i < text.length) {
    if (text.charAt(i) === '<') {
      var end = text.indexOf('>', i);
      if (end < 0) { result += text.slice(i); break; }
      result += text.slice(i, end + 1);
      i = end + 1;
      continue;
    }
    var nextTag = text.indexOf('<', i);
    if (nextTag < 0) nextTag = text.length;
    var chunk = text.slice(i, nextTag);
    result += chunk.replace(IMAGE_URL_TOKEN_RE, function(match) {
      if (isImageRef(match)) {
        return '<img class="tooltip-img" src="' + escapeHtmlTooltip(hrefForRef(match)) + '" alt="">';
      }
      return match;
    });
    i = nextTag;
  }
  return result;
}

// Canvas uses one delegated interaction layer instead of one DOM listener per point.
var hoveredPointIndex = -1;
function showPointTooltip(d, event) {
  if (!d) return;
  var raw = d[6] != null ? d[6] : '';
  var html = formatTooltipHtml(raw);
  // Multi-line / image tooltips need normal wrapping; plain single-line stays nowrap.
  var hasRich = html.indexOf('tooltip-img') >= 0 || /<(br|div|p|img|ul|ol|li|table|span|b|i|strong|em)\b/i.test(html);
  Tooltip
    .style('opacity', 1)
    .style('white-space', hasRich ? 'normal' : 'nowrap')
    .html(html)
    .style('left', (event.clientX + 14) + 'px')
    .style('top', (event.clientY + 12) + 'px');
}
function hidePointTooltip() {
  Tooltip.style('opacity', 0);
}
// ************************************************


// Add X axis
svg.append("g")
    .attr("class", "axis axis--x")
    .attr("transform", "translate(0," + (height - 10) + ")")
    .call(xAxis);

// Add Y axis
svg.append("g")
    .attr("class", "axis axis--y")
    .attr("transform", "translate(10,0)")
    .call(yAxis);

// Canvas rendering layer: one element replaces one SVG element per point.
var canvas = document.createElement('canvas');
canvas.id = 'scatterCanvas';
document.getElementById('scatter-main').insertBefore(canvas, document.getElementById('scatterSvg'));
var canvasCtx = canvas.getContext('2d');
var dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));
canvas.style.width = width + 'px';
canvas.style.height = (height + 1) + 'px';
canvas.width = Math.round(width * dpr);
canvas.height = Math.round((height + 1) * dpr);
canvasCtx.setTransform(dpr, 0, 0, dpr, 0, 0);

var hitCellSize = 32;
var hitGrid = new Map();
var visiblePointIndices = [];
var renderFramePending = false;
var isPanning = false, didPan = false, panStart = null;
var selectMode = false;
var selectedIndices = new Set();
var isSelecting = false, didSelectDrag = false, selectDragStart = null, selectionRectPx = null;
var searchHighlightIndex = -1;
var currentColorAccessor = null;
var categoricalShapeMap = null, categoricalShapeKey = null;

function canvasPointFromEvent(event) {
  var rect = canvas.getBoundingClientRect();
  return {
    px: (event.clientX - rect.left) * width / (rect.width || width),
    py: (event.clientY - rect.top) * (height + 1) / (rect.height || (height + 1))
  };
}
function scheduleRender() {
  if (renderFramePending) return;
  renderFramePending = true;
  requestAnimationFrame(function() {
    renderFramePending = false;
    renderPoints();
    // Labels are a separate SVG layer drawn on top of the canvas points, so
    // they must be refreshed in the SAME frame as renderPoints() -- not
    // just on mouseup/dblclick/etc -- or they visibly lag/freeze behind the
    // points while panning/zooming is in progress. updatePointLabels()
    // already no-ops cheaply when no label key is active or not zoomed in
    // enough, so doing this every frame is safe.
    updatePointLabels();
  });
}
function addHit(i, px, py) {
  var key = Math.floor(px / hitCellSize) + ',' + Math.floor(py / hitCellSize);
  var bucket = hitGrid.get(key);
  if (!bucket) hitGrid.set(key, bucket = []);
  bucket.push(i);
}
function rebuildHitGrid() {
  hitGrid.clear();
  visiblePointIndices.length = 0;
  var c = currentCoordIndices(), xi = c[0], yi = c[1];
  var xd = x.domain(), yd = y.domain();
  for (var i=0; i<jsonData.length; i++) {
    var d=jsonData[i];
    if (!d || !Number.isFinite(+d[xi]) || !Number.isFinite(+d[yi])) continue;
    var xv=+d[xi], yv=+d[yi];
    if (xv<xd[0] || xv>xd[1] || yv<yd[0] || yv>yd[1]) continue;
    var px=x(xv), py=y(yv); var jp=jitteredPoint(i,px,py);
    visiblePointIndices.push(i);
    addHit(i,jp.px,jp.py);
  }
}
function hitTest(event) {
  var p=canvasPointFromEvent(event), gx=Math.floor(p.px/hitCellSize), gy=Math.floor(p.py/hitCellSize);
  var c=currentCoordIndices(), best=-1, bestDist=Infinity;
  for(var yy=gy-1;yy<=gy+1;yy++) for(var xx=gx-1;xx<=gx+1;xx++) {
    var bucket=hitGrid.get(xx+','+yy); if(!bucket) continue;
    for(var j=0;j<bucket.length;j++) {
      var i=bucket[j], d=jsonData[i], px=x(d[c[0]]), py=y(d[c[1]]); var jp=jitteredPoint(i,px,py); px=jp.px; py=jp.py;
      var r=Math.max(3, baseRadius(d)), dx=px-p.px, dy=py-p.py, dist=dx*dx+dy*dy;
      if(dist<=r*r && dist<bestDist){bestDist=dist;best=i;}
    }
  }
  return best;
}
function drawSymbol(ctx,shape,r) {
  if(shape==='circle'){ctx.arc(0,0,r,0,Math.PI*2);return;}
  if(shape==='square'){ctx.rect(-r,-r,2*r,2*r);return;}
  if(shape==='triangle'){var h=r*1.8;ctx.moveTo(0,-h);ctx.lineTo(-h*.866,h*.5);ctx.lineTo(h*.866,h*.5);ctx.closePath();return;}
  if(shape==='diamond'){var q=r*1.35;ctx.moveTo(0,-q);ctx.lineTo(q*.78,0);ctx.lineTo(0,q);ctx.lineTo(-q*.78,0);ctx.closePath();return;}
  var q=r*.45;ctx.moveTo(-r,-q);ctx.lineTo(-q,-q);ctx.lineTo(-q,-r);ctx.lineTo(q,-r);ctx.lineTo(q,-q);ctx.lineTo(r,-q);ctx.lineTo(r,q);ctx.lineTo(q,q);ctx.lineTo(q,r);ctx.lineTo(-q,r);ctx.lineTo(-q,q);ctx.lineTo(-r,q);ctx.closePath();
}
function renderPoints() {
  var ctx=canvasCtx; ctx.clearRect(0,0,width,height+1); rebuildHitGrid();
  var c=currentCoordIndices(), xi=c[0], yi=c[1];
  for(var n=0;n<visiblePointIndices.length;n++){
    var i=visiblePointIndices[n], d=jsonData[i], px=x(d[xi]), py=y(d[yi]); var jp=jitteredPoint(i,px,py); px=jp.px; py=jp.py;
    var r=baseRadius(d)*(i===hoveredPointIndex?1.4:1);
    var shape=currentShapeMode;
    if(categoricalShapeMap && d[11] && categoricalShapeMap[d[11][categoricalShapeKey]]) shape=categoricalShapeMap[d[11][categoricalShapeKey]];
    ctx.save(); ctx.globalAlpha=Number.isFinite(+d[4])?+d[4]:1; ctx.translate(px,py); ctx.beginPath(); drawSymbol(ctx,shape,r);
    ctx.fillStyle=(currentColorAccessor?currentColorAccessor(d):d[2])||'transparent'; ctx.fill();
    if(d[5]){ctx.strokeStyle=d[5];ctx.lineWidth=1;ctx.stroke();}
    if(i===hoveredPointIndex || i===searchHighlightIndex){ctx.strokeStyle=i===searchHighlightIndex?'#ff9900':'#000';ctx.lineWidth=i===searchHighlightIndex?3:2;ctx.stroke();}
    if(selectedIndices.has(i)){ctx.globalAlpha=1;ctx.lineWidth=2.5;ctx.strokeStyle='#1ABC9C';ctx.beginPath();ctx.arc(0,0,r+3,0,Math.PI*2);ctx.stroke();}
    ctx.restore();
  }
  if (selectionRectPx) {
    var rx=Math.min(selectionRectPx.x0,selectionRectPx.x1), ry=Math.min(selectionRectPx.y0,selectionRectPx.y1);
    var rw=Math.abs(selectionRectPx.x1-selectionRectPx.x0), rh=Math.abs(selectionRectPx.y1-selectionRectPx.y0);
    ctx.save();
    ctx.fillStyle='rgba(26,188,156,0.15)';
    ctx.strokeStyle='#1ABC9C';ctx.lineWidth=1.5;ctx.setLineDash([5,4]);
    ctx.fillRect(rx,ry,rw,rh);ctx.strokeRect(rx,ry,rw,rh);
    ctx.restore();
  }
}
function updateAxes(){svg.select(".axis--x").call(xAxis);svg.select(".axis--y").call(yAxis);}

canvas.addEventListener('mousedown',function(e){
  if(e.button!==0)return;
  if(selectMode){
    var p=canvasPointFromEvent(e);
    isSelecting=true;didSelectDrag=false;
    selectDragStart={px:p.px,py:p.py};
    selectionRectPx={x0:p.px,y0:p.py,x1:p.px,y1:p.py};
    e.preventDefault();
    return;
  }
  if(hitTest(e)>=0)return;
  isPanning=true;didPan=false;var p=canvasPointFromEvent(e);
  panStart={px:p.px,py:p.py,xDomain:x.domain().slice(),yDomain:y.domain().slice()};
  canvas.style.cursor='grabbing';e.preventDefault();
});
window.addEventListener('mousemove',function(e){
  if(isSelecting){
    var p=canvasPointFromEvent(e);
    var dx=p.px-selectDragStart.px, dy=p.py-selectDragStart.py;
    if(Math.abs(dx)>2||Math.abs(dy)>2)didSelectDrag=true;
    selectionRectPx={x0:selectDragStart.px,y0:selectDragStart.py,x1:p.px,y1:p.py};
    scheduleRender();
    return;
  }
  if(isPanning){
    var p=canvasPointFromEvent(e),dx=p.px-panStart.px,dy=p.py-panStart.py;
    if(Math.abs(dx)>2||Math.abs(dy)>2)didPan=true;
    var xs=panStart.xDomain[1]-panStart.xDomain[0],ys=panStart.yDomain[1]-panStart.yDomain[0];
    var ddx=dx*xs/(width||1),ddy=dy*ys/(height||1);
    x.domain([panStart.xDomain[0]-ddx,panStart.xDomain[1]-ddx]);
    y.domain([panStart.yDomain[0]+ddy,panStart.yDomain[1]+ddy]);
    updateAxes();scheduleRender();return;
  }
  var idx=hitTest(e);
  if(idx!==hoveredPointIndex){hoveredPointIndex=idx;if(idx>=0)showPointTooltip(jsonData[idx],e);else hidePointTooltip();scheduleRender();}
  else if(idx>=0)showPointTooltip(jsonData[idx],e);
});
window.addEventListener('mouseup',function(){
  if(isSelecting){
    if(didSelectDrag && selectionRectPx){
      var rx0=Math.min(selectionRectPx.x0,selectionRectPx.x1), rx1=Math.max(selectionRectPx.x0,selectionRectPx.x1);
      var ry0=Math.min(selectionRectPx.y0,selectionRectPx.y1), ry1=Math.max(selectionRectPx.y0,selectionRectPx.y1);
      var c=currentCoordIndices();
      var next=new Set();
      for(var n=0;n<visiblePointIndices.length;n++){
        var i=visiblePointIndices[n], d=jsonData[i];
        var px=x(d[c[0]]), py=y(d[c[1]]); var jp=jitteredPoint(i,px,py);
