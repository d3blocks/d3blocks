<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ TITLE }}</title>

    {{ SUPPORT }}

    <style>
      body { background: {{ COLOR_BACKGROUND }} }
      .search-hit{stroke:#ff9900!important;stroke-width:3px!important}
    </style>
    <style>{% include "scatter.css" %}</style>

    <style>
    /* Floating left layout panel (d3graph-style): overlays the plot, does not shift it.
       top/margin-top below are pre-JS fallbacks only -- positionSidePanels()
       (see script) measures the top-panel's actual rendered height at
       runtime and overrides these, since that height varies with the logo
       image load, font rendering, and wrapping on narrow screens. */
    #exportPanel.stats-panel {
      top: 80px;
      left: 10px;
      z-index: 65;
    }
    #densityPanel.stats-panel {
      top: 180px;
      left: 10px;
      z-index: 62;
    }
    #layoutPanel.stats-panel {
      top: 280px;
      left: 10px;
      z-index: 60;
    }
    #physicsPanel.stats-panel {
      top: 520px;
      left: 10px;
      z-index: 58;
    }
    #enrichPanel.stats-panel {
      top: 600px;
      left: 10px;
      z-index: 55;
    }
    #enrichVarsPanel.stats-panel {
      top: 700px;
      left: 10px;
      z-index: 54;
    }
    /* Keep the fixed-size scatterplot centered in the viewport */
    #scatter-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      position: relative;
      margin-top: 80px;
    }
    #scatterSvg {
      display: block;
      margin: 0 auto;
      position: relative;
      z-index: 0;
      pointer-events: none;
    }
    #scatterDensityCanvas {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 1;
      pointer-events: none;
    }
    #scatterCanvas {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      z-index: 2;
      pointer-events: auto;
    }
    #my_dataviz {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    </style>

</head>

<body>

<!-- Top panel (search centered, controls on right) -->
<div class="top-panel" role="toolbar" aria-label="Top controls">

    <div class="top-panel-left">
        <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
            <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
        </a>
    </div>

    <div class="top-panel-center">
        <div class="search-wrap top-search">
        <input class="search-input" id="searchInput" type="search" placeholder="Find a point…" autocomplete="off" spellcheck="false" />
        <div class="search-results" id="searchResults"></div>
        </div>
    </div>

  <div class="top-panel-right">
    <span id="selectionCount" class="selection-count" style="display:none"></span>
    <button class="button-switch" id="selectModeBtn" type="button" title="Drag to select points; Shift+drag to add to selection; click a point to toggle it">Select</button>
    <button class="button-switch active" id="densityToggleBtn" type="button" title="Show or hide point-density heatmap">Hide Density</button>
    <button class="button-switch" id="themeBtn" type="button">Theme: Dark</button>
  </div>
</div>

<!-- Side panel: Export / Save (first in the left stack; collapsed by default) -->
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button class="button-switch" id="exportButton" type="button" title="Export selected points (or all, if none selected)" style="width:100%;margin:4px 0 8px 0">Export</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch" style="width:100%;margin:0 0 4px 0">Save</button>{{ SAVE_BUTTON_STOP }}
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads selected points (or all if none selected) as JSON.</div>
  </div>
</div>

<!-- Side panel: density heatmap tuning (directly below Export/Save; shown when density is enabled) -->
<div class="stats-panel collapsed" id="densityPanel">
  <div class="stats-panel-title">Density Layer<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <!--
    <div class="physics-control">
      <label for="densityGridSizeSlider">Grid size <span class="val" id="densityGridSizeVal">40</span></label>
      <input type="range" id="densityGridSizeSlider" min="5" max="120" step="5" value="40">
    </div>
      -->
    <div class="physics-control">
      <label for="densityBlurSlider">Blur <span class="val" id="densityBlurVal">8</span></label>
      <input type="range" id="densityBlurSlider" min="0" max="30" step="1" value="8">
    </div>
    <div class="physics-control">
      <label for="densityOpacitySlider">Opacity <span class="val" id="densityOpacityVal">0.6</span></label>
      <input type="range" id="densityOpacitySlider" min="0" max="1" step="0.05" value="0.6">
    </div>
    <button class="button-switch" id="densityResetBtn" type="button" style="width:100%;margin-top:8px">Reset to Default</button>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Heatmap of point density in the current view.</div>
  </div>
</div>

<!-- Side panel: Size / Color / Shape (collapsed by default) -->
<div class="stats-panel collapsed" id="layoutPanel">
  <div class="stats-panel-title">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="layoutSizeSelect">Size</label>
      <select id="layoutSizeSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
      <div class="slider-row" style="margin-top:8px">
        <label for="sizeMultiplierSlider">Size multiplier <span class="val" id="sizeMultiplierVal">1.0×</span></label>
        <input type="range" id="sizeMultiplierSlider" min="-1" max="1" step="0.01" value="0">
      </div>
      <div class="slider-row" style="margin-top:8px">
        <label>Size range <span class="val" id="sizeRangeVal">1.5px – 30.0px</span></label>
        <div class="dual-range" id="sizeRangeControl">
          <div class="dual-range-track"></div>
          <div class="dual-range-fill" id="sizeRangeFill"></div>
          <input type="range" id="sizeRangeMinSlider" class="dual-range-input dual-range-min"
                 min="0.5" max="60" step="0.5" value="1.5"
                 aria-label="Minimum point radius in pixels">
          <input type="range" id="sizeRangeMaxSlider" class="dual-range-input dual-range-max"
                 min="0.5" max="60" step="0.5" value="30"
                 aria-label="Maximum point radius in pixels">
        </div>
        <div style="font-size:11px;opacity:0.6;margin-top:2px">Smallest/largest a point can ever render, in pixels</div>
      </div>
      <div class="slider-row" style="margin-top:8px">
        <label for="jitterSlider">Jitter <span class="val" id="jitterVal">0px</span></label>
        <input type="range" id="jitterSlider" min="0" max="200" step="1" value="0">
      </div>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Separates fully overlapping points</div>
    </div>
    <div class="physics-control">
      <label for="layoutColorSelect">Color</label>
      <select id="layoutColorSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="physics-control">
      <label for="layoutShapeSelect">Shape</label>
      <select id="layoutShapeSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="circle">Default</option>
      </select>
    </div>
    <div class="physics-control">
      <label for="layoutLabelSelect">Label</label>
      <select id="layoutLabelSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="">None</option>
        <option value="__tooltip__">Name / tooltip</option>
      </select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Labels appear when zoomed in</div>
    </div>
    <button class="button-switch" id="layoutResetBtn" type="button" style="width:100%;margin-top:8px">Reset to Default</button>
  </div>
</div>

<!-- Side panel: force-directed physics. Overlapping points push apart via
     collision, while a weak spring keeps every point anchored near its real
     (x, y) position -- so nothing drifts far, it just de-overlaps. Turning
     it off reuses the same simulation, just with the collision force
     dropped and the anchor spring strengthened, so points settle straight
     back to their true coordinates instead of being teleported there. -->
<div class="stats-panel collapsed" id="physicsPanel">
  <div class="stats-panel-title">Physics<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="physicsForceCheckbox" style="display:flex;align-items:center;gap:8px;cursor:pointer;margin:0">
        <input type="checkbox" id="physicsForceCheckbox">
        <span>Force-directed points</span>
      </label>
      <div style="font-size:11px;opacity:0.6;margin-top:6px">Overlapping points push each other apart, then settle back near their real position. Disable to snap back to the original coordinates.</div>
    </div>
  </div>
</div>

<div class="stats-panel collapsed" id="enrichPanel">
  <div class="stats-panel-title">Statistical Enrichments<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button class="button-switch" id="assocButton" type="button" title="Select points first" disabled style="width:100%;margin:4px 0 10px 0">Compute Associations</button>
    <div class="enrich-options-row">
      <div class="physics-control enrich-option">
        <label for="enrichAlphaInput">Alpha cutoff</label>
        <input type="number" id="enrichAlphaInput" min="0" max="1" step="0.001" value="0.05" style="width:100%;box-sizing:border-box;margin-top:4px">
      </div>
      <div class="physics-control enrich-option">
        <label for="enrichMultTestSelect">Multiple testing</label>
        <select id="enrichMultTestSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
          <option value="holm" selected>Holm</option>
          <option value="bonferroni">Bonferroni</option>
        </select>
      </div>
    </div>
  </div>
</div>

<!-- Side panel: variables tested for statistical enrichment (split out from
     Statistical Enrichments so the two panels can be collapsed/scrolled
     independently -- the variable list can get long). -->
<div class="stats-panel collapsed" id="enrichVarsPanel">
  <div class="stats-panel-title">Enrichment Variables<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div style="font-size:11px;opacity:0.6;margin-bottom:8px">Variables to test for significance:</div>
    <div id="enrichVarList"><div class="node-info-placeholder">No properties found in this dataset.</div></div>
  </div>
</div>

<!-- Main visualization: full width / centered; left panel floats over it -->
<div id="scatter-main">
<svg id="scatterSvg" width="{{ WIDTH }}" height="{{ HEIGHT }}"></svg>

<script>
	{% include "d3.v4.min.js" %}
</script>


<form>
    <div style="max-width:{{ WIDTH }}px;">
        <center>
        	<input type="radio" name="radio_states" value="radiobutton1" style="{{ RADIO_VISIBLE1 }}" checked="checked"> <label> {{ RADIO_LABEL1 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton2" style="{{ RADIO_VISIBLE2 }}"> <label> {{ RADIO_LABEL2 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton3" style="{{ RADIO_VISIBLE3 }}"> <label> {{ RADIO_LABEL3 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton4" style="{{ RADIO_VISIBLE4 }}"> <label> {{ RADIO_LABEL4 }} </label>
        </center>
    </div>
</form>


<!-- Create a div where the graph will take place -->
<div id="my_dataviz"></div>
</div><!-- /#scatter-main -->

<!-- Bottom slide-up point info panel (resize handle at middle top) -->
<div id="nodePanel" role="dialog" aria-label="Point details">
  <div id="nodePanelResizeHandle" title="Drag to resize" aria-label="Resize panel"></div>
  <div class="node-panel-header">
    <div>
      <div class="node-panel-title" id="nodePanelTitle">—</div>
      <div class="node-panel-sub" id="nodePanelSub"></div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="node-panel-close" id="nodePanelClose" type="button">✕</button>
    </div>
  </div>
  <div id="nodeStatsGrid" style="padding:8px 12px;"></div>
</div>

<!-- Circle are black when hovered-->
<style>
	.myCircle:hover {
	  stroke: black;
	}
</style>



<script>
	var jsonData = {{ json_data }};

// Use the main scatter SVG (must not use d3.select("svg") — the Layout
// panel chevron is also an <svg> and comes first in the DOM).
var svg = d3.select("#scatterSvg"),
    width = +svg.attr("width"),
    height = +svg.attr("height")-1;

var k = height / width,
    x0 = [{{MIN_X}}, {{MAX_X}}],
    y0 = [{{MIN_Y}}, {{MAX_Y}}],
    x = d3.scaleLinear().domain(x0).range([0, width]),
    y = d3.scaleLinear().domain(y0).range([height, 0]),
    z = d3.scaleOrdinal(d3.schemeCategory10);

var xAxis = d3.axisTop(x).ticks(12),
    yAxis = d3.axisRight(y).ticks(12 * height / width);

// create a tooltip with the box ****************************
// Fixed positioning + pageX/pageY so the box tracks the cursor next to the point
// (appending to #my_dataviz with SVG-local mouse coords put it far off-screen).
var Tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip")
  .style("opacity", 0)
  .style("position", "fixed")
  .style("pointer-events", "none")
  .style("z-index", 200)
  .style("background-color", "var(--tooltip-bg, white)")
  .style("color", "var(--tooltip-text, #111)")
  .style("border", "1px solid rgba(0,0,0,0.15)")
  .style("border-radius", "5px")
  .style("padding", "5px 8px")
  .style("font-size", "12px")
  .style("box-shadow", "0 2px 8px rgba(0,0,0,0.15)")
  .style("max-width", "280px")
  .style("white-space", "nowrap");

// Image / audio URLs & file paths in tooltip text are rendered as media.
// Author-supplied HTML (<br>, spans, etc.) is preserved — only plain media
// URL/path tokens outside tags are rewritten.
// Supports: http(s)/ftp/file URLs, Windows paths (C:\...), Unix absolute
// paths (/...), and relative paths (./img.png, data/a.wav) by extension.
var IMAGE_EXT_RE = /\.(png|jpe?g|gif|webp|svg|bmp|ico)(\?[^.\s]*)?$/i;
var AUDIO_EXT_RE = /\.(mp3|wav|ogg|m4a|aac|flac|oga|opus)(\?[^.\s]*)?$/i;
// URL schemes OR any non-space token ending with a media extension (covers
// relative and absolute disk paths).
var MEDIA_URL_TOKEN_RE = /(?:https?:\/\/|ftp:\/\/|file:\/\/)[^\s<>"']+|www\.[^\s<>"']+|[^\s<>"']+\.(?:png|jpe?g|gif|webp|svg|bmp|ico|mp3|wav|ogg|m4a|aac|flac|oga|opus)(?:\?[^\s<>"']*)?/gi;

function isImageRef(s) {
  if (!s || typeof s !== 'string') return false;
  var t = s.trim();
  if (/^data:image\//i.test(t)) return true;
  // Strip file:// for extension check
  var path = t.replace(/^file:\/\//i, '');
  return IMAGE_EXT_RE.test(path.split(/[?#]/)[0]);
}
function isAudioRef(s) {
  if (!s || typeof s !== 'string') return false;
  var t = s.trim();
  if (/^data:audio\//i.test(t)) return true;
  var path = t.replace(/^file:\/\//i, '');
  return AUDIO_EXT_RE.test(path.split(/[?#]/)[0]);
}
function escapeHtmlTooltip(v) {
  if (v == null) return '';
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
// Build a browser-usable src/href from a path or URL.
// Windows disk paths become file:///C:/... ; Unix absolute become file:///...
// Relative paths are left as-is so the browser resolves them against the page URL.
function hrefForRef(s) {
  var t = String(s).trim();
  if (!t) return t;
  if (/^www\./i.test(t)) return 'https://' + t;
  if (/^(https?:|ftp:|data:)/i.test(t)) return t;
  if (/^file:\/\//i.test(t)) {
    // Normalize file://C:\foo -> file:///C:/foo
    var rest = t.replace(/^file:\/\//i, '');
    if (/^[A-Za-z]:[\\/]/.test(rest)) {
      return 'file:///' + rest.replace(/\\/g, '/');
    }
    if (rest.charAt(0) === '/') return 'file://' + rest;
    return 'file:///' + rest.replace(/\\/g, '/');
  }
  // Windows absolute path
  if (/^[A-Za-z]:[\\/]/.test(t)) {
    return 'file:///' + t.replace(/\\/g, '/');
  }
  // Unix absolute path
  if (t.charAt(0) === '/') {
    return 'file://' + t;
  }
  // Relative path (resolved against the HTML document location)
  return t;
}
function audioPlayerHtml(src) {
  var safe = escapeHtmlTooltip(src);
  return '<div class="tooltip-audio" data-src="' + safe + '">' +
    '<button type="button" class="tooltip-audio-btn" aria-label="Play">▶</button>' +
    '<canvas class="tooltip-audio-wave" width="160" height="36"></canvas>' +
    '<audio preload="metadata" src="' + safe + '"></audio>' +
    '</div>';
}
// Preserve intentional HTML; convert plain image/audio refs to media widgets.
function formatTooltipHtml(raw) {
  if (raw == null || raw === '') return '';
  var text = String(raw);
  // Whole-string media (no HTML tags)
  if (text.indexOf('<') < 0) {
    var t = text.trim();
    if (isImageRef(t)) return '<img class="tooltip-img" src="' + escapeHtmlTooltip(hrefForRef(t)) + '" alt="">';
    if (isAudioRef(t)) return audioPlayerHtml(hrefForRef(t));
  }
  // Walk the string: copy tags verbatim; in text nodes, rewrite media tokens.
  var result = '';
  var i = 0;
  while (i < text.length) {
    if (text.charAt(i) === '<') {
      var end = text.indexOf('>', i);
      if (end < 0) { result += text.slice(i); break; }
      result += text.slice(i, end + 1);
      i = end + 1;
      continue;
    }
    var nextTag = text.indexOf('<', i);
    if (nextTag < 0) nextTag = text.length;
    var chunk = text.slice(i, nextTag);
    result += chunk.replace(MEDIA_URL_TOKEN_RE, function(match) {
      if (isImageRef(match)) {
        return '<img class="tooltip-img" src="' + escapeHtmlTooltip(hrefForRef(match)) + '" alt="">';
      }
      if (isAudioRef(match)) {
        return audioPlayerHtml(hrefForRef(match));
      }
      return match;
    });
    i = nextTag;
  }
  return result;
}

// --- Tooltip pin + media wiring ---
var hoveredPointIndex = -1;
var pinnedTooltipIndex = -1; // >=0 means tooltip stays put until empty click
var focusedPointIndex = -1; // point opened in the bottom panel (teal ring, same as selection)
var tooltipAudioCtx = null;

function stopTooltipAudio(root) {
  var node = root || (Tooltip && Tooltip.node && Tooltip.node());
  if (!node) return;
  node.querySelectorAll('audio').forEach(function(a) {
    try { a.pause(); a.currentTime = 0; } catch (e) {}
  });
  node.querySelectorAll('.tooltip-audio-btn').forEach(function(b) {
    b.textContent = '▶';
    b.setAttribute('aria-label', 'Play');
    b.removeAttribute('title');
  });
}

function drawAudioWaveform(canvas, peaks, progress) {
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var w = canvas.width, h = canvas.height;
  ctx.clearRect(0, 0, w, h);
  var mid = h / 2;
  var n = peaks && peaks.length ? peaks.length : 48;
  var barW = Math.max(1, (w / n) * 0.7);
  var gap = w / n;
  ctx.fillStyle = 'rgba(127,127,127,0.35)';
  for (var i = 0; i < n; i++) {
    var amp = peaks && peaks[i] != null ? peaks[i] : (0.25 + 0.35 * Math.abs(Math.sin(i * 0.45)));
    var bh = Math.max(2, amp * (h - 4));
    var x = i * gap + (gap - barW) / 2;
    ctx.fillRect(x, mid - bh / 2, barW, bh);
  }
  if (progress != null && progress > 0) {
    ctx.fillStyle = 'var(--accent, #1ABC9C)';
    // re-draw played portion in accent (approximate via clip)
    ctx.save();
    ctx.beginPath();
    ctx.rect(0, 0, w * Math.min(1, Math.max(0, progress)), h);
    ctx.clip();
    ctx.fillStyle = '#1ABC9C';
    for (var j = 0; j < n; j++) {
      var amp2 = peaks && peaks[j] != null ? peaks[j] : (0.25 + 0.35 * Math.abs(Math.sin(j * 0.45)));
      var bh2 = Math.max(2, amp2 * (h - 4));
      var x2 = j * gap + (gap - barW) / 2;
      ctx.fillRect(x2, mid - bh2 / 2, barW, bh2);
    }
    ctx.restore();
  }
}

function extractPeaksFromBuffer(audioBuffer, buckets) {
  var data = audioBuffer.getChannelData(0);
  var peaks = new Array(buckets);
  var block = Math.floor(data.length / buckets) || 1;
  for (var i = 0; i < buckets; i++) {
    var start = i * block;
    var end = Math.min(data.length, start + block);
    var max = 0;
    for (var j = start; j < end; j++) {
      var v = Math.abs(data[j]);
      if (v > max) max = v;
    }
    peaks[i] = max;
  }
  // normalize
  var peakMax = 0;
  for (var k = 0; k < peaks.length; k++) if (peaks[k] > peakMax) peakMax = peaks[k];
  if (peakMax > 0) for (var m = 0; m < peaks.length; m++) peaks[m] /= peakMax;
  return peaks;
}

function wireTooltipAudio(root) {
  if (!root) return;
  root.querySelectorAll('.tooltip-audio').forEach(function(wrap) {
    // Avoid double-binding if content was not rebuilt
    if (wrap.getAttribute('data-wired') === '1') return;
    wrap.setAttribute('data-wired', '1');

    var btn = wrap.querySelector('.tooltip-audio-btn');
    var canvas = wrap.querySelector('.tooltip-audio-wave');
    var audio = wrap.querySelector('audio');
