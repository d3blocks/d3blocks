// Populate Layout dropdowns from per-point properties.
// Properties are stored in d[11]. The controls must be initialized from
// the complete dataset, not from the currently selected point.
(function initLayoutPropertyControls() {
  var propsByKey = Object.create(null);
  var numericKeys = Object.create(null);
  var categoricalKeys = Object.create(null);

  for (var i = 0; i < jsonData.length; i++) {
    var props = jsonData[i] && jsonData[i][11];
    if (!props || typeof props !== 'object') continue;

    Object.keys(props).forEach(function(key) {
      var value = props[key];
      if (value == null) return;

      propsByKey[key] = true;
      if (typeof value === 'number' && Number.isFinite(value)) {
        numericKeys[key] = true;
      } else {
        categoricalKeys[key] = true;
      }
    });
  }

  var sizeSelect = document.getElementById('layoutSizeSelect');
  var colorSelect = document.getElementById('layoutColorSelect');
  var shapeSelect = document.getElementById('layoutShapeSelect');
  var labelSelect = document.getElementById('layoutLabelSelect');

  function addOption(select, value, label) {
    if (!select) return;
    var option = document.createElement('option');
    option.value = value;
    option.textContent = label;
    select.appendChild(option);
