    .text(function(v){ return labelTextFor(v.d); })
    .attr('x', function(v){ return renderPosFor(v.i, x(v.d[xi]), y(v.d[yi])).px + 8; })
    .attr('y', function(v){ return renderPosFor(v.i, x(v.d[xi]), y(v.d[yi])).py + 3; });
