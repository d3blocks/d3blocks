function updatePointLabels() {
  if (!currentLabelKey || !isZoomedInEnough()) {
    labelGroup.selectAll('text').remove();
    return;
  }
  var coords = currentCoordIndices();
  var xi = coords[0], yi = coords[1];
  var xd = x.domain(), yd = y.domain();
  // Only label points currently in the visible domain (keeps cost low when zoomed in)
  var visible = [];
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    if (!d) continue;
    var xv = d[xi], yv = d[yi];
    if (xv >= xd[0] && xv <= xd[1] && yv >= yd[0] && yv <= yd[1]) {
      visible.push({ d: d, i: i });
