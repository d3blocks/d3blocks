  const themeBtn = document.getElementById('themeBtn');
  const isLight = document.body.classList.toggle('light');
  if (themeBtn) themeBtn.textContent = isLight ? 'Theme: Light' : 'Theme: Dark';
}
const themeBtn = document.getElementById('themeBtn'); if (themeBtn) { themeBtn.addEventListener('click', toggleTheme); themeBtn.textContent = document.body.classList.contains('light') ? 'Theme: Light' : 'Theme: Dark'; }
