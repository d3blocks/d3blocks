<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ TITLE }}</title>

    {{ SUPPORT }}

    <style>
      body { background: {{ COLOR_BACKGROUND }} }
      /* Top-panel & controls (small subset of scatter.css) */
      .top-panel { display:flex; align-items:center; gap:8px; padding:8px 12px; }
      .top-panel .top-panel-left { flex:0 0 40px }
      .top-panel .top-panel-center { flex:1; display:flex; justify-content:center }
      .top-panel .top-panel-right { flex:0 0 auto; display:flex; gap:8px; align-items:center }
      .search-wrap { position:relative; width:100%; max-width:520px }
      .search-input { width:100%; box-sizing:border-box; padding:6px 8px; border-radius:4px; border:1px solid rgba(0,0,0,0.12) }
      .search-input:focus { outline:none; box-shadow:0 0 0 3px rgba(90,150,240,0.08); }
      .search-results { position:absolute; top:calc(100% + 6px); left:0; right:0; background:white; border:1px solid rgba(0,0,0,0.08); box-shadow:0 8px 24px rgba(0,0,0,0.08); width:100%; max-height:240px; overflow:auto; display:none; z-index:80; border-radius:4px; padding:6px 0 }
      .search-results.open { display:block }
      .search-item { padding:6px 10px; cursor:pointer; display:flex; justify-content:space-between; align-items:center }
      .search-item.active, .search-item:hover { background: rgba(90,150,240,0.08) }
      .search-item .meta { color:#666; font-size:0.9em; margin-left:8px }
      .button-switch { padding:6px 10px; border-radius:6px; border:1px solid rgba(0,0,0,0.08); background:transparent; cursor:pointer }
      .button-switch:active { transform:translateY(1px) }
      .search-hit{stroke:#ff9900!important;stroke-width:3px!important}
      body.light { background: #fff }
    </style>
    <!-- Include radialgraph theme & panel CSS so the theme toggle shows visual changes -->
    <style>{% include "scatter.css" %}</style>

    <style>
    /* Floating left layout panel (d3graph-style): overlays the plot, does not shift it. */
    #layoutPanel.stats-panel {
      top: 56px;
      left: 10px;
      z-index: 60;
    }
    /* Keep the fixed-size scatterplot centered in the viewport */
    #scatter-main {
      display: flex;
      flex-direction: column;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
    }
    #scatterSvg {
      display: block;
      margin: 0 auto;
    }
    #my_dataviz {
      width: 100%;
      display: flex;
      justify-content: center;
    }
    </style>

</head>

<body>

<!-- Top panel (search centered, controls on right) -->
<div class="top-panel" role="toolbar" aria-label="Top controls" style="position:relative;z-index:40">

    <div class="top-panel-left">
        <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
            <img src="https://raw.githubusercontent.com/d3blocks/d3blocks/main/logo.png" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
        </a>
    </div>

    <div class="top-panel-center">
        <div class="search-wrap top-search">
        <input class="search-input" id="searchInput" type="search" placeholder="Find a point…" autocomplete="off" spellcheck="false" />
        <div class="search-results" id="searchResults"></div>
        </div>
    </div>

  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button">Theme: Dark</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch">Save</button>{{ SAVE_BUTTON_STOP }}
  </div>
</div>

<!-- Side panel: Size / Color / Shape (collapsible, floats over the plot like index.html.j2) -->
<div class="stats-panel" id="layoutPanel">
  <div class="stats-panel-title">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="layoutSizeSelect">Size</label>
      <select id="layoutSizeSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="physics-control">
      <label for="layoutColorSelect">Color</label>
      <select id="layoutColorSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="physics-control">
      <label for="layoutShapeSelect">Shape</label>
      <select id="layoutShapeSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="circle">Default</option>
      </select>
    </div>
    <div class="physics-control">
      <label for="layoutLabelSelect">Label</label>
      <select id="layoutLabelSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="">None</option>
        <option value="__tooltip__">Name / tooltip</option>
      </select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Labels appear when zoomed in</div>
    </div>
  </div>
</div>

<!-- Main visualization: full width / centered; left panel floats over it -->
<div id="scatter-main">
<svg id="scatterSvg" width="{{ WIDTH }}" height="{{ HEIGHT }}"></svg>

<script>
	{% include "d3.v4.min.js" %}
</script>


<form>
    <div style="max-width:{{ WIDTH }}px;">
        <center>
        	<input type="radio" name="radio_states" value="radiobutton1" style="{{ RADIO_VISIBLE1 }}" checked="checked"> <label> {{ RADIO_LABEL1 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton2" style="{{ RADIO_VISIBLE2 }}"> <label> {{ RADIO_LABEL2 }} </label>
        	<input type="radio" name="radio_states" value="radiobutton3" style="{{ RADIO_VISIBLE3 }}"> <label> {{ RADIO_LABEL3 }} </label>
        </center>
    </div>
</form>


<!-- Create a div where the graph will take place -->
<div id="my_dataviz"></div>
</div><!-- /#scatter-main -->

<!-- Bottom slide-up point info panel -->
<div id="nodePanel" role="dialog" aria-label="Point details">
  <div class="node-panel-header">
    <div>
      <div class="node-panel-title" id="nodePanelTitle">—</div>
      <div class="node-panel-sub" id="nodePanelSub"></div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="node-panel-close" id="nodePanelClose" type="button">✕</button>
    </div>
  </div>
  <div id="nodeStatsGrid" style="padding:8px 12px;"></div>
</div>

<!-- Circle are black when hovered-->
<style>
	.myCircle:hover {
	  stroke: black;
	}
	/* Node panel respects theme variables (floats above the plot, same as d3graph) */
	#nodePanel {
	  position: fixed; left: 10px; right: 10px; bottom: 0; z-index: 20;
	  transform: translateY(100%); transition: transform 200ms ease, opacity 200ms ease;
	  opacity: 0; pointer-events: none;
	  background: var(--panel-bg); color: var(--text);
	  border: 1px solid var(--panel-border); border-radius: 6px 6px 0 0;
	  box-shadow: 0 -4px 16px rgba(0,0,0,0.12);
	}
	#nodePanel.open { transform: translateY(0); opacity: 1; pointer-events: auto; }
	.node-panel-header { display:flex; justify-content:space-between; align-items:center; padding:10px 12px; border-bottom: 1px solid var(--panel-border); }
	.node-panel-title { font-weight:600 }
	.node-panel-sub { font-size:0.9em; color: var(--text-muted); }
	.node-panel-close { background:transparent; border:0; font-size:16px; cursor:pointer; color: var(--text); }
	</style>



<script>
	var jsonData = {{ json_data }};

// Use the main scatter SVG (must not use d3.select("svg") — the Layout
// panel chevron is also an <svg> and comes first in the DOM).
var svg = d3.select("#scatterSvg"),
    width = +svg.attr("width"),
    height = +svg.attr("height")-1;

var k = height / width,
    x0 = [{{MIN_X}}, {{MAX_X}}],
    y0 = [{{MIN_Y}}, {{MAX_Y}}],
    x = d3.scaleLinear().domain(x0).range([0, width]),
    y = d3.scaleLinear().domain(y0).range([height, 0]),
    z = d3.scaleOrdinal(d3.schemeCategory10);

var xAxis = d3.axisTop(x).ticks(12),
    yAxis = d3.axisRight(y).ticks(12 * height / width);

// create a tooltip with the box ****************************
// Fixed positioning + pageX/pageY so the box tracks the cursor next to the point
// (appending to #my_dataviz with SVG-local mouse coords put it far off-screen).
var Tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip")
  .style("opacity", 0)
  .style("position", "fixed")
  .style("pointer-events", "none")
  .style("z-index", 200)
  .style("background-color", "var(--tooltip-bg, white)")
  .style("color", "var(--tooltip-text, #111)")
  .style("border", "1px solid rgba(0,0,0,0.15)")
  .style("border-radius", "5px")
  .style("padding", "5px 8px")
  .style("font-size", "12px")
  .style("box-shadow", "0 2px 8px rgba(0,0,0,0.15)")
  .style("max-width", "280px")
  .style("white-space", "nowrap");

// Three function that change the tooltip when user hover / move / leave a cell
	var mouseover = function(d) {
	  Tooltip.style('opacity', 1);
	  // scale up the symbol slightly (respect current radio coordinate mode)
	  var c = (typeof currentCoordIndices === 'function') ? currentCoordIndices() : [0, 1];
	  d3.select(this).attr('transform', function(dd){ return transformForIndex(dd, c[0], c[1], 1.4); }).style('opacity', 0.9);
	};

	var mousemove = function(d) {
  var e = d3.event;
  Tooltip.html(d[6] != null ? d[6] : '')
    .style('left', (e.pageX + 14) + 'px')
    .style('top', (e.pageY + 12) + 'px');
}

var mouseleave = function(d) {
  Tooltip.style('opacity', 0);
  var c = (typeof currentCoordIndices === 'function') ? currentCoordIndices() : [0, 1];
  d3.select(this).attr('transform', function(dd){ return transformForIndex(dd, c[0], c[1], 1); });
}

// ************************************************


// Add X axis
svg.append("g")
    .attr("class", "axis axis--x")
    .attr("transform", "translate(0," + (height - 10) + ")")
    .call(xAxis);

// Add Y axis
svg.append("g")
    .attr("class", "axis axis--y")
    .attr("transform", "translate(10,0)")
    .call(yAxis);

// Transparent overlay for pan (drag) — sits behind points so clicks still hit them
var panOverlay = svg.insert("rect", ":first-child")
  .attr("class", "pan-overlay")
  .attr("width", width)
  .attr("height", height + 1)
  .attr("fill", "transparent")
  .style("cursor", "grab");

// Click-and-drag to pan the view (replaces brush rectangle zoom)
var isPanning = false;
var didPan = false; // true if this gesture moved — suppress click-to-close
var panStart = null; // {x, y, xDomain, yDomain}

function svgPixelFromEvent(event, node) {
  var rect = node.getBoundingClientRect();
  var scaleX = rect.width / (width || rect.width || 1);
  var scaleY = rect.height / ((height + 1) || rect.height || 1);
  return {
    px: (event.clientX - rect.left) / (scaleX || 1),
    py: (event.clientY - rect.top) / (scaleY || 1)
  };
}

function startPan(event) {
  // Only primary button; ignore if started on a point (points stopPropagation on click, but mousedown may still fire)
  if (event.button !== 0) return;
  var target = event.target;
  if (target && target.classList && target.classList.contains('point')) return;
  isPanning = true;
  didPan = false;
  var node = svg.node();
  var p = svgPixelFromEvent(event, node);
  panStart = {
    px: p.px,
    py: p.py,
    xDomain: x.domain().slice(),
    yDomain: y.domain().slice()
  };
  panOverlay.style("cursor", "grabbing");
  svg.style("cursor", "grabbing");
  event.preventDefault();
}

function movePan(event) {
  if (!isPanning || !panStart) return;
  var node = svg.node();
  var p = svgPixelFromEvent(event, node);
  var dx = p.px - panStart.px;
  var dy = p.py - panStart.py;
  if (Math.abs(dx) > 2 || Math.abs(dy) > 2) didPan = true;

  // Convert pixel delta to domain delta (invert of scale range)
  var xSpan = panStart.xDomain[1] - panStart.xDomain[0];
  var ySpan = panStart.yDomain[1] - panStart.yDomain[0];
  // x increases to the right; dragging right should move view left => domain decreases
  var dDataX = -dx * (xSpan / (width || 1));
  // y scale is inverted (domain high at top of screen); dragging down moves view up in data
  var dDataY = dy * (ySpan / (height || 1));

  x.domain([panStart.xDomain[0] + dDataX, panStart.xDomain[1] + dDataX]);
  y.domain([panStart.yDomain[0] + dDataY, panStart.yDomain[1] + dDataY]);
  zoom(0); // immediate update while dragging
  event.preventDefault();
}

function endPan() {
  if (!isPanning) return;
  isPanning = false;
  panStart = null;
  panOverlay.style("cursor", "grab");
  svg.style("cursor", null);
  updatePointLabels();
  // Clear didPan on next tick so the trailing click does not close the node panel
  setTimeout(function(){ didPan = false; }, 0);
}

// Attach pan to overlay (background); points keep their own click/hover
panOverlay.node().addEventListener('mousedown', startPan);
window.addEventListener('mousemove', movePan);
window.addEventListener('mouseup', endPan);

// Double-click background to reset zoom/pan to original domain
panOverlay.node().addEventListener('dblclick', function() {
  x.domain(x0.slice());
  y.domain(y0.slice());
  zoom(400);
});

// Mouse-wheel zoom (centered on cursor).
// Zooming in past LABEL_ZOOM_THRESHOLD makes point labels appear (if a Label is selected).
// Native listener with {passive:false} so preventDefault works in modern browsers.
(function setupWheelZoom() {
  var node = svg.node();
  if (!node) return;
  node.addEventListener('wheel', function(event) {
    event.preventDefault();
    event.stopPropagation();

    var delta = event.deltaY;
    // deltaY < 0 => scroll up => zoom in; > 0 => zoom out
    var scaleFactor = delta < 0 ? 0.85 : 1.18;

    var p = svgPixelFromEvent(event, node);
    var mx = x.invert(p.px);
    var my = y.invert(p.py);

    var xd = x.domain();
    var yd = y.domain();

    var newXd = [
      mx - (mx - xd[0]) * scaleFactor,
      mx + (xd[1] - mx) * scaleFactor
    ];
    var newYd = [
      my - (my - yd[0]) * scaleFactor,
      my + (yd[1] - my) * scaleFactor
    ];

    // Clamp zoom-out so we never go wider than the original domain
    var x0Span = Math.abs(x0[1] - x0[0]) || 1;
    var y0Span = Math.abs(y0[1] - y0[0]) || 1;
    if (Math.abs(newXd[1] - newXd[0]) > x0Span) {
      newXd = x0.slice();
    }
    if (Math.abs(newYd[1] - newYd[0]) > y0Span) {
      newYd = y0.slice();
    }

    // Avoid degenerate domains
    if (newXd[0] === newXd[1] || newYd[0] === newYd[1]) return;

    x.domain(newXd);
    y.domain(newYd);
    zoom(120); // short transition for responsive scroll zoom
  }, { passive: false });
})();

// Collapsible layout panel (same interaction as index.html.j2 stats-panels)
(function () {
  var panel = document.getElementById('layoutPanel');
  if (!panel) return;
  var title = panel.querySelector('.stats-panel-title');
  if (!title) return;
  title.addEventListener('click', function () {
    var collapsing = !panel.classList.contains('collapsed');
    if (collapsing) {
      if (panel.style.height) {
        panel.dataset.expandedHeight = panel.style.height;
      }
      panel.style.height = '';
    } else if (panel.dataset.expandedHeight) {
      panel.style.height = panel.dataset.expandedHeight;
    }
    panel.classList.toggle('collapsed');
  });
})();

// symbol/shape helpers and current mode state
var SHAPE_MAP = {
  'circle': d3.symbolCircle,
  'square': d3.symbolSquare,
  'triangle': d3.symbolTriangle,
  'diamond': d3.symbolDiamond,
  'cross': d3.symbolCross
};
var currentShapeMode = 'circle';
var shapeByProperty = null; // if set, maps categories to shapes

function symbolPathForRadius(r, shapeName) {
  var size = Math.PI * r * r; // area proportional to r^2
  var s = d3.symbol().type(SHAPE_MAP[shapeName] || d3.symbolCircle).size(size);
  return s();
}

function transformFor(d, scale) {
  scale = (typeof scale === 'number') ? scale : 1;
  return 'translate(' + x(d[0]) + ',' + y(d[1]) + ') scale(' + scale + ')';
}

// initialize all points as symbol paths ***********************
var points = svg.selectAll('.point')
  .data(jsonData)
  .enter().append('path')
    .attr('class', 'point')
    .attr('data-idx', function(d,i){ return i; })
    .attr('transform', function(d){ return transformFor(d, 1); })
    .attr('fill', function(d){ return d[2]; })
    .attr('opacity', function(d){ return d[4]; })
    .attr('stroke', function(d){ return d[5]; })
    .attr('data-base-r', function(d){ return d[3]; })
    .attr('d', function(d){ return symbolPathForRadius(d[3], currentShapeMode); })
    {{ MOUSEOVER }}
    {{ MOUSEMOVE }}
    {{ MOUSELEAVE }}
    .on('click', function(d){ d3.event.stopPropagation(); showNodePanel(d); });

// store initial radii array for resetting
var initialRadii = jsonData.map(function(d){ return (d && d[3]) ? d[3] : 1; });

// helper to transform by arbitrary coordinate indices (used for radio modes)
function transformForIndex(d, xi, yi, scale) {
  scale = (typeof scale === 'number') ? scale : 1;
  var xv = (typeof xi === 'number') ? d[xi] : d[0];
  var yv = (typeof yi === 'number') ? d[yi] : d[1];
  return 'translate(' + x(xv) + ',' + y(yv) + ') scale(' + scale + ')';
}

// Populate layout dropdowns based on available per-point properties
(function populateLayoutControls(){
  var keys = new Set();
  jsonData.forEach(function(d){ if (d && d[11]) Object.keys(d[11]).forEach(function(k){ keys.add(k); }); });
  var keysArr = Array.from(keys);
  var sizeSel = document.getElementById('layoutSizeSelect');
  var colorSel = document.getElementById('layoutColorSelect');
  var shapeSel = document.getElementById('layoutShapeSelect');
  var labelSel = document.getElementById('layoutLabelSelect');

  // Classify keys as numeric or categorical (simple heuristic)
  var numericKeys = [];
  var categoricalKeys = [];
  keysArr.forEach(function(k){
    var vals = jsonData.map(function(d){ return d && d[11] ? d[11][k] : null; });
    var hasNumber = vals.some(function(v){ return typeof v === 'number' && Number.isFinite(v); });
    var hasOther = vals.some(function(v){ return v != null && typeof v !== 'number'; });
    if (hasNumber && !hasOther) numericKeys.push(k);
    else categoricalKeys.push(k);
  });

  // Populate size select with numeric keys only
  if (sizeSel) {
    numericKeys.forEach(function(k){ var opt = document.createElement('option'); opt.value = k; opt.text = k; sizeSel.appendChild(opt); });
  }

  // Populate color select with all keys (numeric and categorical)
  if (colorSel) {
    keysArr.forEach(function(k){ var opt = document.createElement('option'); opt.value = k; opt.text = k; colorSel.appendChild(opt); });
  }

  // Populate shape select: keep explicit shape options already present; add property-based mapping only for categorical keys
  if (shapeSel) {
    if (categoricalKeys.length) {
      categoricalKeys.forEach(function(k){ var opt = document.createElement('option'); opt.value = 'prop:' + k; opt.text = k; shapeSel.appendChild(opt); });
    }
  }

  // Populate label select: tooltip name + all property keys
  if (labelSel) {
    keysArr.forEach(function(k){ var opt = document.createElement('option'); opt.value = k; opt.text = k; labelSel.appendChild(opt); });
  }
})();

// Apply size mapping for selected key (numeric)
function applySizeMode(key) {
  if (!key) {
    // reset
    points.each(function(d,i){ var r=initialRadii[i]; this.setAttribute('data-base-r', r); if (jsonData[i]) jsonData[i][3]=r; d3.select(this).attr('d', symbolPathForRadius(r, currentShapeMode)); });
    return;
  }
  // numeric mapping
  var vals = jsonData.map(function(dd){ return dd && dd[11] && typeof dd[11][key] === 'number' ? dd[11][key] : NaN; });
  var vnum = vals.filter(function(x){ return Number.isFinite(x); });
  if (!vnum.length) return;
  var vmin = Math.min.apply(null, vnum);
  var vmax = Math.max.apply(null, vnum);
  points.each(function(dd,i){
    var val = dd && dd[11] && typeof dd[11][key] === 'number' ? dd[11][key] : NaN;
    var newr = Number.isFinite(val) ? (vmax===vmin ? (1+15/2) : (1 + ((val - vmin)/(vmax - vmin)) * 15)) : initialRadii[i];
    this.setAttribute('data-base-r', newr);
    if (jsonData[i]) jsonData[i][3]=newr;
    d3.select(this).attr('d', symbolPathForRadius(newr, currentShapeMode));
  });
}

// Apply color mapping for selected key (categorical or numeric)
var currentColorScale = null;
function applyColorMode(key) {
  if (!key) {
    points.attr('fill', function(d){ return d[2]; });
    return;
  }
  var vals = jsonData.map(function(dd){ return dd && dd[11] ? dd[11][key] : null; });
  var numeric = vals.every(function(v){ return v==null || typeof v === 'number' && Number.isFinite(v); });
  if (numeric) {
    var vnum = vals.filter(function(x){ return Number.isFinite(x); });
    if (!vnum.length) return;
    var vmin = Math.min.apply(null, vnum);
    var vmax = Math.max.apply(null, vnum);
    currentColorScale = d3.scaleSequential(d3.interpolateViridis).domain([vmin, vmax]);
    points.attr('fill', function(d){ var v = d && d[11] ? d[11][key] : null; return (typeof v === 'number' && Number.isFinite(v)) ? currentColorScale(v) : d[2]; });
  } else {
    // categorical
    var uniq = Array.from(new Set(vals.filter(function(x){ return x != null; })));
    var palette = d3.schemeCategory10.concat(d3.schemeSet3 || []);
    var catScale = d3.scaleOrdinal().domain(uniq).range(palette);
    currentColorScale = catScale;
    points.attr('fill', function(d){ var v = d && d[11] ? d[11][key] : null; return v != null ? catScale(v) : d[2]; });
  }
}

// Apply shape mapping: either choose a single shape or map categories to shapes
var categoricalShapeMap = null;
function applyShapeMode(val) {
  // val can be one of shape names or 'prop:<key>'
  categoricalShapeMap = null;
  if (!val || SHAPE_MAP[val]) {
    currentShapeMode = val || 'circle';
    // update all shapes
    points.each(function(d,i){ var r = (jsonData[i] && jsonData[i][3]) ? jsonData[i][3] : initialRadii[i]; d3.select(this).attr('d', symbolPathForRadius(r, currentShapeMode)); });
    return;
  }
  if (val.indexOf('prop:')===0) {
    var key = val.split(':')[1];
    // compute unique categories
    var vals = jsonData.map(function(dd){ return dd && dd[11] ? dd[11][key] : null; });
    var uniq = Array.from(new Set(vals.filter(function(x){ return x != null; })));
    var shapeNames = Object.keys(SHAPE_MAP);
    categoricalShapeMap = {};
    uniq.forEach(function(u,i){ categoricalShapeMap[u] = shapeNames[i % shapeNames.length]; });
    // update shapes
    points.each(function(d,i){ var v = d && d[11] ? d[11][key] : null; var shape = v != null && categoricalShapeMap[v] ? categoricalShapeMap[v] : currentShapeMode; var r = (jsonData[i] && jsonData[i][3]) ? jsonData[i][3] : initialRadii[i]; d3.select(this).attr('d', symbolPathForRadius(r, shape)); });
  }
}

// —— Point labels (only drawn when zoomed in enough) ——
var currentLabelKey = null; // null | '__tooltip__' | property key
var labelGroup = svg.append('g').attr('class', 'point-labels').style('pointer-events', 'none');
var LABEL_ZOOM_THRESHOLD = 2.0; // show labels when domain is at least this factor smaller than original

function currentCoordIndices() {
  var modeNode = d3.select('input[name="radio_states"]:checked').node();
  var mode = modeNode ? modeNode.value : 'radiobutton1';
  if (mode === 'radiobutton2') return [7, 8];
  if (mode === 'radiobutton3') return [9, 10];
  return [0, 1];
}

function labelTextFor(d) {
  if (!currentLabelKey) return '';
  if (currentLabelKey === '__tooltip__') return (d && d[6] != null) ? String(d[6]) : '';
  if (d && d[11] && d[11][currentLabelKey] != null) {
    var v = d[11][currentLabelKey];
    return (typeof v === 'object') ? JSON.stringify(v) : String(v);
  }
  return '';
}

function isZoomedInEnough() {
  var xd = x.domain(), yd = y.domain();
  var xSpan = Math.abs(xd[1] - xd[0]);
  var ySpan = Math.abs(yd[1] - yd[0]);
  var x0Span = Math.abs(x0[1] - x0[0]) || 1;
  var y0Span = Math.abs(y0[1] - y0[0]) || 1;
  var zoomFactor = Math.min(x0Span / xSpan, y0Span / ySpan);
  return zoomFactor >= LABEL_ZOOM_THRESHOLD;
}

function updatePointLabels() {
  if (!currentLabelKey || !isZoomedInEnough()) {
    labelGroup.selectAll('text').remove();
    return;
  }
  var coords = currentCoordIndices();
  var xi = coords[0], yi = coords[1];
  var xd = x.domain(), yd = y.domain();
  // Only label points currently in the visible domain (keeps cost low when zoomed in)
  var visible = [];
  for (var i = 0; i < jsonData.length; i++) {
    var d = jsonData[i];
    if (!d) continue;
    var xv = d[xi], yv = d[yi];
    if (xv >= xd[0] && xv <= xd[1] && yv >= yd[0] && yv <= yd[1]) {
      visible.push({ d: d, i: i });
    }
  }
  var labels = labelGroup.selectAll('text').data(visible, function(v){ return v.i; });
  labels.exit().remove();
  labels.enter().append('text')
    .attr('class', 'point-label')
    .style('font-size', '11px')
    .style('paint-order', 'stroke')
    .style('stroke', 'var(--bg, #fff)')
    .style('stroke-width', '3px')
    .style('stroke-linejoin', 'round')
    .style('fill', 'var(--text, #222)')
    .merge(labels)
    .text(function(v){ return labelTextFor(v.d); })
    .attr('x', function(v){ return x(v.d[xi]) + 8; })
    .attr('y', function(v){ return y(v.d[yi]) + 3; });
}

function applyLabelMode(key) {
  currentLabelKey = key || null;
  updatePointLabels();
}

// Wire up layout controls
var layoutSizeSelect = document.getElementById('layoutSizeSelect'); if (layoutSizeSelect) layoutSizeSelect.addEventListener('change', function(e){ applySizeMode(e.target.value); });
var layoutColorSelect = document.getElementById('layoutColorSelect'); if (layoutColorSelect) layoutColorSelect.addEventListener('change', function(e){ applyColorMode(e.target.value); });
var layoutShapeSelect = document.getElementById('layoutShapeSelect'); if (layoutShapeSelect) layoutShapeSelect.addEventListener('change', function(e){ applyShapeMode(e.target.value); });
var layoutLabelSelect = document.getElementById('layoutLabelSelect'); if (layoutLabelSelect) layoutLabelSelect.addEventListener('change', function(e){ applyLabelMode(e.target.value); });

// background (svg) click closes the panel
// Background click closes the node panel (ignored after a pan drag)
svg.on("click", function() {
  if (didPan || isPanning) return;
  closeNodePanel();
});

// Node panel DOM refs and behavior
const nodePanel = document.getElementById("nodePanel");
const nodePanelTitle = document.getElementById("nodePanelTitle");
const nodePanelSub = document.getElementById("nodePanelSub");
const nodeStatsGrid = document.getElementById("nodeStatsGrid");
const nodePanelClose = document.getElementById("nodePanelClose");

function showNodePanel(d) {
  // d is an array of values: use d[6] as tooltip if present
  const title = (d && d[6]) ? d[6] : (d && d[0] != null ? String(d[0]) : 'Point');
  nodePanelTitle.textContent = title;
  const sub = (d && d[0] != null && d[1] != null) ? `x: ${d[0]}, y: ${d[1]}` : '';
  nodePanelSub.textContent = sub;
  // Render some basic stats
  if (nodeStatsGrid) {
    // Basic stats
    var html = '';
    html += '<div>radius: ' + d[3] + '</div>';
    html += '<div>opacity: ' + d[4] + '</div>';
    html += '<div>stroke: ' + d[5] + '</div>';
    // Additional user properties (if present as last element d[11])
    var props = (d && d[11]) ? d[11] : null;
    if (props && typeof props === 'object') {
      html += '<hr/>';
      html += '<div style="font-weight:600;margin-bottom:6px">Properties</div>';
      // Property list
      Object.keys(props).forEach(function(k){
        var v = props[k];
        // stringify objects/arrays
        if (typeof v === 'object' && v !== null) v = JSON.stringify(v);
        html += '<div style="display:flex;justify-content:space-between;gap:12px"><div style="color:#666">' + k + '</div><div>' + (v==null ? '' : v) + '</div></div>';
      });
      // Size-by control for numeric properties
      var numericKeys = Object.keys(props).filter(function(k){ return typeof props[k] === 'number'; });
      if (numericKeys.length) {
        html += '<hr/>';
        html += '<div style="display:flex;gap:8px;align-items:center"><label style="font-size:0.9em;margin-right:6px">Size by</label>';
        html += '<select id="sizeBySelect"><option value="">—</option>' + numericKeys.map(function(k){ return '<option value="'+k+'">'+k+'</option>'; }).join('') + '</select>';
        html += '<button id="resetSizeBtn" style="margin-left:6px">Reset</button></div>';
      }
    }
    nodeStatsGrid.innerHTML = html;

    // Wire up size control
    var sizeSel = document.getElementById('sizeBySelect');
    if (sizeSel) {
      sizeSel.addEventListener('change', function(e){
        var key = e.target.value;
        if (!key) return;
        // compute min/max of the property across data
        var vals = jsonData.map(function(dd){ return (dd && dd[11] && typeof dd[11][key] === 'number') ? dd[11][key] : NaN; });
        var vnum = vals.filter(function(x){ return Number.isFinite(x); });
        if (!vnum.length) return;
        var vmin = Math.min.apply(null, vnum);
        var vmax = Math.max.apply(null, vnum);

        // map values to radii between 1 and 20 and update symbol path
        points.each(function(dd, i){
          var val = (dd && dd[11] && typeof dd[11][key] === 'number') ? dd[11][key] : NaN;
          var newr;
          if (!Number.isFinite(val)) newr = initialRadii[i];
          else if (vmax === vmin) {
          newr = (1+15/2);
          } else {
            // Compress large values before normalization
            var logVal = Math.log1p(Math.max(0, val));
            var logMin = Math.log1p(Math.max(0, vmin));
            var logMax = Math.log1p(Math.max(0, vmax));
            var t = (logVal - logMin) / (logMax - logMin);
            newr = 1 + t * 15;
          }

          // update stored base radius and jsonData for persistence
          this.setAttribute('data-base-r', newr);
          if (jsonData[i]) jsonData[i][3] = newr;
          d3.select(this).attr('d', symbolPathForRadius(newr, currentShapeMode));
        });
      });

      var resetBtn = document.getElementById('resetSizeBtn');
      if (resetBtn) resetBtn.addEventListener('click', function(){
        points.each(function(d,i){
          var r = initialRadii[i];
          this.setAttribute('data-base-r', r);
          if (jsonData[i]) jsonData[i][3] = r;
          d3.select(this).attr('d', symbolPathForRadius(r, currentShapeMode));
        });
        var sel = document.getElementById('sizeBySelect'); if (sel) sel.value = '';
      });
    }
  }
  if (nodePanel) nodePanel.classList.add('open');
}

function closeNodePanel() {
  if (nodePanel) nodePanel.classList.remove('open');
}

if (nodePanelClose) nodePanelClose.addEventListener('click', closeNodePanel);

// —— Search & jump (basic, adapted from radialgraph) ——
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');
let searchActiveIndex = -1;
let searchMatches = [];

function clearSearchHighlight() {
  d3.selectAll('.point').classed('search-hit', false);
}

function highlightPoint(idx) {
  clearSearchHighlight();
  const sel = d3.select('.point[data-idx="' + idx + '"]');
  if (!sel.empty()) sel.classed('search-hit', true);
}

function jumpToPoint(idx) {
  const i = parseInt(idx, 10);
  if (Number.isNaN(i) || i < 0 || i >= jsonData.length) return;
  // Show panel for the point and highlight it
  showNodePanel(jsonData[i]);
  highlightPoint(i);
  // Close results and set input value
  if (searchResults) searchResults.classList.remove('open');
  if (searchInput) {
    searchInput.value = (jsonData[i] && jsonData[i][6]) ? jsonData[i][6] : String(i);
    searchInput.blur();
  }
}

function renderSearchResults(query) {
  const q = (query || '').trim().toLowerCase();
  searchActiveIndex = -1;
  if (!q) {
    searchMatches = [];
    if (searchResults) { searchResults.innerHTML = ''; searchResults.classList.remove('open'); }
    return;
  }
  const all = jsonData.map(function(d,i){ return {id: (d && d[6]) ? String(d[6]) : String(i), idx: i, d: d}; });
  searchMatches = all
    .filter(function(it){ return it.id.toLowerCase().includes(q); })
    .sort(function(a,b){
      const al = a.id.toLowerCase(), bl = b.id.toLowerCase();
      const ap = al.startsWith(q) ? 0 : 1;
      const bp = bl.startsWith(q) ? 0 : 1;
      if (ap !== bp) return ap - bp;
      return a.id.length - b.id.length || a.id.localeCompare(b.id);
    })
    .slice(0, 12);

  if (!searchMatches.length) {
    if (searchResults) { searchResults.innerHTML = '<div class="search-item" style="opacity:0.5;cursor:default;padding:6px 10px">No matches</div>'; searchResults.classList.add('open'); }
    return;
  }
  if (searchResults) {
    searchResults.innerHTML = searchMatches.map(function(it, i){
      const d = it.d || {};
      const meta = (d[0] != null && d[1] != null) ? ('x:' + d[0] + ' · y:' + d[1]) : '';
      return '<div class="search-item" data-idx="'+it.idx+'" data-i="'+i+'" style="padding:6px 10px;cursor:pointer;display:flex;justify-content:space-between;align-items:center">' +
        '<div style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + it.id + '</div>' +
        (meta?('<div style="color:#666;font-size:0.9em;margin-left:8px">'+meta+'</div>'):'') +
        '</div>';
    }).join('');
    searchResults.classList.add('open');
  }
}

if (searchInput) searchInput.addEventListener('input', function(){ renderSearchResults(searchInput.value); });
if (searchInput) searchInput.addEventListener('focus', function(){ if (searchInput.value.trim()) renderSearchResults(searchInput.value); });

if (searchInput) searchInput.addEventListener('keydown', function(e){
  if (!searchResults || !searchResults.classList.contains('open') || !searchMatches.length) {
    if (e.key === 'Enter' && searchInput.value.trim()) {
      // Exact or first match
      const q = searchInput.value.trim();
      const exact = searchMatches.find(function(m){ return m.id === q; }) || searchMatches[0] || null;
      if (exact) jumpToPoint(exact.idx);
    }
    return;
  }
  if (e.key === 'ArrowDown') {
    e.preventDefault(); searchActiveIndex = Math.min(searchMatches.length - 1, searchActiveIndex + 1);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault(); searchActiveIndex = Math.max(0, searchActiveIndex - 1);
  } else if (e.key === 'Enter') {
    e.preventDefault(); const id = searchMatches[searchActiveIndex >= 0 ? searchActiveIndex : 0]; if (id) jumpToPoint(id.idx); return;
  } else if (e.key === 'Escape') {
    if (searchResults) { searchResults.classList.remove('open'); searchInput.blur(); } return;
  } else { return; }
  // update active class
  if (searchResults) {
    const items = searchResults.querySelectorAll('.search-item');
    items.forEach(function(el,i){ el.classList.toggle('active', i === searchActiveIndex); if (i === searchActiveIndex) el.scrollIntoView({block:'nearest'}); });
  }
});

if (searchResults) searchResults.addEventListener('mousedown', function(e){
  const item = e.target.closest('.search-item'); if (!item || !item.dataset.idx) return; e.preventDefault(); jumpToPoint(item.dataset.idx);
});

document.addEventListener('click', function(e){ if (!e.target.closest('.search-wrap')) { if (searchResults) searchResults.classList.remove('open'); } });

// Add small styles for search-hit
var sstyle = document.createElement('style'); sstyle.innerHTML = '.search-hit{stroke:#ff9900!important;stroke-width:3px!important;} .search-item.active{background:rgba(90,150,240,0.08);}'; document.head.appendChild(sstyle);

