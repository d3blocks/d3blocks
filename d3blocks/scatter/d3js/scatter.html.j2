});
// Populate Layout dropdowns from per-point properties.
// Properties are stored in d[13]. The controls must be initialized from
// the complete dataset, not from the currently selected point.
//
// Called (see bottom of the script, after associations.js loads) once
// enrichVarState is available, so numeric/categorical classification here
// matches the Enrichment Variables panel exactly: a column that's set
// (auto-detected or user-overridden) as "Category" there -- including
// numerically-coded categories like 0/1/2 cluster ids -- is offered as a
// Shape option here too, not just string-valued columns.
function initLayoutPropertyControls() {
  var columns = buildAllPropertyColumns();
  var propsByKey = Object.create(null);
  var numericKeys = Object.create(null);
  var categoricalKeys = Object.create(null);

  Object.keys(columns).forEach(function(key) {
    var col = columns[key];
    var hasValue = col.some(function(v){ return v != null && v !== ''; });
    if (!hasValue) return;
    var state = enrichVarState[key];
    if (state && state.enabled === false) return; // unchecked in Enrichment Variables -- hide from Layout too
    propsByKey[key] = true;
    var dtype = (state && state.dtypeOverride) || detectColumnDtype(col);
    if (dtype === 'num') numericKeys[key] = true;
    else categoricalKeys[key] = true;
  });

  var sizeSelect = document.getElementById('layoutSizeSelect');
  var colorSelect = document.getElementById('layoutColorSelect');
  var shapeSelect = document.getElementById('layoutShapeSelect');
  var labelSelect = document.getElementById('layoutLabelSelect');

  // This function is re-run whenever a variable's dtype is flipped in the
  // Enrichment Variables panel, so it must be safe to call repeatedly:
  // remember each dropdown's current selection, wipe out the previously
  // injected (dynamic) options -- keeping only the static first option
  // ("Default" / "None" / "circle") -- then rebuild from scratch.
  var prevSize = sizeSelect ? sizeSelect.value : '';
  var prevColor = colorSelect ? colorSelect.value : '';
  var prevShape = shapeSelect ? shapeSelect.value : '';
  var prevLabel = labelSelect ? labelSelect.value : '';

  function clearDynamicOptions(select) {
    if (!select) return;
    while (select.options.length > 1) select.remove(1);
  }
  clearDynamicOptions(sizeSelect);
  clearDynamicOptions(colorSelect);
  clearDynamicOptions(shapeSelect);
  clearDynamicOptions(labelSelect);

  function addOption(select, value, label) {
    if (!select) return;
    var option = document.createElement('option');
    option.value = value;
    option.textContent = label;
    select.appendChild(option);
  }

  Object.keys(numericKeys).sort().forEach(function(key) {
    addOption(sizeSelect, key, key);
    addOption(colorSelect, key, key);
  });

  Object.keys(categoricalKeys).sort().forEach(function(key) {
    addOption(colorSelect, key, key);
    addOption(shapeSelect, 'prop:' + key, key);
  });

  Object.keys(propsByKey).sort().forEach(function(key) {
    addOption(labelSelect, key, key);
  });

  // Restore each dropdown's previous selection if the option is still
  // there; otherwise fall back to its default and re-apply, so a variable
  // that just moved out of a dropdown (e.g. Numeric -> Category, dropping
  // out of Size) doesn't leave the plot rendered by a stale, now-invisible
  // selection.
  function restoreSelection(select, prevValue, fallbackValue, applyFn) {
    if (!select) return;
    var stillValid = Array.prototype.some.call(select.options, function(o){ return o.value === prevValue; });
    if (stillValid) {
      select.value = prevValue;
    } else {
      select.value = fallbackValue;
      applyFn(fallbackValue);
    }
  }
  restoreSelection(sizeSelect, prevSize, '', applySizeMode);
  restoreSelection(colorSelect, prevColor, '', applyColorMode);
  restoreSelection(shapeSelect, prevShape, 'circle', applyShapeMode);
  restoreSelection(labelSelect, prevLabel, '', applyLabelMode);
}


