// Populate Layout dropdowns from per-point properties.
// Properties are stored in d[11]. The controls must be initialized from
// the complete dataset, not from the currently selected point.
(function initLayoutPropertyControls() {
  var propsByKey = Object.create(null);
  var numericKeys = Object.create(null);
  var categoricalKeys = Object.create(null);

  for (var i = 0; i < jsonData.length; i++) {
    var props = jsonData[i] && jsonData[i][11];
    if (!props || typeof props !== 'object') continue;

    Object.keys(props).forEach(function(key) {
      var value = props[key];
      if (value == null) return;

      propsByKey[key] = true;
      if (typeof value === 'number' && Number.isFinite(value)) {
        numericKeys[key] = true;
      } else {
        categoricalKeys[key] = true;
      }
    });
  }

  var sizeSelect = document.getElementById('layoutSizeSelect');
  var colorSelect = document.getElementById('layoutColorSelect');
  var shapeSelect = document.getElementById('layoutShapeSelect');
  var labelSelect = document.getElementById('layoutLabelSelect');

  function addOption(select, value, label) {
    if (!select) return;
    var option = document.createElement('option');
    option.value = value;
    option.textContent = label;
    select.appendChild(option);
  }

  Object.keys(numericKeys).sort().forEach(function(key) {
    addOption(sizeSelect, key, key);
    addOption(colorSelect, key, key);
  });

  Object.keys(categoricalKeys).sort().forEach(function(key) {
    addOption(colorSelect, key, key);
    addOption(shapeSelect, 'prop:' + key, key);
  });

  Object.keys(propsByKey).sort().forEach(function(key) {
    addOption(labelSelect, key, key);
  });
})();


// Canvas click handling closes the panel when no point is hit.

// Node panel DOM refs and behavior
const nodePanel = document.getElementById("nodePanel");
const nodePanelTitle = document.getElementById("nodePanelTitle");
const nodePanelSub = document.getElementById("nodePanelSub");
const nodeStatsGrid = document.getElementById("nodeStatsGrid");
const nodePanelClose = document.getElementById("nodePanelClose");

function escapeHtml(v) {
  if (v == null) return '';
  return String(v)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

// URLs (http/https/ftp/www.) and absolute file paths (unix or Windows) are
// rendered as clickable links; everything else is shown as plain text.
var URL_RE = /^(https?:\/\/|ftp:\/\/)\S+$/i;
var WWW_RE = /^www\.\S+\.\S+$/i;
var FILE_URL_RE = /^file:\/\/\S+$/i;
var UNIX_PATH_RE = /^\/[^\s]+$/;
var WIN_PATH_RE = /^[A-Za-z]:\\[^\s]+$/;

function formatPropertyValue(v) {
  if (v == null) return '';
  if (typeof v === 'string') {
    var s = v.trim();
    var isLink = URL_RE.test(s) || WWW_RE.test(s) || FILE_URL_RE.test(s) || UNIX_PATH_RE.test(s) || WIN_PATH_RE.test(s);
    if (isLink) {
      var href = (WWW_RE.test(s)) ? ('https://' + s)
                : (UNIX_PATH_RE.test(s) || WIN_PATH_RE.test(s)) ? ('file://' + s)
                : s;
      return '<a class="node-info-link" href="' + escapeHtml(href) + '" target="_blank" rel="noopener noreferrer">' + escapeHtml(s) + '</a>';
    }
  }
  return escapeHtml(v);
}

function showNodePanel(d) {
  // d is an array of values: use d[6] as tooltip if present
  const title = (d && d[6]) ? d[6] : (d && d[0] != null ? String(d[0]) : 'Point');
  nodePanelTitle.textContent = title;
  const sub = (d && d[0] != null && d[1] != null) ? `x: ${d[0]}, y: ${d[1]}` : '';
  nodePanelSub.textContent = sub;
  // Render some basic stats
  if (nodeStatsGrid) {
    // Basic stats
    var html = '<div class="node-info-grid">';
    html += '<span class="node-info-label">Radius</span><span class="node-info-value">' + escapeHtml(d[3]) + '</span>';
    html += '<span class="node-info-label">Opacity</span><span class="node-info-value">' + escapeHtml(d[4]) + '</span>';
    html += '<span class="node-info-label">Stroke</span><span class="node-info-value">' + escapeHtml(d[5]) + '</span>';
    // Additional user properties (if present as last element d[11])
    var props = (d && d[11]) ? d[11] : null;
    if (props && typeof props === 'object') {
      html += '<div class="node-info-section-title">Properties</div>';
      // Property list
      Object.keys(props).forEach(function(k){
        var v = props[k];
        // stringify objects/arrays
        if (typeof v === 'object' && v !== null) v = JSON.stringify(v);
        html += '<span class="node-info-label">' + escapeHtml(k) + '</span><span class="node-info-value">' + formatPropertyValue(v) + '</span>';
      });
    }
    html += '</div>';
    nodeStatsGrid.innerHTML = html;
  }
  if (nodePanel) nodePanel.classList.add('open');
}

function closeNodePanel() {
  if (nodePanel) nodePanel.classList.remove('open');
}

if (nodePanelClose) nodePanelClose.addEventListener('click', closeNodePanel);

// —— Search & jump (basic, adapted from radialgraph) ——
const searchInput = document.getElementById('searchInput');
const searchResults = document.getElementById('searchResults');
let searchActiveIndex = -1;
let searchMatches = [];

function clearSearchHighlight() {
  searchHighlightIndex = -1;
  scheduleRender();
}
function highlightPoint(idx) {
  searchHighlightIndex = idx;
  scheduleRender();
}

function jumpToPoint(idx) {
  const i = parseInt(idx, 10);
  if (Number.isNaN(i) || i < 0 || i >= jsonData.length) return;
  // Show panel for the point and highlight it
  showNodePanel(jsonData[i]);
  highlightPoint(i);
  // Close results and set input value
  if (searchResults) searchResults.classList.remove('open');
  if (searchInput) {
    searchInput.value = (jsonData[i] && jsonData[i][6]) ? jsonData[i][6] : String(i);
    searchInput.blur();
  }
}

function renderSearchResults(query) {
  const q = (query || '').trim().toLowerCase();
  searchActiveIndex = -1;
  if (!q) {
    searchMatches = [];
    if (searchResults) { searchResults.innerHTML = ''; searchResults.classList.remove('open'); }
    return;
  }
  const all = jsonData.map(function(d,i){ return {id: (d && d[6]) ? String(d[6]) : String(i), idx: i, d: d}; });
  searchMatches = all
    .filter(function(it){ return it.id.toLowerCase().includes(q); })
    .sort(function(a,b){
      const al = a.id.toLowerCase(), bl = b.id.toLowerCase();
      const ap = al.startsWith(q) ? 0 : 1;
      const bp = bl.startsWith(q) ? 0 : 1;
      if (ap !== bp) return ap - bp;
      return a.id.length - b.id.length || a.id.localeCompare(b.id);
    })
    .slice(0, 12);

  if (!searchMatches.length) {
    if (searchResults) { searchResults.innerHTML = '<div class="search-item" style="opacity:0.5;cursor:default;padding:6px 10px">No matches</div>'; searchResults.classList.add('open'); }
    return;
  }
  if (searchResults) {
    searchResults.innerHTML = searchMatches.map(function(it, i){
      const d = it.d || {};
      const meta = (d[0] != null && d[1] != null) ? ('x:' + d[0] + ' · y:' + d[1]) : '';
      return '<div class="search-item" data-idx="'+it.idx+'" data-i="'+i+'" style="padding:6px 10px;cursor:pointer;display:flex;justify-content:space-between;align-items:center">' +
        '<div style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + it.id + '</div>' +
        (meta?('<div style="color:#666;font-size:0.9em;margin-left:8px">'+meta+'</div>'):'') +
        '</div>';
    }).join('');
    searchResults.classList.add('open');
  }
}

if (searchInput) searchInput.addEventListener('input', function(){ renderSearchResults(searchInput.value); });
if (searchInput) searchInput.addEventListener('focus', function(){ if (searchInput.value.trim()) renderSearchResults(searchInput.value); });

if (searchInput) searchInput.addEventListener('keydown', function(e){
  if (!searchResults || !searchResults.classList.contains('open') || !searchMatches.length) {
    if (e.key === 'Enter' && searchInput.value.trim()) {
      // Exact or first match
      const q = searchInput.value.trim();
      const exact = searchMatches.find(function(m){ return m.id === q; }) || searchMatches[0] || null;
      if (exact) jumpToPoint(exact.idx);
    }
    return;
  }
  if (e.key === 'ArrowDown') {
    e.preventDefault(); searchActiveIndex = Math.min(searchMatches.length - 1, searchActiveIndex + 1);
  } else if (e.key === 'ArrowUp') {
    e.preventDefault(); searchActiveIndex = Math.max(0, searchActiveIndex - 1);
  } else if (e.key === 'Enter') {
    e.preventDefault(); const id = searchMatches[searchActiveIndex >= 0 ? searchActiveIndex : 0]; if (id) jumpToPoint(id.idx); return;
  } else if (e.key === 'Escape') {
    if (searchResults) { searchResults.classList.remove('open'); searchInput.blur(); } return;
  } else { return; }
  // update active class
  if (searchResults) {
    const items = searchResults.querySelectorAll('.search-item');
    items.forEach(function(el,i){ el.classList.toggle('active', i === searchActiveIndex); if (i === searchActiveIndex) el.scrollIntoView({block:'nearest'}); });
  }
});

if (searchResults) searchResults.addEventListener('mousedown', function(e){
  const item = e.target.closest('.search-item'); if (!item || !item.dataset.idx) return; e.preventDefault(); jumpToPoint(item.dataset.idx);
});

document.addEventListener('click', function(e){ if (!e.target.closest('.search-wrap')) { if (searchResults) searchResults.classList.remove('open'); } });

// Add small styles for search-hit
var sstyle = document.createElement('style'); sstyle.innerHTML = '.search-hit{stroke:#ff9900!important;stroke-width:3px!important;} .search-item.active{background:rgba(90,150,240,0.08);}'; document.head.appendChild(sstyle);

// Theme toggle (button + T key)
function toggleTheme() {
  const themeBtn = document.getElementById('themeBtn');
  const isLight = document.body.classList.toggle('light');
  if (themeBtn) themeBtn.textContent = isLight ? 'Theme: Light' : 'Theme: Dark';
}
const themeBtn = document.getElementById('themeBtn'); if (themeBtn) { themeBtn.addEventListener('click', toggleTheme); themeBtn.textContent = document.body.classList.contains('light') ? 'Theme: Light' : 'Theme: Dark'; }
window.addEventListener('keydown', function(e){ if ((e.key === 't' || e.key === 'T') && !(e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA'))) toggleTheme(); });

// Coordinate-mode changes are animated on canvas rather than by creating
// an SVG transition object for every point.
var buttons = d3.selectAll('input[name="radio_states"]');
var targetCoordIndices = activeCoordIndices.slice(); // pair the animation is heading to (or already at)
var coordTransitionToken = 0; // bumped on every new transition to invalidate stale in-flight frame loops
buttons.on('change', function() {
  var target = this.value === 'radiobutton2' ? [7,8] : (this.value === 'radiobutton3' ? [9,10] : [0,1]);
  if (targetCoordIndices[0] === target[0] && targetCoordIndices[1] === target[1]) return; // already there / already heading there
  targetCoordIndices = target;
  var myToken = ++coordTransitionToken;
  // Snapshot each point's actual current position right now -- if a
  // previous transition was interrupted mid-flight, this is wherever it
  // actually got to, not where it started.
  var fromX = currentXVal.slice(), fromY = currentYVal.slice();
  var start = performance.now(), duration = 2500;

  function frame(now) {
    if (myToken !== coordTransitionToken) return; // superseded by a newer transition; stop
    var rawT = Math.min(1, (now-start)/duration);
    var t = rawT*rawT*(3-2*rawT);
    renderInterpolatedPoints(fromX,fromY,target[0],target[1],t);
    if(rawT<1) requestAnimationFrame(frame); else { activeCoordIndices = target; updatePointLabels(); }
  }
  requestAnimationFrame(frame);
});

function renderInterpolatedPoints(fromX,fromY,xi1,yi1,t) {
  var ctx=canvasCtx; ctx.clearRect(0,0,width,height+1);
  hitGrid.clear(); visiblePointIndices.length=0;
  var xd=x.domain(),yd=y.domain();
  for(var i=0;i<jsonData.length;i++){
    var d=jsonData[i]; if(!d)continue;
    var x0v=fromX[i], y0v=fromY[i], x1v=+d[xi1], y1v=+d[yi1];
    var xv=x0v+(x1v-x0v)*t, yv=y0v+(y1v-y0v)*t;
    currentXVal[i]=xv; currentYVal[i]=yv; // keep the live-position cache in sync every frame
    if(!Number.isFinite(xv)||!Number.isFinite(yv)||xv<xd[0]||xv>xd[1]||yv<yd[0]||yv>yd[1])continue;
    var px=x(xv),py=y(yv); var jp=jitteredPoint(i,px,py); px=jp.px; py=jp.py; var r=baseRadius(d)*(i===hoveredPointIndex?1.4:1);
    var shape=currentShapeMode;
    if(categoricalShapeMap&&d[11]&&categoricalShapeMap[d[11][categoricalShapeKey]])shape=categoricalShapeMap[d[11][categoricalShapeKey]];
    ctx.save();ctx.globalAlpha=Number.isFinite(+d[4])?+d[4]:1;ctx.translate(px,py);ctx.beginPath();drawSymbol(ctx,shape,r);
    ctx.fillStyle=(currentColorAccessor?currentColorAccessor(d):d[2])||'transparent';ctx.fill();
    if(d[5]){ctx.strokeStyle=d[5];ctx.lineWidth=1;ctx.stroke();}
    if(i===hoveredPointIndex||i===searchHighlightIndex){ctx.strokeStyle=i===searchHighlightIndex?'#ff9900':'#000';ctx.lineWidth=i===searchHighlightIndex?3:2;ctx.stroke();}
    ctx.restore();
  }
}

function zoom(duration) {
  updateAxes();
  scheduleRender();
  if(duration&&duration>0)updatePointLabels();
}

