function updateAxes(){svg.select(".axis--x").call(xAxis);svg.select(".axis--y").call(yAxis);}

canvas.addEventListener('mousedown',function(e){
  if(e.button!==0)return;
  if(selectMode){
    var p=canvasPointFromEvent(e);
    isSelecting=true;didSelectDrag=false;
    selectDragStart={px:p.px,py:p.py, addToSelection: !!e.shiftKey};
    selectionRectPx={x0:p.px,y0:p.py,x1:p.px,y1:p.py};
    e.preventDefault();
    return;
  }
  if(hitTest(e)>=0)return;
  isPanning=true;didPan=false;var p=canvasPointFromEvent(e);
  panStart={px:p.px,py:p.py,xDomain:x.domain().slice(),yDomain:y.domain().slice()};
  canvas.style.cursor='grabbing';e.preventDefault();
});
window.addEventListener('mousemove',function(e){
  if(isSelecting){
    var p=canvasPointFromEvent(e);
    var dx=p.px-selectDragStart.px, dy=p.py-selectDragStart.py;
    if(Math.abs(dx)>2||Math.abs(dy)>2)didSelectDrag=true;
    selectionRectPx={x0:selectDragStart.px,y0:selectDragStart.py,x1:p.px,y1:p.py};
    scheduleRender();
    return;
  }
  if(isPanning){
    var p=canvasPointFromEvent(e),dx=p.px-panStart.px,dy=p.py-panStart.py;
    if(Math.abs(dx)>2||Math.abs(dy)>2)didPan=true;
    var xs=panStart.xDomain[1]-panStart.xDomain[0],ys=panStart.yDomain[1]-panStart.yDomain[0];
    var ddx=dx*xs/(width||1),ddy=dy*ys/(height||1);
    x.domain([panStart.xDomain[0]-ddx,panStart.xDomain[1]-ddx]);
    y.domain([panStart.yDomain[0]+ddy,panStart.yDomain[1]+ddy]);
    updateAxes();scheduleRender();return;
  }
  var idx=hitTest(e);
  // While a tooltip is pinned, hover only updates the highlight — not the tooltip.
  if (pinnedTooltipIndex >= 0) {
    if (idx !== hoveredPointIndex) {
      hoveredPointIndex = idx;
      scheduleRender();
    }
    return;
  }
  if(idx!==hoveredPointIndex){
    hoveredPointIndex=idx;
    if(idx>=0) showPointTooltip(jsonData[idx], e);
    else hidePointTooltip();
    scheduleRender();
  } else if(idx>=0) {
    showPointTooltip(jsonData[idx], e);
  }
});
window.addEventListener('mouseup',function(){
  if(isSelecting){
    if(didSelectDrag && selectionRectPx){
      var rx0=Math.min(selectionRectPx.x0,selectionRectPx.x1), rx1=Math.max(selectionRectPx.x0,selectionRectPx.x1);
      var ry0=Math.min(selectionRectPx.y0,selectionRectPx.y1), ry1=Math.max(selectionRectPx.y0,selectionRectPx.y1);
      var c=currentCoordIndices();
      var next = (selectDragStart && selectDragStart.addToSelection)
        ? new Set(selectedIndices)
        : new Set();
      for(var n=0;n<visiblePointIndices.length;n++){
        var i=visiblePointIndices[n], d=jsonData[i];
        var px=x(d[c[0]]), py=y(d[c[1]]); var jp=jitteredPoint(i,px,py);
        if(jp.px>=rx0 && jp.px<=rx1 && jp.py>=ry0 && jp.py<=ry1) next.add(i);
      }
      selectedIndices = next;
      updateSelectionUI();
    }
    isSelecting=false;selectDragStart=null;selectionRectPx=null;
    setTimeout(function(){didSelectDrag=false;},0);
    scheduleRender();
    return;
  }
  if(isPanning){isPanning=false;panStart=null;canvas.style.cursor='default';updatePointLabels();setTimeout(function(){didPan=false;},0);}
});
canvas.addEventListener('click',function(e){
  if(selectMode){
    if(didSelectDrag)return; // a marquee drag already handled selection on mouseup
    var idx=hitTest(e);
    if(idx>=0){
      if(selectedIndices.has(idx)) selectedIndices.delete(idx); else selectedIndices.add(idx);
    } else {
      selectedIndices.clear();
    }
    updateSelectionUI();scheduleRender();
    return;
  }
  if(didPan)return;
  var idx=hitTest(e);
  if(idx>=0){
    // Pin tooltip in place and open the bottom detail panel.
    pinPointTooltip(idx, jsonData[idx], e);
    showNodePanel(jsonData[idx]);
  } else if(!isPanning){
    // Empty click: dismiss pinned tooltip and bottom panel.
    hidePointTooltip();
    closeNodePanel();
  }
});
canvas.addEventListener('dblclick',function(){
  x.domain(x0.slice());y.domain(y0.slice());updateAxes();scheduleRender();updatePointLabels();
});
scheduleRender();

// Mouse-wheel zoom (centered on cursor). Render is immediate and coalesced.
(function setupWheelZoom() {
  canvas.addEventListener('wheel',function(event){
    event.preventDefault();event.stopPropagation();
    var factor=event.deltaY<0?.85:1.18,p=canvasPointFromEvent(event);
    var mx=x.invert(p.px),my=y.invert(p.py),xd=x.domain(),yd=y.domain();
    var nx=[mx-(mx-xd[0])*factor,mx+(xd[1]-mx)*factor];
    var ny=[my-(my-yd[0])*factor,my+(yd[1]-my)*factor];
    if(Math.abs(nx[1]-nx[0])>Math.abs(x0[1]-x0[0]))nx=x0.slice();
    if(Math.abs(ny[1]-ny[0])>Math.abs(y0[1]-y0[0]))ny=y0.slice();
    if(nx[0]===nx[1]||ny[0]===ny[1])return;
    x.domain(nx);y.domain(ny);updateAxes();scheduleRender();updatePointLabels();
  },{passive:false});
})();

// Keep the floating side panels (Export, Layout, Enrichments) and the
// scatterplot clear of the fixed top bar, and stack the side panels below
// each other. Heights vary (logo image load, font rendering, collapse/expand,
// and the top bar may wrap onto two lines on a narrow screen), so this
// measures everything at runtime instead of assuming fixed pixel offsets --
// the same approach index.html.j2 uses for its positionSidePanels().
//
// Each panel also gets a max-height of (viewport bottom - its top), so a
// long Enrichments variable list cannot push the panel off-screen: the
// .stats-panel-body scrolls internally instead.
function positionSidePanels() {
  var bar = document.querySelector('.top-panel');
  var main = document.getElementById('scatter-main');
  if (!bar) return;
  var bottom = bar.getBoundingClientRect().bottom;
  if (main) main.style.marginTop = (bottom + 12) + 'px';
  var y = bottom + 8;
  var bottomPad = 12;
  var sideRight = 0;
  ['exportPanel', 'layoutPanel', 'densityPanel', 'enrichPanel'].forEach(function(id){
    var panel = document.getElementById(id);
    if (!panel || panel.style.display === 'none') return;
    panel.style.top = y + 'px';
    var maxH = Math.max(80, window.innerHeight - y - bottomPad);
    panel.style.maxHeight = maxH + 'px';
    var rect = panel.getBoundingClientRect();
    sideRight = Math.max(sideRight, rect.right);
    y += rect.height + 10;
  });
  // Bottom node panel: sit in the free band to the right of the left side
  // panels (no overlap), spanning that band so it reads as centered in the
  // remaining middle of the viewport.
  var nodePanelEl = document.getElementById('nodePanel');
  if (nodePanelEl) {
    var gap = 10;
    var leftInset = Math.max(10, Math.ceil(sideRight) + gap);
    nodePanelEl.style.left = leftInset + 'px';
    nodePanelEl.style.right = '10px';
  }
}
window.addEventListener('resize', positionSidePanels);
window.addEventListener('load', positionSidePanels);
positionSidePanels();
// Side panels are user-resizable; keep the bottom panel clear as they change width.
if (typeof ResizeObserver !== 'undefined') {
  ['exportPanel', 'layoutPanel', 'densityPanel', 'enrichPanel'].forEach(function(id) {
    var el = document.getElementById(id);
    if (!el) return;
    new ResizeObserver(function(){ positionSidePanels(); }).observe(el);
  });
}

// Collapsible side panels (same interaction as index.html.j2 stats-panels)
['exportPanel', 'layoutPanel', 'densityPanel', 'enrichPanel'].forEach(function(panelId) {
  var panel = document.getElementById(panelId);
  if (!panel) return;
  var title = panel.querySelector('.stats-panel-title');
  if (!title) return;
  title.addEventListener('click', function () {
    var collapsing = !panel.classList.contains('collapsed');
    if (collapsing) {
      if (panel.style.height) {
        panel.dataset.expandedHeight = panel.style.height;
      }
      panel.style.height = '';
    } else if (panel.dataset.expandedHeight) {
      panel.style.height = panel.dataset.expandedHeight;
    }
    panel.classList.toggle('collapsed');
    setTimeout(positionSidePanels, 0);
  });
});

