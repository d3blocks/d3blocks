// ---- Density toggle + left-panel sliders (mirrors d3graph density layer) ----
(function setupDensityControls() {
  var toggleBtn = document.getElementById('densityToggleBtn');
  var panel = document.getElementById('densityPanel');
  var gridSlider = document.getElementById('densityGridSizeSlider');
  var blurSlider = document.getElementById('densityBlurSlider');
  var opacitySlider = document.getElementById('densityOpacitySlider');
  var gridVal = document.getElementById('densityGridSizeVal');
  var blurVal = document.getElementById('densityBlurVal');
  var opacityVal = document.getElementById('densityOpacityVal');
  var resetBtn = document.getElementById('densityResetBtn');

  function refreshDensity() {
    if (typeof scheduleRender === 'function') scheduleRender();
    else if (typeof drawDensityLayer === 'function') drawDensityLayer();
  }

  function setDensityVisible(on) {
    densityVisible = !!on;
    if (toggleBtn) {
      toggleBtn.textContent = densityVisible ? 'Hide Density' : 'Show Density';
      toggleBtn.classList.toggle('active', densityVisible);
    }
    if (panel) {
      // Show the tuning panel only while density is on; leave collapsed state alone
      // so pressing Show Density does not auto-expand the panel.
      panel.style.display = densityVisible ? '' : 'none';
    }
    if (typeof positionSidePanels === 'function') positionSidePanels();
    refreshDensity();
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      setDensityVisible(!densityVisible);
    });
  }

  function wireSlider(slider, valueEl, apply) {
    if (!slider) return;
    slider.addEventListener('input', function() {
      var v = parseFloat(this.value);
      apply(v);
      if (valueEl) valueEl.textContent = String(v);
      refreshDensity();
    });
  }
  wireSlider(gridSlider, gridVal, function(v){ densityGridSize = v; });
  wireSlider(blurSlider, blurVal, function(v){ densityBlur = v; });
  wireSlider(opacitySlider, opacityVal, function(v){ densityOpacity = v; });

  if (resetBtn) {
    resetBtn.addEventListener('click', function() {
      densityGridSize = DEFAULT_DENSITY_GRID_SIZE;
      densityBlur = DEFAULT_DENSITY_BLUR;
      densityOpacity = DEFAULT_DENSITY_OPACITY;
      if (gridSlider) gridSlider.value = DEFAULT_DENSITY_GRID_SIZE;
      if (blurSlider) blurSlider.value = DEFAULT_DENSITY_BLUR;
      if (opacitySlider) opacitySlider.value = DEFAULT_DENSITY_OPACITY;
      if (gridVal) gridVal.textContent = String(DEFAULT_DENSITY_GRID_SIZE);
      if (blurVal) blurVal.textContent = String(DEFAULT_DENSITY_BLUR);
      if (opacityVal) opacityVal.textContent = String(DEFAULT_DENSITY_OPACITY);
      refreshDensity();
    });
  }

  // Density is on by default (see `densityVisible` init + static markup
  // above), but unlike the manual toggle-on path, the panel should stay
  // collapsed on load rather than auto-expanding. Just sync rendering /
  // layout for the already-correct initial DOM state.
  if (densityVisible) {
    if (typeof positionSidePanels === 'function') positionSidePanels();
    refreshDensity();
  }
})();

