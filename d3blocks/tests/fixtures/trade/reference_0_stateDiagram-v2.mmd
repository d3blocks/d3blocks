%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#ecfeff", "primaryBorderColor": "#0891b2", "primaryTextColor": "#0f172a", "secondaryColor": "#fef3c7", "secondaryBorderColor": "#f59e0b", "tertiaryColor": "#dcfce7", "tertiaryBorderColor": "#16a34a", "lineColor": "#f97316", "noteBkgColor": "#fef9c3", "noteTextColor": "#422006", "activationBkgColor": "#e0f2fe", "activationBorderColor": "#0284c7"}, "themeCSS": ".nodeLabel, .nodeLabel *, .label, .label *, .actor text, .entityLabel, .state-title, .stateLabel { fill: #0f172a !important; color: #0f172a !important; } .actor, .actor-man, .actor-woman { fill: #bae6fd !important; stroke: #0284c7 !important; } .entityBox { fill: #ccfbf1 !important; stroke: #0f766e !important; }"}}%%
stateDiagram-v2
    [*] --> pending : Signal created
    pending --> awaiting_approval : Risk checks pass
    pending --> cancelled : Strategy disabled / duplicate
    awaiting_approval --> approved : Operator approves
    awaiting_approval --> rejected : Operator rejects
    approved --> executed : Order sent to broker
    executed --> [*]
    rejected --> [*]
    cancelled --> [*]

    classDef queued fill:#fef3c7,stroke:#d97706,color:#422006,stroke-width:2px;
    classDef review fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:2px;
    classDef success fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:2px;
    classDef stop fill:#fee2e2,stroke:#dc2626,color:#7f1d1d,stroke-width:2px;
    class pending queued;
    class awaiting_approval review;
    class approved,executed success;
    class rejected,cancelled stop;
