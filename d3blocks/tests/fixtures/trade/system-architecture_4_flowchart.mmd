flowchart TD
  subgraph T1 ["Tier 1 - Observe and Report (active)"]
    T1A[Daily P/L and briefing workers]
    T1B[Portfolio snapshot worker]
    T1C[Signal cluster and anomaly monitors]
  end

  subgraph T2 ["Tier 2 - Signal Generation (active)"]
    T2A[News sentiment agent\nworkers/news_sentiment.py]
    T2B[Earnings preflight and context\nactive]
    T2C[Rebalance advisor\nactive]
  end

  subgraph T3 ["Tier 3 - Guarded Automation (partially active)"]
    T3A[Market regime gating\nactive]
    T3B[Approval and deterministic risk gates\nactive]
  end

  subgraph T4 ["Tier 4 - Operational Watchdog (active)"]
    T4A[Stale order and worker detection]
    T4B[Fill anomaly and reconciliation alerts]
  end

  T2A --> ApprovalQueue[Signal Approval Queue\nawait_approval status]
  T2B --> ApprovalQueue
  T2C --> ApprovalQueue
  ApprovalQueue --> HumanApproval[Human Review\nDashboard]
  HumanApproval --> Execution[Execution Service]

  T3A -.->|requires deterministic guardrails| Execution
  T1A -.->|no DB writes| Logs[Logs / Notifications]
  T4A -.->|rule-based, no LLM| Audit[Audit Events]
