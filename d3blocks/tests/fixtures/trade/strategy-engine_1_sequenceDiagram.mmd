sequenceDiagram
  participant Scheduler as strategy_scheduler
  participant Orch as strategy_orchestrator
  participant Narrator as position_risk_narrator
  participant Cluster as signal_cluster_detector
  participant Earnings as earnings_preflight
  participant Anomaly as anomaly_detector
  participant Param as parameter_tuning_advisor
  participant News as news_sentiment
  participant Rebalance as rebalance_advisor
  participant OpsBrief as operations_briefing
  participant OpsInvest as operations_investigator
  participant DB as PostgreSQL

  Scheduler->>Orch: _run_agent_workers()
  Orch->>Narrator: run(context)
  Narrator->>DB: write agent_suggestions row
  Orch->>Cluster: run(signals)
  Cluster->>DB: write alert signal (no strategy/run FK)
  Orch->>Earnings: run(positions)
  Earnings->>DB: write alert signal
  Orch->>Anomaly: run(orders)
  Anomaly->>DB: write alert signal
  Orch->>Param: run(backtests)
  Param->>DB: write agent_suggestions row
  Orch->>News: run(watchlist)
  News->>DB: write signals (awaiting_approval)
  Orch->>Rebalance: run(portfolio)
  Rebalance->>DB: write agent_suggestions row
  Scheduler->>OpsBrief: run(operations overview)
  OpsBrief->>DB: write agent_suggestions row
  Scheduler->>OpsInvest: run(read-only operations context)
  OpsInvest->>DB: write agent_suggestions row
