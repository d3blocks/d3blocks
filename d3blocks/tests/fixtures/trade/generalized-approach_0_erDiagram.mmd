erDiagram
    rag_generations ||--o{ rag_documents : "generation FK"
    rag_documents ||--o{ rag_chunks : "generation and document FK"
    rag_generations {
        uuid id PK
        text corpus
        text status
        text build_identity
        text embedding_identity
        integer embedding_dimensions
        text distance_metric
        text text_search_config
        integer payload_format_version
        integer chunk_count
        bigint content_revision
        text source_checkpoint
    }
    rag_documents {
        uuid generation_id PK,FK
        text document_id PK
        bigint source_revision
        text input_hash
        boolean is_deleted
    }
    rag_chunks {
        uuid generation_id PK,FK
        text chunk_id PK
        text document_id FK
        integer ordinal
        text state
        text product
        text channel
        tsvector search_vector
        vector embedding
        bytea payload_ciphertext
    }
