flowchart LR
  subgraph Browser
    UI[Next.js App Router]
  end

  subgraph API ["FastAPI - services/api"]
    Routers[Versioned Routers v1]
    Risk[Risk Controls]
    Audit[Audit Writer]
    DI[Broker DI Factory]
    NewsDI[News DI Factory]
    LLMFactory[LLM Factory]
  end

  subgraph Workers ["Background Workers - workers/"]
    Scheduler[strategy_scheduler.py]
    Poller[order_status_poller.py]
    PortfolioSync[portfolio_sync.py]
    BacktestWorker[backtest.py]
    subgraph AgentWorkers ["AI Agent Workers (--enable-agents)"]
      Orchestrator[strategy_orchestrator.py]
      Narrator[position_risk_narrator.py]
      Cluster[signal_cluster_detector.py]
      BacktestInterp[backtest_interpreter.py]
      ParamAdvisor[parameter_tuning_advisor.py]
      AnomalyDet[anomaly_detector.py]
      Earnings[earnings_preflight.py]
      NewsSent[news_sentiment.py]
      Rebalance[rebalance_advisor.py]
      PnLReport[pnl_report.py]
      SigRationale[signal_rationale.py]
      TradeReflect[trade_reflection.py]
      MktBriefing[market_briefing.py]
      OpsBriefing[operations_briefing.py]
      OpsInvestigator[operations_investigator.py]
      WLScreener[watchlist_screener.py]
    end
  end

  subgraph Adapters ["Provider Adapters"]
    SchwabAdapter[Schwab Adapter]
    FinnhubAdapter[Finnhub Adapter]
  end

  subgraph External ["External Services"]
    SchwabAPI[Schwab API]
    FinnhubAPI[Finnhub REST API]
    OpenAI[OpenAI API]
    Anthropic[Anthropic API]
  end

  PG[(PostgreSQL)]

  UI -->|HTTP + cookie auth| Routers
  Routers --> Risk
  Routers --> Audit
  Routers --> DI
  Routers --> NewsDI
  DI --> SchwabAdapter
  NewsDI --> FinnhubAdapter
  SchwabAdapter --> SchwabAPI
  FinnhubAdapter --> FinnhubAPI
  Routers --> PG
  Workers --> PG
  Workers --> SchwabAdapter
  AgentWorkers --> FinnhubAdapter
  AgentWorkers --> LLMFactory
  LLMFactory -->|config.yaml provider=openai| OpenAI
  LLMFactory -->|config.yaml provider=anthropic| Anthropic
