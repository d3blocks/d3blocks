<html lang="en">
<head>
<meta charset="utf-8" />

<title>{{ TITLE }}</title>
{{ SUPPORT }}

<style>{% include "tree.css" %}</style>

{% include "d3.tree.js" %}


{% include "d3.v4.min.js" %}
<!-- collapsibleTree styles in tree.css -->
{% include "collapsibleTree.js" %}

</head>
<body{% if darkMode == 'false' %} class="light"{% endif %}>

<!-- Top panel always shown: logo left, (search when controls on), theme right -->
<div class="top-panel" role="toolbar" aria-label="Top controls">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks" target="_blank" rel="noopener noreferrer">
        <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
  </div>

  <div class="top-panel-center">
{% if showControls == 'true' %}
    <div class="search-wrap top-search">
      <input class="search-input" id="searchInput" type="search" placeholder="Find a node…" autocomplete="off" spellcheck="false" />
      <div class="search-results" id="searchResults"></div>
    </div>
{% endif %}
  </div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button" title="{% if darkMode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if darkMode == 'false' %}☀{% else %}🌙{% endif %}</button>
  </div>
</div>

{% if showControls == 'true' %}
<!-- Side panel: Export / Save -->
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button class="button-switch" id="exportButton" type="button" title="Export tree hierarchy as JSON" style="width:100%;margin:4px 0 8px 0">Export</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch" style="width:100%;margin:0 0 4px 0">Save</button>{{ SAVE_BUTTON_STOP }}
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads the hierarchy as JSON. Save downloads the current tree as SVG.</div>
  </div>
</div>

<!-- Side panel: Physics (layout / spacing controls for the tree) -->
<div class="stats-panel collapsed" id="treePanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Physics<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div style="display:flex;gap:8px;margin:4px 0">
      <button class="button-switch" id="expandAllBtn" type="button" style="flex:1;margin:0">Expand All</button>
      <button class="button-switch" id="collapseAllBtn" type="button" style="flex:1;margin:0">Collapse All</button>
    </div>
    <div class="physics-control">
      <label for="fontSizeSlider">Font size <span class="val" id="fontSizeVal">{{ fontsize }}</span></label>
      <input type="range" id="fontSizeSlider" min="6" max="24" step="1" value="{{ fontsize }}">
    </div>
    <div class="physics-control">
      <label for="linkLengthSlider">Link length <span class="val" id="linkLengthVal">{{ link_length }}px</span></label>
      <input type="range" id="linkLengthSlider" min="20" max="300" step="5" value="{{ link_length }}">
    </div>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Expand/collapse all nodes, or adjust label size and horizontal spacing.</div>
  </div>
</div>
{% endif %}

<!-- Main visualization -->
<div id="tree-main">
<div id="htmlwidget_container">
  <div class="collapsibleTree html-widget html-node_color-item-overflow-hidden html-node_color-item" id="htmlwidget-treemap" style="width:100%;height:100%;"></div>
</div>
<script type="application/json" data-for="htmlwidget-treemap">{"x":

    {"data": 
            {{ json_data }},

        	"options": {"hierarchy": {{ hierarchy }},
                    	"input": null,
                    	"attribute": "Title",
                    	"linkLength": {{ link_length }},
                        "fontSize": {{ fontsize }},
                        "tooltip": true,
                        "collapsed": false,
                        "zoomable": true,
                        "margin": {"top": {{ marginTop }},"bottom": {{ marginBottom }},"left": {{ marginLeft }},"right": {{ marginRight }}}
                        }
    }

,"evals":[],"jsHooks":[]}</script>
<script type="application/htmlwidget-sizing" data-for="htmlwidget-treemap">
            {"viewer": {"width": 450,"height": 350,"padding": 0,"fill": true},
            "browser": {"width": {{ WIDTH }},"height": {{ HEIGHT }},"padding": 40,"fill": false}}
</script>

<script>
{{ SAVE_TO_SVG_SCRIPT }}
</script>
</div><!-- /#tree-main -->

<script>
(function() {
  var PANEL_ORDER = ['exportPanel', 'treePanel'];

  function positionSidePanels() {
    var bar = document.querySelector('.top-panel');
    var main = document.getElementById('tree-main');
    if (!bar) return;
    var bottom = bar.getBoundingClientRect().bottom;
    if (main) main.style.marginTop = (bottom + 12) + 'px';
    var y = bottom + 8;
    var bottomPad = 12;
    PANEL_ORDER.forEach(function(id) {
      var panel = document.getElementById(id);
      if (!panel || panel.style.display === 'none') return;
      panel.style.top = y + 'px';
      panel.style.maxHeight = Math.max(80, window.innerHeight - y - bottomPad) + 'px';
      y += panel.getBoundingClientRect().height + 10;
    });
  }
  window.addEventListener('resize', positionSidePanels);
  window.addEventListener('load', positionSidePanels);
  positionSidePanels();
  requestAnimationFrame(positionSidePanels);
  if (typeof ResizeObserver !== 'undefined') {
    PANEL_ORDER.forEach(function(id) {
      var el = document.getElementById(id);
      if (!el) return;
      new ResizeObserver(function() { positionSidePanels(); }).observe(el);
    });
  }

  PANEL_ORDER.forEach(function(panelId) {
    var panel = document.getElementById(panelId);
    if (!panel) return;
    var title = panel.querySelector('.stats-panel-title');
    if (!title) return;
    title.addEventListener('click', function() {
      if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
      var collapsing = !panel.classList.contains('collapsed');
      if (collapsing) {
        if (panel.style.height) panel.dataset.expandedHeight = panel.style.height;
        panel.style.height = '';
      } else if (panel.dataset.expandedHeight) {
        panel.style.height = panel.dataset.expandedHeight;
      }
      panel.classList.toggle('collapsed');
      setTimeout(positionSidePanels, 0);
    });
  });

  (function setupPanelReordering() {
    PANEL_ORDER.forEach(function(panelId) {
      var panel = document.getElementById(panelId);
      if (!panel) return;
      var title = panel.querySelector('.stats-panel-title');
      if (!title) return;
      title.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', panelId);
        e.dataTransfer.effectAllowed = 'move';
      });
      title.addEventListener('dragend', function() {
        title.dataset.justDragged = '1';
        setTimeout(function() { title.dataset.justDragged = '0'; }, 0);
      });
      panel.addEventListener('dragover', function(e) {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        panel.classList.add('drag-over');
      });
      panel.addEventListener('dragleave', function() { panel.classList.remove('drag-over'); });
      panel.addEventListener('drop', function(e) {
        e.preventDefault();
        panel.classList.remove('drag-over');
        var draggedId = e.dataTransfer.getData('text/plain');
        if (!draggedId || draggedId === panelId) return;
        var from = PANEL_ORDER.indexOf(draggedId), to = PANEL_ORDER.indexOf(panelId);
        if (from < 0 || to < 0) return;
        PANEL_ORDER.splice(from, 1);
        PANEL_ORDER.splice(to, 0, draggedId);
        positionSidePanels();
      });
    });
  })();

  function toggleTheme() {
    document.body.classList.toggle('light');
    var isLight = document.body.classList.contains('light');
    var themeBtn = document.getElementById('themeBtn');
    if (themeBtn) {
      themeBtn.textContent = isLight ? '☀' : '🌙';
      themeBtn.title = isLight ? 'Theme: Light' : 'Theme: Dark';
    }
  }
  var themeBtn = document.getElementById('themeBtn');
  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);

  function getTreeInstance() {
    return window.__d3treeInstance || null;
  }

  function expandAll() {
    var inst = getTreeInstance();
    if (!inst || !inst.root || !inst.update) return;
    function expand(d) {
      if (d._children) { d.children = d._children; d._children = null; }
      if (d.children) d.children.forEach(expand);
    }
    expand(inst.root);
    inst.update(inst.root);
  }
  function collapseAll() {
    var inst = getTreeInstance();
    if (!inst || !inst.root || !inst.update) return;
    function collapse(d) {
      if (d.children) {
        d._children = d.children;
        d._children.forEach(collapse);
        d.children = null;
      }
    }
    if (inst.root.children) inst.root.children.forEach(collapse);
    inst.update(inst.root);
  }
  var expandBtn = document.getElementById('expandAllBtn');
  var collapseBtn = document.getElementById('collapseAllBtn');
  if (expandBtn) expandBtn.addEventListener('click', expandAll);
  if (collapseBtn) collapseBtn.addEventListener('click', collapseAll);

  // Export hierarchy as JSON
  function hierarchyToPlain(d) {
    if (!d) return null;
    var kids = d.children || d._children;
    var out = { name: (d.data && d.data.name) || d.name || '' };
    if (d.data) {
      if (d.data.tooltip) out.tooltip = d.data.tooltip;
      if (d.data.node_color) out.node_color = d.data.node_color;
      if (d.data.node_size != null) out.node_size = d.data.node_size;
    }
    if (kids && kids.length) out.children = kids.map(hierarchyToPlain);
    return out;
  }
  var exportBtn = document.getElementById('exportButton');
  if (exportBtn) {
    exportBtn.addEventListener('click', function() {
      var inst = getTreeInstance();
      var payload = inst && inst.root ? hierarchyToPlain(inst.root) : null;
      if (!payload) { alert('Tree not ready yet.'); return; }
      var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'tree-export.json';
      document.body.appendChild(a);
      a.click();
      setTimeout(function() { URL.revokeObjectURL(a.href); a.remove(); }, 0);
    });
  }

  var fontSlider = document.getElementById('fontSizeSlider');
  var fontVal = document.getElementById('fontSizeVal');
  if (fontSlider) {
    fontSlider.addEventListener('input', function() {
      var v = +fontSlider.value;
      if (fontVal) fontVal.textContent = v;
      var inst = getTreeInstance();
      if (inst && inst.options) {
        inst.options.fontSize = v;
        if (inst.update && inst.root) inst.update(inst.root);
      }
    });
  }

  var linkSlider = document.getElementById('linkLengthSlider');
  var linkVal = document.getElementById('linkLengthVal');
  if (linkSlider) {
    linkSlider.addEventListener('input', function() {
      var v = +linkSlider.value;
      if (linkVal) linkVal.textContent = v + 'px';
      var inst = getTreeInstance();
      if (inst && inst.options) {
        inst.options.linkLength = v;
        inst.options.linkResponsive = false;
        if (inst.update && inst.root) inst.update(inst.root);
      }
    });
  }

  // Search: highlight matching node labels
  var searchInput = document.getElementById('searchInput');
  var searchResults = document.getElementById('searchResults');
  function clearSearchHits() {
    document.querySelectorAll('.search-hit').forEach(function(el) {
      el.classList.remove('search-hit');
    });
  }
  function collectNodeNames(d, out) {
    if (!d) return;
    var name = (d.data && (d.data.name || d.data.tooltip)) || '';
    if (name) out.push({ name: String(name), node: d });
    var kids = d.children || d._children || [];
    kids.forEach(function(c) { collectNodeNames(c, out); });
  }
  function renderSearchResults(q) {
    if (!searchResults) return;
    q = (q || '').trim().toLowerCase();
    clearSearchHits();
    if (!q) { searchResults.classList.remove('open'); searchResults.innerHTML = ''; return; }
    var inst = getTreeInstance();
    var names = [];
    if (inst && inst.root) collectNodeNames(inst.root, names);
    var hits = names.filter(function(n) { return n.name.toLowerCase().indexOf(q) >= 0; }).slice(0, 30);
    if (!hits.length) {
      searchResults.innerHTML = '<div class="search-item" style="opacity:0.6">No matches</div>';
      searchResults.classList.add('open');
      return;
    }
    searchResults.innerHTML = hits.map(function(h, i) {
      return '<div class="search-item" data-idx="' + i + '">' + h.name.replace(/</g, '&lt;') + '</div>';
    }).join('');
    searchResults.classList.add('open');
    searchResults.querySelectorAll('.search-item').forEach(function(el, i) {
      el.addEventListener('click', function() {
        var hit = hits[i];
        if (!hit) return;
        // Expand path to node
        var path = [];
        var cur = hit.node;
        while (cur) { path.unshift(cur); cur = cur.parent; }
        path.forEach(function(n) {
          if (n._children) { n.children = n._children; n._children = null; }
        });
        if (inst.update) inst.update(inst.root);
        clearSearchHits();
        // Highlight by matching text content
        document.querySelectorAll('.node').forEach(function(g) {
          var t = g.querySelector('text');
          if (t && t.textContent === hit.name) g.classList.add('search-hit');
        });
        searchResults.classList.remove('open');
        if (searchInput) searchInput.blur();
      });
    });
  }
  if (searchInput) {
    searchInput.addEventListener('input', function() { renderSearchResults(searchInput.value); });
    searchInput.addEventListener('focus', function() { if (searchInput.value.trim()) renderSearchResults(searchInput.value); });
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        searchResults.classList.remove('open');
        searchInput.blur();
        clearSearchHits();
      }
    });
  }
  document.addEventListener('click', function(e) {
    if (searchResults && searchInput && !searchResults.contains(e.target) && e.target !== searchInput) {
      searchResults.classList.remove('open');
    }
  });

  // After htmlwidgets renders, capture instance and sync link-length slider
  function tryBindInstance() {
    var el = document.getElementById('htmlwidget-treemap');
    if (!el || !window.HTMLWidgets) return false;
    // Prefer explicit export set by the widget
    if (window.__d3treeInstance) {
      var inst = window.__d3treeInstance;
      if (inst.options && inst.options.linkLength && linkSlider) {
        linkSlider.value = Math.max(20, Math.min(300, inst.options.linkLength));
        if (linkVal) linkVal.textContent = Math.round(inst.options.linkLength) + 'px';
      }
      return true;
    }
    return false;
  }
  // Poll briefly until widget sets __d3treeInstance
  var tries = 0;
  var timer = setInterval(function() {
    tries++;
    if (tryBindInstance() || tries > 40) clearInterval(timer);
  }, 100);
})();
</script>

</body>
</html>
