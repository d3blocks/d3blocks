<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ TITLE }}</title>
<script>{% include "d3.v6.min.js" %}</script>
{{ SUPPORT }}
<style>{% include "maps.css" %}</style>
</head>
<body class="{% if dark_mode == false or dark_mode == 'false' %}light {% endif %}{% if show_controls == false or show_controls == 'false' %}{% else %}has-controls{% endif %}">

{% if show_controls != false and show_controls != 'false' %}
<div class="top-panel" role="toolbar" aria-label="Top controls">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
      <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block">
    </a>
  <div class="top-panel-center">
    <div class="search-wrap top-search">
      <input class="search-input" id="searchInput" type="search" placeholder="Find a location…" autocomplete="off" spellcheck="false" />
      <div class="search-results" id="searchResults"></div>
    </div>
  </div>
  <div class="top-panel-right">
    <button class="button-switch" id="resetZoomBtn" type="button" title="Reset zoom">Reset</button>
    <button class="button-switch" id="themeBtn" type="button" title="{% if dark_mode == false or dark_mode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if dark_mode == false or dark_mode == 'false' %}☀{% else %}🌙{% endif %}</button>
  </div>
</div>

<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button id="exportDataButton" class="button-switch">Export Data</button>
    {{ SAVE_BUTTON_START }}
    <button id="saveButton" class="button-switch">Save</button>
    {{ SAVE_BUTTON_STOP }}
  </div>
</div>

<div class="stats-panel collapsed" id="displayPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Display<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="markerOpacitySlider">Marker opacity <span id="markerOpacityVal">0.40</span></label>
      <input type="range" id="markerOpacitySlider" min="0.05" max="1" step="0.05" value="0.40" />
    </div>
    <div class="physics-control">
      <label for="markerSizeSlider">Marker size <span id="markerSizeVal">1.0</span>×</label>
      <input type="range" id="markerSizeSlider" min="0.3" max="3" step="0.1" value="1.0" />
    </div>
    <div class="physics-control">
      <label for="landOpacitySlider">Land opacity <span id="landOpacityVal">—</span></label>
      <input type="range" id="landOpacitySlider" min="0.05" max="1" step="0.05" value="0.60" />
    </div>
    <div class="physics-control">
      <label for="borderWidthSlider">Border width <span id="borderWidthVal">—</span></label>
      <input type="range" id="borderWidthSlider" min="0" max="5" step="0.1" value="0.5" />
    </div>
    <label><input type="checkbox" id="showLegendChk" checked> Show size legend</label>
    <label><input type="checkbox" id="countryHoverChk" checked> Country hover (name + border)</label>
  </div>
</div>
{% endif %}

<div id="maps-container"><svg id="my_dataviz"></svg></div>
<div id="hint">scroll to zoom · drag to pan · hover a country or marker for details</div>

<script>
const chartConfig = {
  width: {{ WIDTH }},
  height: {{ HEIGHT }},
  showControls: {% if show_controls == false or show_controls == 'false' %}false{% else %}true{% endif %},
  darkMode: {% if dark_mode == false or dark_mode == 'false' %}false{% else %}true{% endif %}
};

const container = document.getElementById("maps-container");
const width = container.clientWidth || (typeof chartConfig.width === "number" ? chartConfig.width : window.innerWidth);
const height = container.clientHeight || (typeof chartConfig.height === "number" ? chartConfig.height : window.innerHeight);

const svg = d3.select("#my_dataviz")
  .attr("width", width)
  .attr("height", height);

const mapLayer = svg.append("g").attr("class", "map-layer");
const markerLayer = svg.append("g").attr("class", "marker-layer");
const legendG = svg.append("g").attr("id", "legendG");

const dataGeo = {% include "world.geojson" %};
const data = {{ json_data }};
const data_countries = {{ json_countries }};

let country_color = {};
let country_linewidth = {};
let country_opacity = {};
let country_line = {};
let country_stroke = {};

data_countries.forEach(item => {
  country_color[item.name] = item.color;
  country_line[item.name] = item.line;
  country_linewidth[item.name] = item.linewidth;
  country_opacity[item.name] = item.opacity;
  country_stroke[item.name] = item.stroke;
});

const worldOpacityDefault = country_opacity["World"] != null ? +country_opacity["World"] : 0.6;
const worldLinewidthDefault = country_linewidth["World"] != null ? +country_linewidth["World"] : 0.5;
let landOpacity = worldOpacityDefault;
let borderWidth = worldLinewidthDefault;
let markerOpacity = 0.4;
let markerSizeScale = 1.0;
let countryHoverEnabled = true;

// Base projection — zoom updates scale/translate (not an SVG group transform)
const baseScale = Math.min(width, height) / 5;
const baseTranslate = [width / 2, height / 2];

const projection = d3.geoMercator()
  .center([0, 20])
  .scale(baseScale)
  .translate(baseTranslate);

const pathGenerator = d3.geoPath().projection(projection);

function projectPoint(lon, lat) {
  const p = projection([+lon, +lat]);
  return p || [null, null];
}

function applyZoomTransform(t) {
  projection
    .scale(baseScale * t.k)
    .translate([baseTranslate[0] * t.k + t.x, baseTranslate[1] * t.k + t.y]);
  redrawMap();
}

function redrawMap() {
  if (typeof worldPaths !== "undefined") {
    worldPaths.attr("d", pathGenerator);
  }
  if (typeof customPaths !== "undefined") {
    customPaths.attr("d", pathGenerator);
  }
  if (typeof circles !== "undefined") {
    circles
      .attr("cx", d => projectPoint(d.lon, d.lat)[0])
      .attr("cy", d => projectPoint(d.lon, d.lat)[1]);
  }
}

const valueExtent = d3.extent(data, d => +d.size);
const sizeScale = d3.scaleSqrt()
  .domain(valueExtent[0] === valueExtent[1] ? [0, valueExtent[1] || 1] : valueExtent)
  .range([1, 50]);

function markerRadius(d) {
  return sizeScale(+d.size) * markerSizeScale;
}

const worldStrokeDefault = country_stroke["World"] || "#5A5A5A";
const highlightStroke = "var(--accent, #5b9bd5)";
function hoverBorderWidth() {
  return Math.max(borderWidth * 2.5, borderWidth + 1.5, 2);
}

// World base (all countries — hover targets)
const worldPaths = mapLayer.append("g")
  .attr("class", "world")
  .selectAll("path")
  .data(dataGeo.features)
  .join("path")
    .attr("class", "country-path")
    .attr("fill", country_color["World"] || "#D3D3D3")
    .attr("d", pathGenerator)
    .style("stroke", worldStrokeDefault)
    .style("stroke-width", borderWidth)
    .style("opacity", landOpacity)
    .style("stroke-dasharray", country_line["World"] === "dashed" ? "5" : "0")
    .style("cursor", "default");

// Highlighted countries (custom styling overlays)
const country_names = data_countries.map(item => item.name);
const countries = dataGeo.features.filter(d => country_names.includes(d.properties.name) && d.properties.name !== "World");

const customPaths = mapLayer.append("g")
  .attr("class", "countries")
  .selectAll("path")
  .data(countries)
  .join("path")
    .attr("class", "country-path")
    .attr("d", d => pathGenerator(d))
    .attr("fill", d => country_color[d.properties.name])
    .attr("stroke", d => country_stroke[d.properties.name])
    .attr("stroke-width", d => country_linewidth[d.properties.name])
    .attr("opacity", d => country_opacity[d.properties.name])
    .attr("stroke-dasharray", d => country_line[d.properties.name] === "dashed" ? "5" : "0")
    .style("cursor", "default");

// Zoom: update projection (paths/markers redraw in geographic space).
// Borders and marker radii stay in screen pixels — not scaled like a PNG.
const zoom = d3.zoom()
  .scaleExtent([0.5, 80])
  .on("zoom", (event) => applyZoomTransform(event.transform));
svg.call(zoom);

// Tooltip
const Tooltip = d3.select("body")
  .append("div")
  .attr("class", "tooltip");

function countryName(d) {
  return (d && d.properties && d.properties.name) ? d.properties.name : "";
}

function baseBorderWidth(name) {
  // Scale custom country borders relative to the World default when the slider moves
  if (name && country_linewidth[name] != null && name !== "World" && worldLinewidthDefault > 0) {
    return borderWidth * (+country_linewidth[name] / worldLinewidthDefault);
  }
  return borderWidth;
}

function restoreCountryStroke(sel) {
  sel.each(function (d) {
    const name = countryName(d);
    const isCustom = name && country_color[name] != null && name !== "World";
    d3.select(this)
      .style("stroke", isCustom ? (country_stroke[name] || worldStrokeDefault) : worldStrokeDefault)
      .style("stroke-width", baseBorderWidth(name))
      .classed("country-hover", false);
  });
}

function applyBorderWidth() {
  worldPaths.style("stroke-width", function (d) {
    return this.classList.contains("country-hover") ? hoverBorderWidth() : borderWidth;
  });
  customPaths.style("stroke-width", function (d) {
    const name = countryName(d);
    return this.classList.contains("country-hover") ? hoverBorderWidth() : baseBorderWidth(name);
  });
}

function countryMouseover(event, d) {
  if (!countryHoverEnabled) return;
  const name = countryName(d);
  if (!name) return;
  d3.select(this)
    .style("stroke", highlightStroke)
    .style("stroke-width", hoverBorderWidth())
    .classed("country-hover", true)
    .raise();
  Tooltip.style("opacity", 1);
}

function countryMousemove(event, d) {
  if (!countryHoverEnabled) return;
  const name = countryName(d);
  if (!name) return;
  Tooltip
    .html(name)
    .style("left", (event.pageX + 12) + "px")
    .style("top", (event.pageY + 12) + "px");
}

function countryMouseleave(event, d) {
  restoreCountryStroke(d3.select(this));
  // Only hide tooltip if not over a marker (marker handlers manage their own)
  if (!event.relatedTarget || !event.relatedTarget.classList || !event.relatedTarget.classList.contains("marker-circle")) {
    Tooltip.style("opacity", 0);
  }
}

worldPaths
  .on("mouseover", countryMouseover)
  .on("mousemove", countryMousemove)
  .on("mouseleave", countryMouseleave);

customPaths
  .on("mouseover", countryMouseover)
  .on("mousemove", countryMousemove)
  .on("mouseleave", countryMouseleave);

const mouseover = () => Tooltip.style("opacity", 1);
const mousemove = (event, d) => {
  Tooltip
    .html((d.label ? d.label + "<br>" : "") + "lon: " + d.lon + "<br>lat: " + d.lat + (d.size != null ? "<br>size: " + d.size : ""))
    .style("left", (event.pageX + 12) + "px")
    .style("top", (event.pageY + 12) + "px");
};
const mouseleave = () => Tooltip.style("opacity", 0);

// Markers (radius is screen pixels; position follows projection on zoom)
const circles = markerLayer
  .selectAll("circle")
  .data(data.slice().sort((a, b) => +b.size - +a.size))
  .join("circle")
    .attr("class", "marker-circle")
    .attr("cx", d => projectPoint(d.lon, d.lat)[0])
    .attr("cy", d => projectPoint(d.lon, d.lat)[1])
    .attr("r", d => markerRadius(d))
    .style("fill", d => d.color)
    .attr("stroke", d => (+d.size > 2000 ? "var(--text)" : "none"))
    .attr("stroke-width", 1)
    .attr("fill-opacity", markerOpacity)
    .style("cursor", "pointer")
    .on("mouseover", mouseover)
    .on("mousemove", mousemove)
    .on("mouseleave", mouseleave);

function drawLegend() {
  legendG.selectAll("*").remove();
  const show = document.getElementById("showLegendChk");
  if (show && !show.checked) return;
  if (!data.length) return;

  const nExtent = d3.extent(data, d => +d.size);
  const nMean = d3.mean(data, d => +d.size);
  const valuesToShow = [nExtent[0], nMean, nExtent[1]].filter(v => v != null && !isNaN(v));
  const xCircle = 40;
  const xLabel = 90;
  const baseY = height - 40;

  legendG.selectAll("legend-circle")
    .data(valuesToShow)
    .join("circle")
      .attr("class", "legend-stroke")
      .attr("cx", xCircle)
      .attr("cy", baseY)
      .attr("r", d => markerRadius({ size: d }))
      .style("fill", "none")
      .attr("stroke", "currentColor")
      .style("color", "var(--text)");

  legendG.selectAll("legend-line")
    .data(valuesToShow)
    .join("line")
      .attr("class", "legend-stroke")
      .attr("x1", d => xCircle + markerRadius({ size: d }))
      .attr("x2", xLabel)
      .attr("y1", d => baseY + markerRadius({ size: d }))
      .attr("y2", d => baseY + markerRadius({ size: d }))
      .attr("stroke", "currentColor")
      .style("color", "var(--text)")
      .style("stroke-dasharray", "2,2");

  legendG.selectAll("legend-text")
    .data(valuesToShow)
    .join("text")
      .attr("class", "legend-label")
      .attr("x", xLabel)
      .attr("y", d => baseY + markerRadius({ size: d }))
      .text(d => (+d).toFixed(1))
      .attr("alignment-baseline", "middle");
}
drawLegend();

// —— Controls ————————————————————————————————————————————————
const themeBtn = document.getElementById("themeBtn");
if (themeBtn) {
  themeBtn.addEventListener("click", () => {
    document.body.classList.toggle("light");
    const isLight = document.body.classList.contains("light");
    themeBtn.textContent = isLight ? "☀" : "🌙";
    themeBtn.title = isLight ? "Theme: Light" : "Theme: Dark";
  });
}

const resetBtn = document.getElementById("resetZoomBtn");
if (resetBtn) {
  resetBtn.addEventListener("click", () => {
    svg.transition().duration(400).call(zoom.transform, d3.zoomIdentity);
  });
}
// Identity transform → base projection (also runs once so state is consistent)
applyZoomTransform(d3.zoomIdentity);

const moSlider = document.getElementById("markerOpacitySlider");
if (moSlider) {
  document.getElementById("markerOpacityVal").textContent = (+moSlider.value).toFixed(2);
  moSlider.addEventListener("input", function () {
    markerOpacity = +this.value;
    document.getElementById("markerOpacityVal").textContent = markerOpacity.toFixed(2);
    circles.attr("fill-opacity", markerOpacity);
  });
}

const msSlider = document.getElementById("markerSizeSlider");
if (msSlider) {
  document.getElementById("markerSizeVal").textContent = (+msSlider.value).toFixed(1);
  msSlider.addEventListener("input", function () {
    markerSizeScale = +this.value;
    document.getElementById("markerSizeVal").textContent = markerSizeScale.toFixed(1);
    circles.attr("r", d => markerRadius(d));
    drawLegend();
  });
}

const loSlider = document.getElementById("landOpacitySlider");
if (loSlider) {
  loSlider.value = landOpacity;
  document.getElementById("landOpacityVal").textContent = landOpacity.toFixed(2);
  loSlider.addEventListener("input", function () {
    landOpacity = +this.value;
    document.getElementById("landOpacityVal").textContent = landOpacity.toFixed(2);
    mapLayer.select(".world").selectAll("path").style("opacity", landOpacity);
  });
}

const bwSlider = document.getElementById("borderWidthSlider");
if (bwSlider) {
  bwSlider.value = borderWidth;
  document.getElementById("borderWidthVal").textContent = borderWidth.toFixed(1);
  bwSlider.addEventListener("input", function () {
    borderWidth = +this.value;
    document.getElementById("borderWidthVal").textContent = borderWidth.toFixed(1);
    applyBorderWidth();
  });
}

const legendChk = document.getElementById("showLegendChk");
if (legendChk) {
  legendChk.addEventListener("change", drawLegend);
}

const countryHoverChk = document.getElementById("countryHoverChk");
if (countryHoverChk) {
  countryHoverEnabled = countryHoverChk.checked;
  countryHoverChk.addEventListener("change", function () {
    countryHoverEnabled = this.checked;
    if (!countryHoverEnabled) {
      restoreCountryStroke(worldPaths);
      restoreCountryStroke(customPaths);
      Tooltip.style("opacity", 0);
    }
    const cursor = countryHoverEnabled ? "pointer" : "default";
    worldPaths.style("cursor", cursor);
    customPaths.style("cursor", cursor);
  });
  if (countryHoverEnabled) {
    worldPaths.style("cursor", "pointer");
    customPaths.style("cursor", "pointer");
  }
}

// Search markers by label
const searchInput = document.getElementById("searchInput");
const searchResults = document.getElementById("searchResults");
if (searchInput && searchResults) {
  const labeled = data.filter(d => d.label);
  searchInput.addEventListener("input", function () {
    const q = this.value.trim().toLowerCase();
    searchResults.innerHTML = "";
    if (!q) { searchResults.classList.remove("open"); return; }
    const matches = labeled.filter(d => String(d.label).toLowerCase().includes(q)).slice(0, 12);
    if (!matches.length) { searchResults.classList.remove("open"); return; }
    matches.forEach(d => {
      const item = document.createElement("div");
      item.className = "search-item";
      item.textContent = d.label;
      item.addEventListener("mousedown", e => {
        e.preventDefault();
        searchInput.value = d.label;
        searchResults.classList.remove("open");
        focusMarker(d);
      });
      searchResults.appendChild(item);
    });
    searchResults.classList.add("open");
  });
  searchInput.addEventListener("blur", () => {
    setTimeout(() => searchResults.classList.remove("open"), 150);
  });
}

function focusMarker(d) {
  // Project at base (k=1) so the zoom transform math matches applyZoomTransform
  const baseProj = d3.geoMercator()
    .center([0, 20])
    .scale(baseScale)
    .translate(baseTranslate);
  const p = baseProj([+d.lon, +d.lat]);
  if (!p) return;
  const k = 8;
  const t = d3.zoomIdentity
    .translate(width / 2 - k * p[0], height / 2 - k * p[1])
    .scale(k);
  svg.transition().duration(600).call(zoom.transform, t);
  circles
    .attr("stroke", c => (c === d ? "var(--accent)" : (+c.size > 2000 ? "var(--text)" : "none")))
    .attr("stroke-width", c => (c === d ? 3 : 1));
  setTimeout(() => {
    circles
      .attr("stroke", c => (+c.size > 2000 ? "var(--text)" : "none"))
      .attr("stroke-width", 1);
  }, 2000);
}

// Export data
const exportBtn = document.getElementById("exportDataButton");
if (exportBtn) {
  exportBtn.addEventListener("click", () => {
    try {
      const payload = { markers: data, countries: data_countries };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: "application/json" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "{{ TITLE|replace(' ', '_') }}_data.json";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      console.error(err);
      alert("Failed to export data.");
    }
  });
}

// Side panel chrome (collapse / drag reorder / stack under top bar)
function positionSidePanels() {
  const panels = Array.prototype.slice.call(document.querySelectorAll(".stats-panel"));
  const topPanel = document.querySelector(".top-panel");
  let y = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
  panels.forEach(panel => {
    panel.style.top = y + "px";
    panel.style.left = "10px";
    panel.style.maxHeight = "calc(100vh - " + Math.round(y + 10) + "px)";
    y += panel.getBoundingClientRect().height + 8;
  });
}
window.addEventListener("DOMContentLoaded", positionSidePanels);
window.addEventListener("resize", positionSidePanels);
if (window.ResizeObserver) {
  const o = new ResizeObserver(positionSidePanels);
  document.querySelectorAll(".stats-panel").forEach(p => o.observe(p));
  document.querySelectorAll(".top-panel").forEach(p => o.observe(p));
}
document.querySelectorAll(".stats-panel-title").forEach(title => {
  title.addEventListener("click", () => {
    if (title.dataset.justDragged === "1") { title.dataset.justDragged = "0"; return; }
    title.parentElement.classList.toggle("collapsed");
    positionSidePanels();
  });
});
(function setupPanelReordering() {
  document.querySelectorAll(".stats-panel").forEach(panel => {
    const title = panel.querySelector(".stats-panel-title");
    if (!title) return;
    title.addEventListener("dragstart", e => {
      e.dataTransfer.setData("text/plain", panel.id);
      e.dataTransfer.effectAllowed = "move";
    });
    title.addEventListener("dragend", () => {
      title.dataset.justDragged = "1";
      setTimeout(() => { title.dataset.justDragged = "0"; }, 0);
    });
    panel.addEventListener("dragover", e => {
      e.preventDefault();
      e.dataTransfer.dropEffect = "move";
      panel.classList.add("drag-over");
    });
    panel.addEventListener("dragleave", () => panel.classList.remove("drag-over"));
    panel.addEventListener("drop", e => {
      e.preventDefault();
      panel.classList.remove("drag-over");
      const draggedId = e.dataTransfer.getData("text/plain");
      if (!draggedId || draggedId === panel.id) return;
      const draggedEl = document.getElementById(draggedId);
      if (!draggedEl || !panel.parentNode) return;
      panel.parentNode.insertBefore(draggedEl, panel);
      positionSidePanels();
    });
  });
})();
requestAnimationFrame(positionSidePanels);

{{ SAVE_TO_SVG_SCRIPT }}
</script>
</body>
</html>
