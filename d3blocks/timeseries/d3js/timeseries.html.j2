<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ TITLE }}</title>
{{ SUPPORT }}
<style>{% include "timeseries.css" %}</style>
<!-- Center + top panel + side panels: per-theme backgrounds.
     Theme toggle (body.light) switches which color is used. -->
<style>
  body { background: {{ COLOR_BACKGROUND_DARK }}; }
  body .top-panel { background: {{ COLOR_BACKGROUND_DARK }}; }
  body .stats-panel { background: {{ COLOR_BACKGROUND_DARK }}; }
  body.light { background: {{ COLOR_BACKGROUND_LIGHT }}; }
  body.light .top-panel { background: {{ COLOR_BACKGROUND_LIGHT }}; }
  body.light .stats-panel { background: {{ COLOR_BACKGROUND_LIGHT }}; }
</style>
</head>
<body class="{% if darkMode == 'false' %}light {% endif %}{% if showTopPanel == 'true' %}has-top-panel{% endif %}">

{% if showTopPanel == 'true' %}
<div class="top-panel" role="toolbar" aria-label="Top controls">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
      <img src="{{ LOGO_BASE64 }}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
  </div>
  <div class="top-panel-center"></div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button" title="{% if darkMode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if darkMode == 'false' %}☀{% else %}🌙{% endif %}</button>
  </div>
</div>
{% endif %}

{% if showSidePanel == 'true' %}
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button class="button-switch" id="exportDataBtn" type="button" title="Export series data as CSV" style="width:100%;margin:0 0 8px 0">Export</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch" style="width:100%;margin:0 0 4px 0">Save</button>{{ SAVE_BUTTON_STOP }}
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads the data as CSV. Save downloads the current view as SVG.</div>
  </div>
</div>

<div class="stats-panel collapsed" id="filteringPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Filtering<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="filter-actions">
      <button class="button-switch" id="filterAllBtn" type="button">All</button>
      <button class="button-switch" id="filterNoneBtn" type="button">None</button>
    </div>
    <div id="filterList"></div>
    <button class="button-switch" id="resetZoomBtn" type="button" style="width:100%;margin:10px 0 4px 0">Reset zoom</button>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Toggle series visibility. Scroll wheel zooms · brush selects range · double-click resets.</div>
  </div>
</div>

<div class="stats-panel collapsed" id="appearancePanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Appearance<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="fontSizeSlider">Font size <span class="val" id="fontSizeVal">{{ FONTSIZE }}</span></label>
      <input type="range" id="fontSizeSlider" min="8" max="24" step="1" value="{{ FONTSIZE }}">
    </div>
    <div class="physics-control">
      <label for="strokeWidthSlider">Line width <span class="val" id="strokeWidthVal">1.5</span></label>
      <input type="range" id="strokeWidthSlider" min="0.5" max="5" step="0.1" value="1.5">
    </div>
    <div style="font-weight:600;margin:8px 0 4px 0;font-size:12px">Interpolation</div>
    <div class="mode-row">
      <label><input type="radio" name="interp" value="basis" checked> Basis</label>
      <label><input type="radio" name="interp" value="linear"> Linear</label>
      <label><input type="radio" name="interp" value="step"> Step</label>
    </div>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Adjust label size, stroke width and line interpolation.</div>
  </div>
</div>

{% endif %}

<div id="ts-tooltip"></div>
<div id="timeseries-main">
  <div id="timeseries-container"></div>
  <div id="timeseries-hint" style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-size:11px;color:var(--text-muted);pointer-events:none;white-space:nowrap">Scroll to zoom · brush bottom to select range · Filtering panel to toggle series · double-click to reset</div>
</div>

<script>
{% include "d3.v3.js" %}
{% include "timeseries.js" %}

    var data = {{ json_data }}
    let timeseriesChart = null;

{{ SAVE_TO_SVG_SCRIPT }}

    window.addEventListener('DOMContentLoaded', function () {
      // ── Build chart ──────────────────────────────────────────────────────
      timeseriesChart = timeseries(data, {
          COLOR: [{{ COLOR }}],
          TITLE: "{{ TITLE }}",
          DT_FORMAT: "{{ DT_FORMAT }}",
          WIDTH: {{ WIDTH }},
          HEIGHT: {{ HEIGHT }},
          FONTSIZE: {{ FONTSIZE }}
      });

      // ── Appearance controls ──────────────────────────────────────────────
      var fontSlider = document.getElementById("fontSizeSlider");
      var fontVal    = document.getElementById("fontSizeVal");
      if (fontSlider) {
        fontSlider.addEventListener("input", function() {
          if (fontVal) fontVal.textContent = fontSlider.value;
          if (timeseriesChart) timeseriesChart.setFontSize(+fontSlider.value);
        });
      }
      var strokeSlider = document.getElementById("strokeWidthSlider");
      var strokeVal    = document.getElementById("strokeWidthVal");
      if (strokeSlider) {
        strokeSlider.addEventListener("input", function() {
          if (strokeVal) strokeVal.textContent = (+strokeSlider.value).toFixed(1);
          if (timeseriesChart) timeseriesChart.setStrokeWidth(+strokeSlider.value);
        });
      }
      document.querySelectorAll('input[name="interp"]').forEach(function(el) {
        el.addEventListener("change", function() {
          if (timeseriesChart) timeseriesChart.setInterpolation(this.value);
        });
      });

      // ── Filtering / zoom controls ────────────────────────────────────────
      var resetBtn = document.getElementById("resetZoomBtn");
      if (resetBtn) {
        resetBtn.addEventListener("click", function() {
          if (timeseriesChart) timeseriesChart.resetZoom();
        });
      }
      var exportDataBtn = document.getElementById("exportDataBtn");
      if (exportDataBtn) {
        exportDataBtn.addEventListener("click", function() {
          if (timeseriesChart) timeseriesChart.exportData();
        });
      }
      var filterAllBtn = document.getElementById("filterAllBtn");
      if (filterAllBtn) {
        filterAllBtn.addEventListener("click", function() {
          if (timeseriesChart) timeseriesChart.setAllVisible(true);
        });
      }
      var filterNoneBtn = document.getElementById("filterNoneBtn");
      if (filterNoneBtn) {
        filterNoneBtn.addEventListener("click", function() {
          if (timeseriesChart) timeseriesChart.setAllVisible(false);
        });
      }

    (function() {
      var PANEL_ORDER = ['exportPanel', 'filteringPanel', 'appearancePanel'];

      function positionSidePanels() {
        var bar = document.querySelector('.top-panel');
        var main = document.getElementById('timeseries-main');
        // Missing top bar → height 0 (do not return early). Side panels stack under the bar.
        var bottom = bar ? bar.getBoundingClientRect().bottom : 0;
        if (main) {
          main.style.top = bottom + 'px';
          main.style.marginTop = '0px';
        }
        var y = bottom + 8;
        var bottomPad = 12;
        var sideRight = 0;
        PANEL_ORDER.forEach(function(id) {
          var panel = document.getElementById(id);
          if (!panel || panel.style.display === 'none') return;
          panel.style.top = y + 'px';
          panel.style.maxHeight = Math.max(80, window.innerHeight - y - bottomPad) + 'px';
          var rect = panel.getBoundingClientRect();
          sideRight = Math.max(sideRight, rect.right);
          y += rect.height + 10;
        });
        if (main) {
          main.style.paddingLeft = sideRight > 0 ? (sideRight + 12) + 'px' : '12px';
        }
        if (timeseriesChart && timeseriesChart.resize) timeseriesChart.resize();
      }
      window.addEventListener('resize', positionSidePanels);
      window.addEventListener('load', positionSidePanels);
      positionSidePanels();
      requestAnimationFrame(positionSidePanels);
      if (typeof ResizeObserver !== 'undefined') {
        var bar = document.querySelector('.top-panel');
        if (bar) new ResizeObserver(function() { positionSidePanels(); }).observe(bar);
        PANEL_ORDER.forEach(function(id) {
          var el = document.getElementById(id);
          if (!el) return;
          new ResizeObserver(function() { positionSidePanels(); }).observe(el);
        });
      }

      PANEL_ORDER.forEach(function(panelId) {
        var panel = document.getElementById(panelId);
        if (!panel) return;
        var title = panel.querySelector('.stats-panel-title');
        if (!title) return;
        // Track pointer movement so a real drag does not also toggle collapse.
        var downX = 0, downY = 0;
        title.addEventListener('mousedown', function(e) {
          downX = e.clientX; downY = e.clientY;
          title.dataset.justDragged = '0';
        });
        title.addEventListener('click', function(e) {
          if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
          if (Math.abs(e.clientX - downX) > 5 || Math.abs(e.clientY - downY) > 5) return;
          // Currently collapsed → about to expand: restore saved height if any.
          // Currently expanded  → about to collapse: save height and clear inline style.
          var isCollapsed = panel.classList.contains('collapsed');
          if (!isCollapsed) {
            // About to collapse: save any user-resized height.
            if (panel.style.height) panel.dataset.expandedHeight = panel.style.height;
            panel.style.height = '';
          } else if (panel.dataset.expandedHeight) {
            // About to expand: restore previously saved height.
            panel.style.height = panel.dataset.expandedHeight;
          }
          panel.classList.toggle('collapsed');
          setTimeout(positionSidePanels, 0);
        });
      });

      (function setupPanelReordering() {
        PANEL_ORDER.forEach(function(panelId) {
          var panel = document.getElementById(panelId);
          if (!panel) return;
          var title = panel.querySelector('.stats-panel-title');
          if (!title) return;
          title.addEventListener('dragstart', function(e) {
            e.dataTransfer.setData('text/plain', panelId);
            e.dataTransfer.effectAllowed = 'move';
          });
          title.addEventListener('dragend', function() {
            title.dataset.justDragged = '1';
            setTimeout(function() { title.dataset.justDragged = '0'; }, 0);
          });
          panel.addEventListener('dragover', function(e) {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            panel.classList.add('drag-over');
          });
          panel.addEventListener('dragleave', function() { panel.classList.remove('drag-over'); });
          panel.addEventListener('drop', function(e) {
            e.preventDefault();
            panel.classList.remove('drag-over');
            var draggedId = e.dataTransfer.getData('text/plain');
            if (!draggedId || draggedId === panelId) return;
            var from = PANEL_ORDER.indexOf(draggedId), to = PANEL_ORDER.indexOf(panelId);
            if (from < 0 || to < 0) return;
            PANEL_ORDER.splice(from, 1);
            PANEL_ORDER.splice(to, 0, draggedId);
            positionSidePanels();
          });
        });
      })();

      function toggleTheme() {
        document.body.classList.toggle('light');
        var isLight = document.body.classList.contains('light');
        var themeBtn = document.getElementById('themeBtn');
        if (themeBtn) {
          themeBtn.textContent = isLight ? '☀' : '🌙';
          themeBtn.title = isLight ? 'Theme: Light' : 'Theme: Dark';
        }
        if (timeseriesChart && timeseriesChart.setDarkMode) timeseriesChart.setDarkMode(!isLight);
      }
      var themeBtn = document.getElementById('themeBtn');
      if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
    })();

    }); // end DOMContentLoaded
</script>
</body>
</html>
