<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ TITLE }}</title>

{{ SUPPORT }}

<style>
{% include "movingbubbles.css" %}
body { font-size: {{ FONTSIZE }}; }
.node { stroke-width: 1.5px; }
</style>
</head>

<body{% if darkMode == 'false' %} class="light"{% endif %}>
{% if showControls == 'true' %}

<div class="top-panel" role="toolbar" aria-label="Top controls">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
        <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
  </div>
  <div class="top-panel-center top-speed">
    <span class="top-speed-caption">Speed</span>
    <span id="speedLabel" class="top-speed-label">Medium</span>
    <input type="range" id="speedSlider" min="0" max="100" step="1" value="50" title="Playback speed: left = stop, right = super fast">
    <button class="button-switch top-reset-btn" id="resetSimBtn" type="button" title="Restart the simulation from the beginning">Reset</button>
  </div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button" title="{% if darkMode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if darkMode == 'false' %}☀{% else %}🌙{% endif %}</button>
  </div>
</div>

{{ SAVE_BUTTON_START }}
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button id="exportButton" class="button-switch" style="width:100%;box-sizing:border-box;margin-bottom:8px">Export</button>
    <button id="saveButton" class="button-switch" style="width:100%;box-sizing:border-box">Save</button>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads the current state (position, activity, color) of every bubble as JSON.</div>
  </div>
</div>
{{ SAVE_BUTTON_STOP }}

<!-- Layout: Size / Color / Shape / Label from df columns (scatter-style) -->
<div class="stats-panel collapsed" id="displayPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="slider-row">
      <label for="layoutSizeSelect">Size</label>
      <select id="layoutSizeSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
    </div>
    <div class="slider-row">
      <label for="layoutColorSelect">Color</label>
      <select id="layoutColorSelect" style="width:100%;box-sizing:border-box;margin-top:4px"><option value="">Default</option></select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Numeric → continuous scale; categorical → discrete colors</div>
    </div>
    <div class="slider-row">
      <label for="layoutShapeSelect">Shape</label>
      <select id="layoutShapeSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="circle">Default</option>
      </select>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Map a categorical variable to shapes</div>
    </div>
    <div class="slider-row">
      <label for="layoutLabelSelect">Label</label>
      <select id="layoutLabelSelect" style="width:100%;box-sizing:border-box;margin-top:4px">
        <option value="">None</option>
      </select>
    </div>
    <button class="button-switch" id="layoutResetBtn" type="button" style="width:100%;margin-top:8px;box-sizing:border-box">Reset to Default</button>
  </div>
</div>

<!-- Physics: size multiplier + movement tracker -->
<div class="stats-panel collapsed" id="physicsPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Physics<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div class="slider-row">
      <label for="sizeMultiplierSlider">Size multiplier <span class="val" id="sizeMultiplierVal">1.0×</span></label>
      <input type="range" id="sizeMultiplierSlider" min="-1" max="1" step="0.01" value="0">
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Scales all bubble radii (0.25× – 4×)</div>
    </div>
    <div class="slider-row" style="margin-top:12px">
      <label for="trackerEnabled" style="display:flex;align-items:center;gap:8px;cursor:pointer">
        <input type="checkbox" id="trackerEnabled" checked style="accent-color:var(--accent);cursor:pointer">
        Enable tracker
      </label>
      <div style="font-size:11px;opacity:0.6;margin-top:4px">Draw a trail while a bubble is selected. Trails stay after deselect.</div>
    </div>
    <button class="button-switch" id="clearTrailsBtn" type="button" style="width:100%;margin-top:8px;box-sizing:border-box">Clear trails</button>
  </div>
</div>

<!-- Variables: numeric vs category (drives Layout Size / Color / Shape options) -->
<div class="stats-panel collapsed" id="varsPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Variables<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <div style="font-size:11px;opacity:0.6;margin-bottom:8px">Set each variable to Numeric or Category. Uncheck to hide it from Layout.</div>
    <div id="varList"><div style="opacity:0.5;font-size:12px">No variables found.</div></div>
  </div>
</div>

<!-- Filtering: was "Filter by date:" -->
<div class="stats-panel collapsed" id="filterPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Filtering<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label style="display:block;margin-bottom:4px">Filter by date</label>
    <div id="date-filter">
        <input type="date" id="dateFilterStart" value="{{ DATE_MIN }}" min="{{ DATE_MIN }}" max="{{ DATE_MAX }}">
        <span>&ndash;</span>
        <input type="date" id="dateFilterEnd" value="{{ DATE_MAX }}" min="{{ DATE_MIN }}" max="{{ DATE_MAX }}">
        <br><br>
        <button id="applyDateFilter" class="togglebutton" style="width:auto; float:none; display:inline-block; padding:3px 8px;">Apply</button>
        <button id="resetDateFilter" class="togglebutton" style="width:auto; float:none; display:inline-block; padding:3px 8px;">Reset</button>
        <div id="dateFilterCount" style="margin-top:6px; font-size:12px;"></div>
    </div>
  </div>
</div>

{% endif %}

<div id="noteWrap">
    <div id="note"></div>
    <div id="cite">
        {{ NOTE }}
    </div>
</div>

<!-- Clock lives in its own reserved strip above the chart so the SVG
     never draws underneath it. #chartStage is the exclusive area for
     the visualization; the clock sits in #chartHeader above that stage. -->
<div id="chartHeader">
    <div id="current_day">&nbsp;</div>
    <div id="current_time">{{ START_TIME }}</div>
</div>

<div id="chartStage">
    <div id="main-wrapper">
        <div id="chart"></div>
    </div>
</div>


<script>

    {% include "d3-3-5-5.min.js" %}

var USER_SPEED = "slow";
var IS_PAUSED = false;
var timer_handle = null;
// —— Continuous playback speed. Slider is 0-100: 0 = stop, 100 = superfast.
// Delays come from the Python `speed` dict (injected as `speeds`):
//   slow      → max delay (left, just after stop)
//   superfast → min delay (right end of the slider)
// medium/fast shape the label thresholds only.
var speeds = {{ SPEED }};
var SPEED_MAX_DELAY = (speeds && speeds.slow != null) ? +speeds.slow : 1000;
var SPEED_MIN_DELAY = (speeds && speeds.superfast != null) ? +speeds.superfast
                    : (speeds && speeds.fast != null) ? +speeds.fast : 20;
var currentDelay = SPEED_MAX_DELAY - (SPEED_MAX_DELAY - SPEED_MIN_DELAY) * 0.5;

var width = {{ WIDTH }},
    height = {{ HEIGHT }},
	padding = 1,
	maxRadius = 3;
	// color = d3.scale.category10();
	
var sched_objs = [],
	curr_minute = 0;

// STATE PROPERTIES
var act_codes = {{ ACT_CODES }};
var act_counts = {{ ACT_COUNTS }};
var time_notes = {{ TIME_NOTES }};
var notes_index = 0;
var colorByActivity = {{ COLORBYACTIVITY }} // array of the colors per state

// NODE PROPERTIES
var node_size = {{ NODE_SIZE }}; //array of radius values, one for each node
var node_color = {{ NODE_COLOR }}; //array of color values, one for each node
var node_props = {{ NODE_PROPS }}; // per-sample property bags from df columns (Layout panel)
var PROP_KEYS = {{ PROP_KEYS }};   // ordered list of all selectable variables
var STATE_COL = {{ STATE_COL }};   // name of the state column (live-updated)
var SAMPLE_ID_COL = {{ SAMPLE_ID_COL }};
var color_method = "{{ COLOR_METHOD }}"; //Nodes can be colored based on "STATE" or "NODE"
// Layout-panel overrides (null = use defaults / color_method)
var layoutSizeKey = null;
var layoutColorKey = null;
var layoutColorScale = null; // function(value) -> color, when layoutColorKey is set
var currentShapeMode = "circle"; // circle|square|triangle|diamond
var categoricalShapeMap = null;
var categoricalShapeKey = null;
var currentLabelKey = null;
var sizeMultiplier = 1;
// act index -> state description (for live state color/label)
var actIndexToDesc = {};
act_codes.forEach(function(c) { actIndexToDesc[String(c.index)] = c.desc; });

// DATE FILTER. node_start_date[i] is the "YYYY-MM-DD" date of the first event
// for the i-th node/sample, aligned with node_size/node_color by index.
var node_start_date = {{ NODE_START_DATE }};
var DATE_MIN = "{{ DATE_MIN }}";
var DATE_MAX = "{{ DATE_MAX }}";

// DATA. The nodes are comma seperated and within each node, the pattern is: ["sample_id 1, time_in_state 1, ..", "sample_id 2, time_in_state 1, ..", ..]
data = {{ json_data }}

// color_method selection changes. Listen if changes are made (onchange=link_color_changed())
function link_color_changed(linkColor_value) {
    console.log(linkColor_value)
    color_method = linkColor_value
}


var center_act = {{ CENTER }},
	// Anchor layout to the SVG center so larger figsize keeps clusters
	// centered instead of pinned to the old 380x365 coordinates.
	center_pt = { "x": width / 2, "y": height / 2 };
var fociRadius = Math.min(width, height) * 0.32;
var labelRadius = Math.min(width, height) * 0.435;

var theta = 2 * Math.PI / (center_act ? (act_codes.length - 1) : act_codes.length );

// Coordinates for activities
var foci = {};
act_codes.forEach(function(code, i) {
	if (code.desc == center_act) {
		foci[code.index] = center_pt;
	} else {
		foci[code.index] = {
			x: fociRadius * Math.cos(i * theta) + center_pt.x,
			y: fociRadius * Math.sin(i * theta) + center_pt.y
		};
	}
});


// Start the SVG. Zoom/pan is visual-only (transform on a root group) so the
// force layout keeps working in the original coordinate system.
var svg = d3.select("#chart").append("svg")
    .attr("width", width)
    .attr("height", height)
    .style("cursor", "grab");

// Transparent hit-area so wheel/drag works over empty chart space too.
svg.append("rect")
	.attr("class", "zoom-capture")
	.attr("width", width)
	.attr("height", height)
	.style("fill", "transparent")
	.style("pointer-events", "all");

var chartRoot = svg.append("g").attr("class", "chart-root");
// Tracks whether the last pointer gesture was a pan/zoom (so a trailing
// click on empty space does not clear the bubble selection).
var zoomDragged = false;
var selectedNodes = []; // multi-select: list of node data objects

var zoomBehavior = d3.behavior.zoom()
	.scaleExtent([0.3, 8])
	.on("zoom", function() {
		zoomDragged = true;
		chartRoot.attr("transform",
			"translate(" + d3.event.translate + ")scale(" + d3.event.scale + ")");
	});

svg.call(zoomBehavior);
// Disable the default double-click zoom-in; we use double-click to reset.
svg.on("dblclick.zoom", null);
svg.on("dblclick", function() {
	zoomBehavior.scale(1);
	zoomBehavior.translate([0, 0]);
	chartRoot.transition().duration(300)
		.attr("transform", "translate(0,0)scale(1)");
});
svg.on("mousedown", function() {
	zoomDragged = false;
	svg.style("cursor", "grabbing");
});
svg.on("mouseup", function() { svg.style("cursor", "grab"); });
// Click empty chart space clears all selected bubble highlights (keeps trails)
svg.on("click", function() {
	if (zoomDragged) return;
	if (selectedNodes.length) {
		selectedNodes = [];
		finalizeAllActiveTrails();
		styleSelection();
	}
});


data.forEach(function(d) {
	var day_array = d.split(",");
	var activities = [];
	for (var i=0; i < day_array.length; i++) {
		// Duration
		if (i % 2 == 1) {
			activities.push({'act': day_array[i-1], 'duration': +day_array[i]});
		}
	}
	sched_objs.push(activities);
});


// A node for each person's schedule
var nodes = sched_objs.map(function(o, i) {
	var act = o[0].act;
	act_counts[act] += 1;
	var init_x = foci[act].x + Math.random();
	var init_y = foci[act].y + Math.random();
	return {
		act: act,
		x: init_x,
		y: init_y,
		radius: node_size[i], //use the i-th value from the node_size array to set the radius of the i-th node
        color: (color_method === "STATE" ? color(act) : node_color[i]),
		moves: 0,
		next_move_time: o[0].duration,
		sched: o,
		props: (node_props && node_props[i]) ? node_props[i] : {},
		shape: "circle",
	}
});

// Remember each node's original radius so the Layout panel's size
// multiplier / size-by-variable can scale it non-destructively.
var baseNodeRadii = nodes.map(function(n) { return n.radius; });

var force = d3.layout.force()
	.nodes(nodes)
	.size([width, height])
	// .links([])
	.gravity(0)
	.charge(0)
	.friction(.9)
	.on("tick", tick)
	.start();

var circleOpacity = {{ OPACITY }};
var circleStroke = "{{ STROKE }}";

// Path-based shapes so Size/Shape Layout controls can change geometry
// without swapping element types. Collision still uses d.radius.
function shapePath(shape, r) {
	if (shape === "square") {
		var s = r * 1.6;
		return "M" + (-s/2) + "," + (-s/2) + "h" + s + "v" + s + "h" + (-s) + "Z";
	}
	if (shape === "triangle") {
		var h = r * 1.9;
		return "M0," + (-h) + "L" + (-h*0.866) + "," + (h*0.5) + "L" + (h*0.866) + "," + (h*0.5) + "Z";
	}
	if (shape === "diamond") {
		var q = r * 1.4;
		return "M0," + (-q) + "L" + (q*0.75) + ",0L0," + q + "L" + (-q*0.75) + ",0Z";
	}
	// circle (default)
	var c = r;
	return "M" + (-c) + ",0A" + c + "," + c + " 0 1,0 " + c + ",0A" + c + "," + c + " 0 1,0 " + (-c) + ",0Z";
}
function shapeForNode(d) {
	if (categoricalShapeMap && d.props && categoricalShapeKey && d.props[categoricalShapeKey] != null) {
		var mapped = categoricalShapeMap[d.props[categoricalShapeKey]];
		if (mapped) return mapped;
	}
	return currentShapeMode || "circle";
}

// Trail layer sits under bubbles so paths don't cover the selection stroke.
var trailLayer = chartRoot.append("g").attr("class", "trail-layer");
var trackerEnabled = true;
var trails = [];        // completed trails (kept after deselect)
var activeTrails = [];  // one active trail per currently selected node
var TRAIL_MIN_DIST2 = 4;   // skip points closer than 2px
var TRAIL_MAX_POINTS = 2500;

function isSelected(d) {
	return selectedNodes.indexOf(d) >= 0;
}
function trailPathFromPoints(pts) {
	if (!pts || !pts.length) return "";
	var d = "M" + pts[0][0] + "," + pts[0][1];
	for (var i = 1; i < pts.length; i++) d += "L" + pts[i][0] + "," + pts[i][1];
	return d;
}
function startTrail(node) {
	if (!trackerEnabled || !node) return;
	// Avoid duplicate active trail for the same node
	for (var i = 0; i < activeTrails.length; i++) {
		if (activeTrails[i].node === node) return;
	}
	var stroke = node.color || "#1ABC9C";
	activeTrails.push({
		node: node,
		points: [[node.x, node.y]],
		path: trailLayer.append("path")
			.attr("class", "node-trail")
			.attr("fill", "none")
			.attr("stroke", stroke)
			.attr("stroke-width", 2)
			.attr("stroke-opacity", 0.8)
			.attr("stroke-linejoin", "round")
			.attr("stroke-linecap", "round")
			.attr("d", "")
	});
}
function finalizeTrailFor(node) {
	for (var i = activeTrails.length - 1; i >= 0; i--) {
		if (activeTrails[i].node === node) {
			trails.push(activeTrails[i]);
			activeTrails.splice(i, 1);
		}
	}
}
function finalizeAllActiveTrails() {
	for (var i = 0; i < activeTrails.length; i++) trails.push(activeTrails[i]);
	activeTrails = [];
}
function updateActiveTrail() {
	if (!trackerEnabled || !activeTrails.length) return;
	for (var t = 0; t < activeTrails.length; t++) {
		var trail = activeTrails[t];
		var n = trail.node;
		var pts = trail.points;
		var last = pts[pts.length - 1];
		var dx = n.x - last[0], dy = n.y - last[1];
		if (dx * dx + dy * dy < TRAIL_MIN_DIST2) continue;
		pts.push([n.x, n.y]);
		if (pts.length > TRAIL_MAX_POINTS) pts.shift();
		trail.path
			.attr("d", trailPathFromPoints(pts))
			.attr("stroke", n.color || "#1ABC9C");
	}
}
function clearTrails() {
	finalizeAllActiveTrails();
	trailLayer.selectAll("*").remove();
	trails = [];
	// Restart trails for any nodes still selected
	if (trackerEnabled) {
		for (var i = 0; i < selectedNodes.length; i++) startTrail(selectedNodes[i]);
	}
}

var circle = chartRoot.selectAll("path.bubble")
	.data(nodes)
  .enter().append("path")
	.attr("class", "bubble")
	.attr("d", function(d) { return shapePath(shapeForNode(d), d.radius); })
	.attr("transform", function(d) { return "translate(" + d.x + "," + d.y + ")"; })
	.style("fill", function(d) { return d.color; })
	.style("opacity", circleOpacity)
	.style("stroke", circleStroke)
	.style("stroke-width", 1)
	.style("cursor", "pointer");

// Multi-select: click toggles a bubble in/out of the selection. Click empty
// chart space clears all. With tracker on, each selected bubble records its
// own trail; trails are kept when nodes are deselected.
function styleSelection() {
	var hasSel = selectedNodes.length > 0;
	circle
		.classed("selected", function (d) { return isSelected(d); })
		.style("opacity", function (d) {
			if (!hasSel) return circleOpacity;
			return isSelected(d) ? 1 : Math.min(0.22, circleOpacity * 0.4);
		})
		.style("stroke", function (d) {
			return isSelected(d) ? "#ffffff" : circleStroke;
		})
		.style("stroke-width", function (d) {
			return isSelected(d) ? 3.5 : 1;
		});
	if (hasSel) {
		// Raise selected bubbles above the others
		circle.filter(function (d) { return isSelected(d); }).each(function () {
			this.parentNode.appendChild(this);
		});
	}
}
circle.on("click", function (d) {
	if (d3.event) d3.event.stopPropagation();
	var idx = selectedNodes.indexOf(d);
	if (idx >= 0) {
		// Toggle off this node; keep its trail
		selectedNodes.splice(idx, 1);
		finalizeTrailFor(d);
	} else {
		// Add to multi-selection and start a trail
		selectedNodes.push(d);
		startTrail(d);
	}
	styleSelection();
});

// Per-bubble text labels (Layout → Label)
var nodeLabel = chartRoot.selectAll("text.nodelabel")
	.data(nodes)
  .enter().append("text")
	.attr("class", "nodelabel")
	.attr("text-anchor", "middle")
	.style("font-size", "11px")
	.style("pointer-events", "none")
	.style("display", "none")
	.text("");

// Track which nodes are currently visible based on the date filter.
// Note: this only hides/shows bubbles — the underlying simulation and the
// activity percentages keep accounting for every sample regardless of the
// filter, so the "%" labels reflect the full dataset, not just what's shown.
var node_active = nodes.map(function() { return true; });

function applyDateFilter() {
	var startVal = document.getElementById('dateFilterStart').value;
	var endVal = document.getElementById('dateFilterEnd').value;
	if (!startVal || !endVal) return;

	var startDate = new Date(startVal);
	var endDate = new Date(endVal);
	var visibleCount = 0;

	nodes.forEach(function(d, i) {
		var nodeDate = new Date(node_start_date[i]);
		var withinRange = (nodeDate >= startDate) && (nodeDate <= endDate);
		node_active[i] = withinRange;
		if (withinRange) visibleCount += 1;
	});

	circle.style("display", function(d, i) { return node_active[i] ? null : "none"; });
	nodeLabel.style("display", function(d, i) {
		if (!node_active[i] || !currentLabelKey) return "none";
		return null;
	});

	d3.select("#dateFilterCount").text(visibleCount + " / " + nodes.length + " samples shown");
}

d3.select("#applyDateFilter").on("click", applyDateFilter);
d3.select("#resetDateFilter").on("click", function() {
	document.getElementById('dateFilterStart').value = DATE_MIN;
	document.getElementById('dateFilterEnd').value = DATE_MAX;
	applyDateFilter();
});

// Activity labels (class-scoped selectAll so per-bubble nodelabel <text>
// elements created earlier are not reused/rebound as category labels).
var label = chartRoot.selectAll("text.actlabel")
	.data(act_codes)
  .enter().append("text")
	.attr("class", "actlabel")
	.attr("x", function(d, i) {
		if (d.desc == center_act) {
			return center_pt.x;
		} else {
			return labelRadius * Math.cos(i * theta) + center_pt.x;
		}
	})
	.attr("y", function(d, i) {
		if (d.desc == center_act) {
			return center_pt.y;
		} else {
			return labelRadius * Math.sin(i * theta) + center_pt.y;
		}
	});
	
label.append("tspan")
	.attr("x", function() { return d3.select(this.parentNode).attr("x"); })
	// .attr("dy", "1.3em")
	.attr("text-anchor", "middle")
