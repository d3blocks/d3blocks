<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ TITLE }}</title>

{{ SUPPORT }}

<style>
{% include "movingbubbles.css" %}
body { font-size: {{ FONTSIZE }}; }
.node { stroke-width: 1.5px; }
</style>
</head>

<body{% if darkMode == 'false' %} class="light"{% endif %}>
{% if showControls == 'true' %}

<div class="top-panel" role="toolbar" aria-label="Top controls">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
        <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
  </div>
  <div class="top-panel-center top-speed">
    <span class="top-speed-caption">Speed</span>
    <span id="speedLabel" class="top-speed-label">Medium</span>
    <input type="range" id="speedSlider" min="0" max="100" step="1" value="50" title="Playback speed: left = stop, right = super fast">
  </div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button" title="{% if darkMode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if darkMode == 'false' %}☀{% else %}🌙{% endif %}</button>
  </div>
</div>

{{ SAVE_BUTTON_START }}
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export / Save<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button id="exportButton" class="button-switch" style="width:100%;box-sizing:border-box;margin-bottom:8px">Export</button>
    <button id="saveButton" class="button-switch" style="width:100%;box-sizing:border-box">Save</button>
    <div style="font-size:11px;opacity:0.6;margin-top:6px">Export downloads the current state (position, activity, color) of every bubble as JSON.</div>
  </div>
</div>
{{ SAVE_BUTTON_STOP }}

<!-- Layout: was "Display" -- Color-on dropdown + node size multiplier -->
<div class="stats-panel collapsed" id="displayPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label for="ColorOptions" style="display:block;margin-bottom:4px">Color on</label>
    <select id="ColorOptions" onchange="link_color_changed(this.value)" style="width:100%;box-sizing:border-box">
      <option value="STATE" {{ COLOR_STATE_SELECTED }}>State</option>
      <option value="NODE" {{ COLOR_NODE_SELECTED }}>Sample id</option>
    </select>
    <div class="slider-row" style="margin-top:12px">
      <label for="sizeMultiplierSlider">Size multiplier <span class="val" id="sizeMultiplierVal">1.0×</span></label>
      <input type="range" id="sizeMultiplierSlider" min="-1" max="1" step="0.01" value="0">
    </div>
  </div>
</div>


<!-- Filtering: was "Filter by date:" -->
<div class="stats-panel collapsed" id="filterPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Filtering<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label style="display:block;margin-bottom:4px">Filter by date</label>
    <div id="date-filter">
        <input type="date" id="dateFilterStart" value="{{ DATE_MIN }}" min="{{ DATE_MIN }}" max="{{ DATE_MAX }}">
        <span>&ndash;</span>
        <input type="date" id="dateFilterEnd" value="{{ DATE_MAX }}" min="{{ DATE_MIN }}" max="{{ DATE_MAX }}">
        <br><br>
        <button id="applyDateFilter" class="togglebutton" style="width:auto; float:none; display:inline-block; padding:3px 8px;">Apply</button>
        <button id="resetDateFilter" class="togglebutton" style="width:auto; float:none; display:inline-block; padding:3px 8px;">Reset</button>
        <div id="dateFilterCount" style="margin-top:6px; font-size:12px;"></div>
    </div>
  </div>
</div>

{% endif %}

<div id="noteWrap">
    <div id="note"></div>
    <div id="cite">
        {{ NOTE }}
    </div>
</div>

<!-- Clock lives in its own reserved strip above the chart so the SVG
     never draws underneath it. #chartStage is the exclusive area for
     the visualization; the clock sits in #chartHeader above that stage. -->
<div id="chartHeader">
    <div id="current_day">&nbsp;</div>
    <div id="current_time">{{ START_TIME }}</div>
</div>

<div id="chartStage">
    <div id="main-wrapper">
        <div id="chart"></div>
    </div>
</div>


<script>

    {% include "d3-3-5-5.min.js" %}

var USER_SPEED = "slow";
var IS_PAUSED = false;
var timer_handle = null;
// —— Continuous playback speed. Slider is 0-100: 0 = stop, 100 = superfast.
// Delays come from the Python `speed` dict (injected as `speeds`):
//   slow      → max delay (left, just after stop)
//   superfast → min delay (right end of the slider)
// medium/fast shape the label thresholds only.
var speeds = {{ SPEED }};
var SPEED_MAX_DELAY = (speeds && speeds.slow != null) ? +speeds.slow : 1000;
var SPEED_MIN_DELAY = (speeds && speeds.superfast != null) ? +speeds.superfast
                    : (speeds && speeds.fast != null) ? +speeds.fast : 20;
var currentDelay = SPEED_MAX_DELAY - (SPEED_MAX_DELAY - SPEED_MIN_DELAY) * 0.5;

var width = {{ WIDTH }},
    height = {{ HEIGHT }},
	padding = 1,
	maxRadius = 3;
	// color = d3.scale.category10();
	
var sched_objs = [],
	curr_minute = 0;

// STATE PROPERTIES
var act_codes = {{ ACT_CODES }};
var act_counts = {{ ACT_COUNTS }};
var time_notes = {{ TIME_NOTES }};
var notes_index = 0;
var colorByActivity = {{ COLORBYACTIVITY }} // array of the colors per state

// NODE PROPERTIES
var node_size = {{ NODE_SIZE }}; //array of radius values, one for each node
var node_color = {{ NODE_COLOR }}; //array of color values, one for each node
var color_method = "{{ COLOR_METHOD }}"; //Nodes can be colored based on "STATE" or "NODE"

// DATE FILTER. node_start_date[i] is the "YYYY-MM-DD" date of the first event
// for the i-th node/sample, aligned with node_size/node_color by index.
var node_start_date = {{ NODE_START_DATE }};
var DATE_MIN = "{{ DATE_MIN }}";
var DATE_MAX = "{{ DATE_MAX }}";

// DATA. The nodes are comma seperated and within each node, the pattern is: ["sample_id 1, time_in_state 1, ..", "sample_id 2, time_in_state 1, ..", ..]
data = {{ json_data }}

// color_method selection changes. Listen if changes are made (onchange=link_color_changed())
function link_color_changed(linkColor_value) {
    console.log(linkColor_value)
    color_method = linkColor_value
}


var center_act = {{ CENTER }},
	center_pt = { "x": 380, "y": 365 };

var theta = 2 * Math.PI / (center_act ? (act_codes.length - 1) : act_codes.length );

// Coordinates for activities
var foci = {};
act_codes.forEach(function(code, i) {
	if (code.desc == center_act) {
		foci[code.index] = center_pt;
	} else {
		foci[code.index] = {x: 250 * Math.cos(i * theta)+380, y: 250 * Math.sin(i * theta)+365 };
	}
});


// Start the SVG
var svg = d3.select("#chart").append("svg")
    .attr("width", width)
    .attr("height", height);


data.forEach(function(d) {
	var day_array = d.split(",");
	var activities = [];
	for (var i=0; i < day_array.length; i++) {
		// Duration
		if (i % 2 == 1) {
			activities.push({'act': day_array[i-1], 'duration': +day_array[i]});
		}
	}
	sched_objs.push(activities);
});


// A node for each person's schedule
var nodes = sched_objs.map(function(o, i) {
	var act = o[0].act;
	act_counts[act] += 1;
	var init_x = foci[act].x + Math.random();
	var init_y = foci[act].y + Math.random();
	return {
		act: act,
		x: init_x,
		y: init_y,
		radius: node_size[i], //use the i-th value from the node_size array to set the radius of the i-th node
		//color: color(act),
		//color: node_color[i],
        color: (color_method === "STATE" ? color(act) : node_color[i]),
		moves: 0,
		next_move_time: o[0].duration,
		sched: o,
	}
});

// Remember each node's original radius so the Layout panel's size
// multiplier can scale it non-destructively, matching scatter's
// sizeMultiplier pattern.
var baseNodeRadii = nodes.map(function(n) { return n.radius; });

var force = d3.layout.force()
	.nodes(nodes)
	.size([width, height])
	// .links([])
	.gravity(0)
	.charge(0)
	.friction(.9)
	.on("tick", tick)
	.start();

var circleOpacity = {{ OPACITY }};
var circleStroke = "{{ STROKE }}";

var circle = svg.selectAll("circle")
	.data(nodes)
  .enter().append("circle")
	.attr("r", function(d) { return d.radius; })
	.style("fill", function(d) { return d.color; })
	.style("opacity", circleOpacity)
	.style("stroke", circleStroke)
	.style("stroke-width", 1);
	// .call(force.drag);

// Track which nodes are currently visible based on the date filter.
// Note: this only hides/shows bubbles — the underlying simulation and the
// activity percentages keep accounting for every sample regardless of the
// filter, so the "%" labels reflect the full dataset, not just what's shown.
var node_active = nodes.map(function() { return true; });

function applyDateFilter() {
	var startVal = document.getElementById('dateFilterStart').value;
	var endVal = document.getElementById('dateFilterEnd').value;
	if (!startVal || !endVal) return;

	var startDate = new Date(startVal);
	var endDate = new Date(endVal);
	var visibleCount = 0;

	nodes.forEach(function(d, i) {
		var nodeDate = new Date(node_start_date[i]);
		var withinRange = (nodeDate >= startDate) && (nodeDate <= endDate);
		node_active[i] = withinRange;
		if (withinRange) visibleCount += 1;
	});

	circle.style("display", function(d, i) { return node_active[i] ? null : "none"; });

	d3.select("#dateFilterCount").text(visibleCount + " / " + nodes.length + " samples shown");
}

d3.select("#applyDateFilter").on("click", applyDateFilter);
d3.select("#resetDateFilter").on("click", function() {
	document.getElementById('dateFilterStart').value = DATE_MIN;
	document.getElementById('dateFilterEnd').value = DATE_MAX;
	applyDateFilter();
});

// Activity labels
var label = svg.selectAll("text")
	.data(act_codes)
  .enter().append("text")
	.attr("class", "actlabel")
	.attr("x", function(d, i) {
		if (d.desc == center_act) {
			return center_pt.x;
		} else {
			return 340 * Math.cos(i * theta)+380;
		}
		
	})
	.attr("y", function(d, i) {
		if (d.desc == center_act) {
			return center_pt.y;
		} else {
			return 340 * Math.sin(i * theta)+365;
		}
		
	});
	
label.append("tspan")
	.attr("x", function() { return d3.select(this.parentNode).attr("x"); })
	// .attr("dy", "1.3em")
	.attr("text-anchor", "middle")
	.text(function(d) {
		return d.short;
	});
label.append("tspan")
	.attr("dy", "1.3em")
	.attr("x", function() { return d3.select(this.parentNode).attr("x"); })
	.attr("text-anchor", "middle")
	.attr("class", "actpct")
	.text(function(d) {
		return act_counts[d.index] + "%";
	});

// Apply the date filter once at startup so the visible-count label reflects
// the full (default) range and the initial visibility state is set.
applyDateFilter();
	

// Update nodes based on activity and duration
function timer() {
	if (IS_PAUSED) return;

	d3.range(nodes.length).map(function(i) {
		var curr_node = nodes[i],
			curr_moves = curr_node.moves; 

		// Time to go to next activity
		if (curr_node.next_move_time == curr_minute && curr_node.moves < curr_node.sched.length-1) {
			curr_moves += 1;
		
			// Subtract from current activity count
			act_counts[curr_node.act] -= 1;
		
			// Move on to next activity
			curr_node.act = curr_node.sched[ curr_moves ].act;
		
			// Add to new activity count
			act_counts[curr_node.act] += 1;
		
			curr_node.moves = curr_moves;
			curr_node.cx = foci[curr_node.act].x;
			curr_node.cy = foci[curr_node.act].y;
		
			nodes[i].next_move_time += nodes[i].sched[ curr_node.moves ].duration;
		}

	});

	force.resume();
	curr_minute += 1;

	// Update percentages
	label.selectAll("tspan.actpct")
		.text(function(d) {
			return readablePercent(act_counts[d.index]);
		});

	// Update day + time display
	var timeResult = formatTime(curr_minute);
	d3.select("#current_day").html(timeResult.day);
	d3.select("#current_time").text(timeResult.time);

	// Update notes (compare against display minute, not raw counter)
	var display_minute = curr_minute % 1440;
	if (display_minute == time_notes[notes_index].start_minute) {
		d3.select("#note")
			.style("top", "0px")
		  .transition()
			.duration(600)
			.style("top", "20px")
			.style("color", "var(--text)")
			.style("opacity", "1")
			.text(time_notes[notes_index].note);
	} 
	
	// Make note disappear at the end.
	else if (display_minute == time_notes[notes_index].stop_minute) {
		
		d3.select("#note").transition()
			.duration(1000)
			.style("top", "300px")
			.style("opacity", "0");
			
		notes_index += 1;
		if (notes_index == time_notes.length) {
			notes_index = 0;
		}
	}
	
	
	timer_handle = setTimeout(timer, currentDelay);
}
timer_handle = setTimeout(timer, currentDelay);



	
function tick(e) {
  var k = 0.04 * e.alpha;

  // Push nodes toward their designated focus.
  nodes.forEach(function(o, i) {
	var curr_act = o.act;
	
	// Make sleep more sluggish moving.
	var damper = {{ DAMPER }};
	
	//if (curr_act == "0") {
	//	var damper = 0.6;
	//} else {
	//	var damper = 1;
	//}

	if (color_method === "STATE") {
		o.color = color(curr_act);
	} else {
		o.color = node_color[i];
	}
	// console.log(color_method)
    // console.log(o.color)

	o.y += (foci[curr_act].y - o.y) * k * damper;
	o.x += (foci[curr_act].x - o.x) * k * damper;
  });

  circle
	  .each(collide(.5))
	  .style("fill", function(d) { return d.color; })
	  .attr("cx", function(d) { return d.x; })
	  .attr("cy", function(d) { return d.y; });
}


// Resolve collisions between nodes.
function collide(alpha) {
  var quadtree = d3.geom.quadtree(nodes);
  return function(d) {
	var r = d.radius + maxRadius + padding,
		nx1 = d.x - r,
		nx2 = d.x + r,
		ny1 = d.y - r,
		ny2 = d.y + r;
	quadtree.visit(function(quad, x1, y1, x2, y2) {
	  if (quad.point && (quad.point !== d)) {
		var x = d.x - quad.point.x,
			y = d.y - quad.point.y,
			l = Math.sqrt(x * x + y * y),
			r = d.radius + quad.point.radius + (d.act !== quad.point.act) * padding;
		if (l < r) {
		  l = (l - r) / l * alpha;
		  d.x -= x *= l;
		  d.y -= y *= l;
		  quad.point.x += x;
		  quad.point.y += y;
		}
	  }
	  return x1 > nx2 || x2 < nx1 || y1 > ny2 || y2 < ny1;
	});
  };
}




// Continuous speed slider (replaces the old Pause/Slow/Medium/Fast
// buttons). Note: the old click handler here was bound to ALL
// .togglebutton elements, which also (buggily) matched the date-filter
// Apply/Reset buttons -- clicking those used to also stomp USER_SPEED to
// null. Those buttons have their own dedicated handlers already, so
// removing this entirely is a clean fix, not just a UI swap.
function speedLabelFor(v) {
	if (v == 0) return "Stopped";
	if (v < 20) return "Slow";
	if (v < 45) return "Medium";
	if (v < 70) return "Fast";
	if (v < 90) return "Very fast";
	return "Super fast";
}
function delayForSliderValue(v) {
	return SPEED_MAX_DELAY - (SPEED_MAX_DELAY - SPEED_MIN_DELAY) * (v / 100);
}
function applySpeedSlider(v) {
	v = +v;
	var label = document.getElementById('speedLabel');
	if (label) label.textContent = speedLabelFor(v);
	if (v === 0) {
		IS_PAUSED = true;
		if (timer_handle) { clearTimeout(timer_handle); timer_handle = null; }
		return;
	}
	currentDelay = delayForSliderValue(v);
	if (IS_PAUSED) {
		IS_PAUSED = false;
		timer_handle = setTimeout(timer, currentDelay);
	}
}
var speedSlider = document.getElementById('speedSlider');
if (speedSlider) {
	speedSlider.addEventListener('input', function (e) { applySpeedSlider(e.target.value); });
	applySpeedSlider(speedSlider.value);
}



function color(activity) {
	//var colorByActivity = {{ COLORBYACTIVITY }}
	return colorByActivity[activity];
}




// Output readable percent based on count.
function readablePercent(n) {
	
	var pct = 100 * n / data.length;
	if (pct < 1 && pct > 0) {
		pct = "<1%";
	} else {
		pct = Math.round(pct) + "%";
	}
	
	return pct;
}


// Time display — returns {day: "Day N", time: "HH:MM:SS"} for all timedelta modes
function formatTime(m) {
	var timedelta = "{{ TIMEDELTA }}";
	var pad = function(n) { return (n < 10 ? "0" : "") + n; };

	if (timedelta === "seconds") {
		// m counts elapsed seconds
		var total_seconds = m;
		var days  = Math.floor(total_seconds / 86400);
		var rem   = total_seconds % 86400;
		var hh    = Math.floor(rem / 3600);
		var mm    = Math.floor((rem % 3600) / 60);
		var ss    = rem % 60;
		return {
			day:  days > 0 ? "Day " + (days + 1) : "&nbsp;",
			time: pad(hh) + ":" + pad(mm) + ":" + pad(ss)
		};

	} else if (timedelta === "days") {
		// m counts elapsed days
		var hh = Math.floor((m % 1) * 24);   // fractional part → hours (always 0 here but safe)
		return {
			day:  "Day " + (m + 1),
			time: pad(hh) + ":00:00"
		};

	} else {
		// Default: minutes
		// m counts elapsed minutes; offset by START_HOUR_MIN so display begins at the real start time
		var total_minutes = m + Math.round({{ START_HOUR_MIN }} * 60);
		var days  = Math.floor(total_minutes / 1440);
		var rem   = total_minutes % 1440;
		if (rem < 0) rem += 1440;
		var hh    = Math.floor(rem / 60);
		var mm    = rem % 60;
		return {
			day:  days > 0 ? "Day " + (days + 1) : "&nbsp;",
			time: pad(hh) + ":" + pad(mm) + ":00"
		};
	}
}

{{ SAVE_TO_SVG_SCRIPT }}

// Seed the day + time display once everything is defined
(function() {
	var t = formatTime(0);
	d3.select("#current_day").html(t.day);
	d3.select("#current_time").text(t.time);
}());

// ————————————————————————————————————————————————————————————
// Floating side panels: position below the top bar, collapsible,
// drag-and-drop reorderable (same pattern as scatter/sankey/radialgraph).
// ————————————————————————————————————————————————————————————
function positionSidePanels() {
	var topPanel = document.querySelector('.top-panel');
	var y = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
	var bottomPad = 12;
	document.querySelectorAll('.stats-panel').forEach(function (panel) {
		if (panel.style.display === 'none') return;
		panel.style.top = y + 'px';
		var maxH = Math.max(80, window.innerHeight - y - bottomPad);
		panel.style.maxHeight = maxH + 'px';
		y += panel.getBoundingClientRect().height + 10;
	});
	// Clock sits in its own strip just below the top bar. Measure its
	// actual height and push #chartStage below it so the SVG never
	// overlaps the clock.
	var chartHeader = document.getElementById('chartHeader');
	var headerTop = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
	if (chartHeader) {
		chartHeader.style.top = headerTop + 'px';
	}
	var chartStage = document.getElementById('chartStage');
	if (chartStage) {
		var headerBottom = headerTop + (chartHeader ? chartHeader.getBoundingClientRect().height : 0) + 8;
		chartStage.style.top = headerBottom + 'px';
	}
}
window.addEventListener('resize', positionSidePanels);
window.addEventListener('load', positionSidePanels);
positionSidePanels();
requestAnimationFrame(positionSidePanels);
if (typeof ResizeObserver !== 'undefined') {
	document.querySelectorAll('.stats-panel').forEach(function (panel) {
		new ResizeObserver(function () { positionSidePanels(); }).observe(panel);
	});
}

document.querySelectorAll('.stats-panel-title').forEach(function (title) {
	title.addEventListener('click', function () {
		if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
		var panel = title.parentElement, collapsing = !panel.classList.contains('collapsed');
		if (collapsing) { if (panel.style.height) panel.dataset.expandedHeight = panel.style.height; panel.style.height = ''; }
		else if (panel.dataset.expandedHeight) panel.style.height = panel.dataset.expandedHeight;
		panel.classList.toggle('collapsed');
		positionSidePanels();
	});
});

// —— Drag-and-drop panel reordering ——
(function setupPanelReordering() {
	document.querySelectorAll('.stats-panel').forEach(function (panel) {
		var title = panel.querySelector('.stats-panel-title');
		if (!title) return;
		title.addEventListener('dragstart', function (e) {
			e.dataTransfer.setData('text/plain', panel.id);
			e.dataTransfer.effectAllowed = 'move';
		});
		title.addEventListener('dragend', function () {
			title.dataset.justDragged = '1';
			setTimeout(function () { title.dataset.justDragged = '0'; }, 0);
		});
		panel.addEventListener('dragover', function (e) {
			e.preventDefault();
			e.dataTransfer.dropEffect = 'move';
			panel.classList.add('drag-over');
		});
		panel.addEventListener('dragleave', function () { panel.classList.remove('drag-over'); });
		panel.addEventListener('drop', function (e) {
			e.preventDefault();
			panel.classList.remove('drag-over');
			var draggedId = e.dataTransfer.getData('text/plain');
			if (!draggedId || draggedId === panel.id) return;
			var draggedEl = document.getElementById(draggedId);
			if (!draggedEl || !panel.parentNode) return;
			panel.parentNode.insertBefore(draggedEl, panel);
			positionSidePanels();
		});
	});
})();

// —— Layout panel: node size multiplier ——
// Exponential mapping (t in [-1,1], base 4) matches scatter's size slider:
// t=-1 -> 0.25x, t=0 -> 1x, t=1 -> 4x. Scales d.radius itself (not just the
// rendered <circle r>) so collide()'s physics stays consistent with what's
// drawn -- otherwise bigger/smaller bubbles would visually overlap or leave
// gaps that don't match their actual collision boundaries.
var SIZE_MULT_BASE = 4;
function applySizeMultiplier(mult) {
	nodes.forEach(function (n, i) { n.radius = baseNodeRadii[i] * mult; });
	circle.attr("r", function (d) { return d.radius; });
}
var sizeMultiplierSlider = document.getElementById('sizeMultiplierSlider');
var sizeMultiplierVal = document.getElementById('sizeMultiplierVal');
if (sizeMultiplierSlider) sizeMultiplierSlider.addEventListener('input', function (e) {
	var t = parseFloat(e.target.value) || 0;
	var mult = Math.pow(SIZE_MULT_BASE, t);
	if (sizeMultiplierVal) sizeMultiplierVal.textContent = mult.toFixed(2) + '×';
	applySizeMultiplier(mult);
});

// —— Export/Save panel: export current bubble state as JSON ——
var exportButton = document.getElementById('exportButton');
if (exportButton) exportButton.addEventListener('click', function () {
	var out = nodes.map(function (n, i) {
		var actInfo = act_codes.find(function (c) { return c.index === String(n.act); });
		return {
			index: i,
			activity: actInfo ? actInfo.desc : n.act,
			x: n.x, y: n.y,
			radius: n.radius,
			color: n.color
		};
	});
	var blob = new Blob([JSON.stringify(out, null, 2)], { type: 'application/json' });
	var url = URL.createObjectURL(blob);
	var a = document.createElement('a');
	a.href = url; a.download = 'movingbubbles_state.json';
	document.body.appendChild(a); a.click(); document.body.removeChild(a);
	setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
});

// —— Theme toggle (button + T key) ——
function toggleTheme() {
	var themeBtn = document.getElementById('themeBtn');
	var isLight = document.body.classList.toggle('light');
	if (themeBtn) { themeBtn.textContent = isLight ? '☀' : '🌙'; themeBtn.title = isLight ? 'Theme: Light' : 'Theme: Dark'; }
}
var themeBtn = document.getElementById('themeBtn');
if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
window.addEventListener('keydown', function (e) {
	if ((e.key === 't' || e.key === 'T') && !(e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA'))) toggleTheme();
});

</script>
</body>
</html>
