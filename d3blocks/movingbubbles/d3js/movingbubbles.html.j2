// Floating side panels: position below the top bar, collapsible,
// drag-and-drop reorderable (same pattern as scatter/sankey/radialgraph).
// ————————————————————————————————————————————————————————————
function positionSidePanels() {
	var topPanel = document.querySelector('.top-panel');
	var y = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
	var bottomPad = 12;
	document.querySelectorAll('.stats-panel').forEach(function (panel) {
		if (panel.style.display === 'none') return;
		panel.style.top = y + 'px';
		var maxH = Math.max(80, window.innerHeight - y - bottomPad);
		panel.style.maxHeight = maxH + 'px';
		y += panel.getBoundingClientRect().height + 10;
	});
	// Clock sits in its own strip just below the top bar. Measure its
	// actual height and push #chartStage below it so the SVG never
	// overlaps the clock.
	var chartHeader = document.getElementById('chartHeader');
	var headerTop = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
	if (chartHeader) {
		chartHeader.style.top = headerTop + 'px';
	}
	var chartStage = document.getElementById('chartStage');
	if (chartStage) {
		var headerBottom = headerTop + (chartHeader ? chartHeader.getBoundingClientRect().height : 0) + 8;
		chartStage.style.top = headerBottom + 'px';
	}
}
