function tick(e) {
  var k = 0.04 * e.alpha;

  // Push nodes toward their designated focus.
  nodes.forEach(function(o, i) {
	var curr_act = o.act;
	
	// Make sleep more sluggish moving.
	var damper = {{ DAMPER }};
	
	//if (curr_act == "0") {
	//	var damper = 0.6;
	//} else {
	//	var damper = 1;
	//}

	// Base color from state/node, unless Layout→Color overrides it.
	// Special case: coloring by the state column uses the *live* activity.
	if (layoutColorKey && layoutColorKey === STATE_COL) {
		o.color = color(curr_act);
	} else if (layoutColorKey && layoutColorScale && o.props) {
		var pv = o.props[layoutColorKey];
		o.color = (pv != null && pv !== '') ? layoutColorScale(pv) : (color_method === "STATE" ? color(curr_act) : node_color[i]);
	} else if (color_method === "STATE") {
		o.color = color(curr_act);
	} else {
		o.color = node_color[i];
	}

	o.y += (foci[curr_act].y - o.y) * k * damper;
	o.x += (foci[curr_act].x - o.x) * k * damper;
  });

  circle
	  .each(collide(.5))
	  .style("fill", function(d) { return d.color; })
	  .attr("d", function(d) { return shapePath(shapeForNode(d), d.radius); })
	  .attr("transform", function(d) { return "translate(" + d.x + "," + d.y + ")"; });

  nodeLabel
	  .attr("x", function(d) { return d.x; })
	  .attr("y", function(d) { return d.y - d.radius - 4; })
	  .style("fill", "var(--text)")
	  .text(function(d) { return currentLabelKey ? labelTextFor(d) : ""; });

  // Append points to the active selection trail
  updateActiveTrail();
}


// Resolve collisions between nodes.
function collide(alpha) {
  var quadtree = d3.geom.quadtree(nodes);
  return function(d) {
	var r = d.radius + maxRadius + padding,
		nx1 = d.x - r,
		nx2 = d.x + r,
		ny1 = d.y - r,
		ny2 = d.y + r;
	quadtree.visit(function(quad, x1, y1, x2, y2) {
	  if (quad.point && (quad.point !== d)) {
		var x = d.x - quad.point.x,
			y = d.y - quad.point.y,
			l = Math.sqrt(x * x + y * y),
			r = d.radius + quad.point.radius + (d.act !== quad.point.act) * padding;
		if (l < r) {
		  l = (l - r) / l * alpha;
		  d.x -= x *= l;
		  d.y -= y *= l;
		  quad.point.x += x;
		  quad.point.y += y;
		}
	  }
	  return x1 > nx2 || x2 < nx1 || y1 > ny2 || y2 < ny1;
	});
  };
}




