function initLayoutPropertyControls() {
	// Populate dropdowns from per-sample property bags (df columns), filtered
	// by the Variables panel (enabled + numeric/category):
	//   Size  → enabled numeric only
	//   Color → all enabled (numeric = continuous, categorical = discrete)
	//   Shape → enabled categorical only (Default = circle)
	//   Label → all enabled
	// Always re-applies the active Size/Color/Shape/Label modes so a Numeric↔
	// Category flip immediately moves a variable between Size and Shape and
	// rebuilds continuous vs discrete color scales.
	var keys = propKeys();
	var sizeSelect = document.getElementById("layoutSizeSelect");
	var colorSelect = document.getElementById("layoutColorSelect");
	var shapeSelect = document.getElementById("layoutShapeSelect");
	var labelSelect = document.getElementById("layoutLabelSelect");

	var prevSize = sizeSelect ? sizeSelect.value : '';
	var prevColor = colorSelect ? colorSelect.value : '';
	var prevShape = shapeSelect ? shapeSelect.value : 'circle';
	var prevLabel = labelSelect ? labelSelect.value : '';

	function clearDynamic(select, keepFirst) {
		if (!select) return;
		while (select.options.length > (keepFirst || 1)) select.remove(keepFirst || 1);
	}
	clearDynamic(sizeSelect, 1);
	clearDynamic(colorSelect, 1);
	clearDynamic(shapeSelect, 1); // keep only "Default"
	clearDynamic(labelSelect, 1);

	function addOpt(select, value, label) {
		if (!select) return;
		var o = document.createElement("option");
		o.value = value;
		o.textContent = label;
		select.appendChild(o);
	}
	keys.forEach(function (k) {
		if (!isVarEnabled(k)) return;
		// State is always categorical for layout purposes.
