	if (colorSelect) {
		colorSelect.value = hasOption(colorSelect, prevColor) ? prevColor : '';
		applyColorMode(colorSelect.value);
	}
	if (shapeSelect) {
		shapeSelect.value = hasOption(shapeSelect, prevShape) ? prevShape : 'circle';
		applyShapeMode(shapeSelect.value);
	}
	if (labelSelect) {
		labelSelect.value = hasOption(labelSelect, prevLabel) ? prevLabel : '';
		applyLabelMode(labelSelect.value);
	}
}

function escapeHtmlVar(v) {
	if (v == null) return '';
	return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}
function populateVarList() {
	var container = document.getElementById('varList');
	if (!container) return;
	var keys = propKeys();
	if (!keys.length) {
		container.innerHTML = '<div style="opacity:0.5;font-size:12px">No variables found.</div>';
		return;
	}
	keys.forEach(function (k) {
		if (!varState[k]) {
			var auto = (k === STATE_COL) ? 'cat' : detectColumnDtype(propColumnValues(k));
			varState[k] = { enabled: true, dtypeOverride: auto };
		}
	});
	var html = '';
	keys.forEach(function (k) {
		var state = varState[k];
		var dtype = state.dtypeOverride || 'cat';
		var rowClasses = 'enrich-var-row ' + (dtype === 'num' ? 'dtype-num' : 'dtype-cat') + (state.enabled === false ? ' disabled' : '');
		html += '<div class="' + rowClasses + '" data-key="' + escapeHtmlVar(k) + '">' +
			'<label class="enrich-var-check"><input type="checkbox" class="enrich-var-checkbox" data-key="' + escapeHtmlVar(k) + '"' +
			(state.enabled !== false ? ' checked' : '') + '><span class="enrich-var-dot" aria-hidden="true"></span>' +
			escapeHtmlVar(k) + '</label>' +
			'<select class="enrich-var-dtype" data-key="' + escapeHtmlVar(k) + '">' +
			'<option value="num"' + (dtype === 'num' ? ' selected' : '') + '>Numeric</option>' +
			'<option value="cat"' + (dtype === 'cat' ? ' selected' : '') + '>Category</option>' +
			'</select></div>';
	});
	container.innerHTML = html;
	container.querySelectorAll('.enrich-var-checkbox').forEach(function (cb) {
		cb.addEventListener('change', function () {
			varState[cb.dataset.key].enabled = cb.checked;
			var row = cb.closest('.enrich-var-row');
			if (row) row.classList.toggle('disabled', !cb.checked);
			initLayoutPropertyControls();
		});
	});
	container.querySelectorAll('.enrich-var-dtype').forEach(function (sel) {
		// change + input so Layout Size/Shape lists update as soon as the
		// Numeric/Category choice is made (some browsers only fire one).
		function onDtypeChange() {
			var key = sel.dataset.key;
			if (!varState[key]) varState[key] = { enabled: true, dtypeOverride: sel.value };
			varState[key].dtypeOverride = sel.value;
			var row = sel.closest('.enrich-var-row');
			if (row) {
				row.classList.remove('dtype-num', 'dtype-cat');
				row.classList.add(sel.value === 'num' ? 'dtype-num' : 'dtype-cat');
			}
			initLayoutPropertyControls();
		}
		sel.addEventListener('change', onDtypeChange);
		sel.addEventListener('input', onDtypeChange);
	});
	if (typeof positionSidePanels === 'function') setTimeout(positionSidePanels, 0);
}
populateVarList();
initLayoutPropertyControls();

var layoutSizeSelect = document.getElementById("layoutSizeSelect");
if (layoutSizeSelect) layoutSizeSelect.addEventListener("change", function (e) { applySizeMode(e.target.value); });
var layoutColorSelect = document.getElementById("layoutColorSelect");
if (layoutColorSelect) layoutColorSelect.addEventListener("change", function (e) { applyColorMode(e.target.value); });
var layoutShapeSelect = document.getElementById("layoutShapeSelect");
if (layoutShapeSelect) layoutShapeSelect.addEventListener("change", function (e) { applyShapeMode(e.target.value); });
var layoutLabelSelect = document.getElementById("layoutLabelSelect");
if (layoutLabelSelect) layoutLabelSelect.addEventListener("change", function (e) { applyLabelMode(e.target.value); });

var sizeMultiplierSlider = document.getElementById("sizeMultiplierSlider");
var sizeMultiplierVal = document.getElementById("sizeMultiplierVal");
if (sizeMultiplierSlider) sizeMultiplierSlider.addEventListener("input", function (e) {
	var t = parseFloat(e.target.value) || 0;
	var mult = Math.pow(SIZE_MULT_BASE, t);
	if (sizeMultiplierVal) sizeMultiplierVal.textContent = mult.toFixed(2) + "×";
	applySizeMultiplier(mult);
});
var trackerEnabledCb = document.getElementById("trackerEnabled");
if (trackerEnabledCb) {
	trackerEnabled = !!trackerEnabledCb.checked;
	trackerEnabledCb.addEventListener("change", function () {
		trackerEnabled = !!trackerEnabledCb.checked;
		if (!trackerEnabled) {
			// Stop recording; keep existing trails on screen
			finalizeAllActiveTrails();
		} else {
			// Resume trails for every currently selected node
			for (var i = 0; i < selectedNodes.length; i++) startTrail(selectedNodes[i]);
		}
	});
}
var clearTrailsBtn = document.getElementById("clearTrailsBtn");
if (clearTrailsBtn) clearTrailsBtn.addEventListener("click", function () {
	clearTrails();
});
var layoutResetBtn = document.getElementById("layoutResetBtn");
if (layoutResetBtn) layoutResetBtn.addEventListener("click", function () {
	if (layoutSizeSelect) layoutSizeSelect.value = "";
	if (layoutColorSelect) layoutColorSelect.value = "";
	if (layoutShapeSelect) layoutShapeSelect.value = "circle";
	if (layoutLabelSelect) layoutLabelSelect.value = "";
	applySizeMode("");
	applyColorMode("");
	applyShapeMode("circle");
	applyLabelMode("");
});

// —— Export/Save panel: export current bubble state as JSON ——
var exportButton = document.getElementById('exportButton');
if (exportButton) exportButton.addEventListener('click', function () {
	var out = nodes.map(function (n, i) {
		var actInfo = act_codes.find(function (c) { return c.index === String(n.act); });
		return {
			index: i,
			activity: actInfo ? actInfo.desc : n.act,
			x: n.x, y: n.y,
			radius: n.radius,
			color: n.color
		};
	});
	var blob = new Blob([JSON.stringify(out, null, 2)], { type: 'application/json' });
	var url = URL.createObjectURL(blob);
	var a = document.createElement('a');
	a.href = url; a.download = 'movingbubbles_state.json';
	document.body.appendChild(a); a.click(); document.body.removeChild(a);
	setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
});

// —— Theme toggle (button + T key) ——
function toggleTheme() {
	var themeBtn = document.getElementById('themeBtn');
	var isLight = document.body.classList.toggle('light');
	if (themeBtn) { themeBtn.textContent = isLight ? '☀' : '🌙'; themeBtn.title = isLight ? 'Theme: Light' : 'Theme: Dark'; }
}
var themeBtn = document.getElementById('themeBtn');
if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
window.addEventListener('keydown', function (e) {
	if ((e.key === 't' || e.key === 'T') && !(e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA'))) toggleTheme();
});

</script>
