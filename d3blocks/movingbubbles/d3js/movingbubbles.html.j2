		var panel = title.parentElement, collapsing = !panel.classList.contains('collapsed');
		if (collapsing) { if (panel.style.height) panel.dataset.expandedHeight = panel.style.height; panel.style.height = ''; }
		else if (panel.dataset.expandedHeight) panel.style.height = panel.dataset.expandedHeight;
		panel.classList.toggle('collapsed');
