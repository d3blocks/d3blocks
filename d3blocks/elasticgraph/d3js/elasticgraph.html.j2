<!DOCTYPE html>
<!--
Library     : d3blocks
Author      : E.Taskesen
Github      : https://github.com/d3blocks/d3blocks
License     : GPL3
Chart       : Elasticgraph (elastic force-directed network)
-->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style type="text/css">
        {% include "elasticgraph.css" %}
    </style>
</head>
<body{% if not dark_mode %} class="light"{% endif %}>

<!-- ── Top panel: logo left · dark-mode toggle right ───────────── -->
<div class="top-panel" role="toolbar" aria-label="Top controls">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
      <img src="{% include 'logo.txt' %}" alt="D3Blocks"
           style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
  </div>
  <div class="top-panel-center"></div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button"
            title="{% if not dark_mode %}Theme: Light{% else %}Theme: Dark{% endif %}">
      {% if not dark_mode %}☀{% else %}🌙{% endif %}
    </button>
  </div>
</div>

{% if show_controls %}
<!-- ── Side panel: Export / Save ───────────────────────────────── -->
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">
    Export / Save
    <span class="stats-panel-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </div>
  <div class="stats-panel-body">
    {% if save_button %}
    <button id="saveSvgBtn" class="button-switch" style="width:100%;margin:4px 0"
            type="button" title="Save the current view as SVG">💾 Save SVG</button>
    {% endif %}
    <button id="saveJsonBtn" class="button-switch" style="width:100%;margin:4px 0"
            type="button" title="Export graph data as JSON">⬇ Export JSON</button>
    <p class="panel-note">Save downloads the graph as SVG. Export downloads the node/edge data as JSON.</p>
  </div>
</div>

<!-- ── Side panel: Physics ─────────────────────────────────────── -->
<div class="stats-panel collapsed" id="physicsPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">
    Physics
    <span class="stats-panel-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label for="chargeSlider">Charge <span id="chargeVal">{{ charge }}</span></label>
      <input type="range" id="chargeSlider" min="100" max="5000" step="50"
             value="{{ charge }}">
    </div>
    <div class="physics-control">
      <label for="collisionSlider">Collision <span id="collisionVal">{{ collision }}</span></label>
      <input type="range" id="collisionSlider" min="0.1" max="3.0" step="0.1"
             value="{{ collision }}">
    </div>
    <div class="physics-control">
      <label for="hullSlider">Hull offset <span id="hullVal">{{ hull_offset }}</span></label>
      <input type="range" id="hullSlider" min="0" max="60" step="1"
             value="{{ hull_offset }}">
    </div>
    <p class="panel-note">Physics sliders restart the simulation with new values.</p>
  </div>
</div>

<!-- ── Side panel: Display ─────────────────────────────────────── -->
<div class="stats-panel collapsed" id="displayPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">
    Display
    <span class="stats-panel-toggle" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </div>
  <div class="stats-panel-body">
    <label>
      <input type="checkbox" id="toggleLabels" checked> Show labels
    </label>
    <label>
      <input type="checkbox" id="toggleEdgeLabels" checked> Show edge labels
    </label>
    <label>
      <input type="checkbox" id="toggleSticky" {% if sticky %}checked{% endif %}> Sticky nodes
    </label>
    <hr>
    <div class="physics-control">
      <label for="labelSizeSlider">Label size <span id="labelSizeVal">12</span> px</label>
      <input type="range" id="labelSizeSlider" min="6" max="32" step="1" value="12">
    </div>
    <div class="physics-control">
      <label for="labelZoomSlider">Hide labels below zoom <span id="labelZoomVal">{{ label_zoom_threshold }}</span></label>
      <input type="range" id="labelZoomSlider" min="0.1" max="2.0" step="0.05"
             value="{{ label_zoom_threshold }}">
    </div>
    <button id="resetZoomBtn" class="button-switch" style="width:100%;margin-top:8px"
            type="button">⌖ Reset zoom</button>
    <button id="unpinAllBtn"  class="button-switch" style="width:100%;margin-top:4px"
            type="button">📌 Unpin all nodes</button>
    <p class="panel-note">Single-click a cluster to expand it; right-click a pinned node to release it.</p>
  </div>
</div>
{% endif %}

<!-- ── Graph host ───────────────────────────────────────────────── -->
<div id="graph-container"></div>

<!-- ── D3 v2 + elasticgraph ────────────────────────────────────── -->
<script>
{% include "d3.v2.js" %}
</script>
<script>
{% include "elasticgraph.js" %}
</script>

<script>
/* ── Init graph ──────────────────────────────────────────────────── */
'use strict';

// Keep a reference to the force objects so panel controls can call
// into them after init. d3graphscript() returns {force, force2, zoomBehavior}.
let _graphHandle = null;

window.addEventListener('DOMContentLoaded', function () {
  _graphHandle = d3graphscript({{ json_data }}, {
    width:                0,   // 0 → auto-sized from #graph-container
    height:               0,
    dr:                   {{ point_radius }},
    off:                  {{ hull_offset }},
    debug:                {{ debug }},
    single_click_expand:  {{ single_click_expand|int }},
    collision:            {{ collision }},
    charge:               {{ charge }},
    sticky:               {{ sticky|int }},
    label_zoom_threshold: {{ label_zoom_threshold }}
  });
});

/* ── Panel infrastructure (collapse, drag-reorder, position) ─────── */
(function () {
  var PANEL_ORDER = ['exportPanel', 'physicsPanel', 'displayPanel'];

  function positionSidePanels() {
    var bar  = document.querySelector('.top-panel');
    var gc   = document.getElementById('graph-container');
    if (!bar) return;

    // Push the graph container to the right of all visible panels.
    var panelW = 0;
    PANEL_ORDER.forEach(function (id) {
      var p = document.getElementById(id);
      if (p && p.style.display !== 'none') {
        var r = p.getBoundingClientRect();
        panelW = Math.max(panelW, r.right);
      }
    });
    if (gc) {
      gc.style.left = (panelW > 0 ? panelW + 8 : 0) + 'px';
    }

    var topBottom = bar.getBoundingClientRect().bottom;
    var y         = topBottom + 8;
    var bottomPad = 12;
    PANEL_ORDER.forEach(function (id) {
      var panel = document.getElementById(id);
      if (!panel || panel.style.display === 'none') return;
      panel.style.top       = y + 'px';
      panel.style.maxHeight = Math.max(80, window.innerHeight - y - bottomPad) + 'px';
      y += panel.getBoundingClientRect().height + 10;
    });
  }

  window.addEventListener('resize', positionSidePanels);
  window.addEventListener('load',   positionSidePanels);
  positionSidePanels();
  requestAnimationFrame(positionSidePanels);

  if (typeof ResizeObserver !== 'undefined') {
    var bar = document.querySelector('.top-panel');
    if (bar) new ResizeObserver(positionSidePanels).observe(bar);
    PANEL_ORDER.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) new ResizeObserver(positionSidePanels).observe(el);
    });
  }

  // Collapse toggle
  PANEL_ORDER.forEach(function (panelId) {
    var panel = document.getElementById(panelId);
    if (!panel) return;
    var title = panel.querySelector('.stats-panel-title');
    if (!title) return;
    title.addEventListener('click', function () {
      if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
      var collapsing = !panel.classList.contains('collapsed');
      if (collapsing) {
        if (panel.style.height) panel.dataset.expandedHeight = panel.style.height;
        panel.style.height = '';
      } else if (panel.dataset.expandedHeight) {
        panel.style.height = panel.dataset.expandedHeight;
      }
      panel.classList.toggle('collapsed');
      setTimeout(positionSidePanels, 0);
    });
  });

  // Drag-reorder
  PANEL_ORDER.forEach(function (panelId) {
    var panel = document.getElementById(panelId);
    if (!panel) return;
    var title = panel.querySelector('.stats-panel-title');
    if (!title) return;
    title.addEventListener('dragstart', function (e) {
      e.dataTransfer.setData('text/plain', panelId);
      e.dataTransfer.effectAllowed = 'move';
    });
    title.addEventListener('dragend', function () {
      title.dataset.justDragged = '1';
      setTimeout(function () { title.dataset.justDragged = '0'; }, 0);
    });
    panel.addEventListener('dragover', function (e) {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      panel.classList.add('drag-over');
    });
    panel.addEventListener('dragleave', function () { panel.classList.remove('drag-over'); });
    panel.addEventListener('drop', function (e) {
      e.preventDefault();
      panel.classList.remove('drag-over');
      var from = PANEL_ORDER.indexOf(e.dataTransfer.getData('text/plain'));
      var to   = PANEL_ORDER.indexOf(panelId);
      if (from < 0 || to < 0 || from === to) return;
      PANEL_ORDER.splice(from, 1);
      PANEL_ORDER.splice(to, 0, PANEL_ORDER[from] || panelId);
      positionSidePanels();
    });
  });

  /* ── Theme toggle ──────────────────────────────────────────────── */
  function toggleTheme() {
    document.body.classList.toggle('light');
    var isLight = document.body.classList.contains('light');
    var btn = document.getElementById('themeBtn');
    if (btn) {
      btn.textContent = isLight ? '☀' : '🌙';
      btn.title       = isLight ? 'Theme: Light' : 'Theme: Dark';
    }
  }
  var themeBtn = document.getElementById('themeBtn');
  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
})();

/* ── Display panel controls ─────────────────────────────────────── */
(function () {
  function wire(id, fn) {
    var el = document.getElementById(id);
    if (el) el.addEventListener(el.type === 'checkbox' || el.tagName === 'INPUT' && el.type === 'checkbox' ? 'change' : 'input', fn);
    return el;
  }
  function wireSlider(sliderId, valId, fn) {
    var sl = document.getElementById(sliderId), vl = document.getElementById(valId);
    if (!sl) return;
    sl.addEventListener('input', function () {
      if (vl) vl.textContent = sl.value;
      fn(parseFloat(sl.value));
    });
  }

  // Label size
  wireSlider('labelSizeSlider', 'labelSizeVal', function(v) {
    if (window._applyLabelSize) window._applyLabelSize(v);
  });

  // Label zoom threshold
  wireSlider('labelZoomSlider', 'labelZoomVal', function(v) {
    window._labelZoomThreshold = v;
  });

  // Show/hide all labels
  wire('toggleLabels', function() {
    var el = document.getElementById('toggleLabels');
    var svg = document.querySelector('#graph-container svg');
    if (svg) svg.classList.toggle('labels-force-hidden', !el.checked);
  });

  // Show/hide edge labels
  wire('toggleEdgeLabels', function() {
    var el = document.getElementById('toggleEdgeLabels');
    var svg = document.querySelector('#graph-container svg');
    if (svg) svg.classList.toggle('edge-labels-hidden', !el.checked);
  });

  // Sticky toggle — dragended() reads window._stickyOverride live
  wire('toggleSticky', function() {
    var el = document.getElementById('toggleSticky');
    window._stickyOverride = el.checked;
  });
  // Set initial value from template
  window._stickyOverride = {{ sticky|int }} === 1;

  // Reset zoom — use the stored zoomBehavior ref
  var resetZoomBtn = document.getElementById('resetZoomBtn');
  if (resetZoomBtn) resetZoomBtn.addEventListener('click', function () {
    var z = window._zoomBehavior;
    var svg = d3.select('#graph-container svg');
    if (z && svg) {
      z.translate([0,0]).scale(1);
      svg.transition().duration(400).call(z.event);
    }
  });

  // Unpin all nodes
  var unpinAllBtn = document.getElementById('unpinAllBtn');
  if (unpinAllBtn) unpinAllBtn.addEventListener('click', function () {
    d3.selectAll('#graph-container circle.node').each(function (d) {
      if (d) d.fixed = 0;
      d3.select(this).style('stroke-dasharray', null);
    });
    if (window._forceRef) window._forceRef.resume();
  });
})();

/* ── Physics panel controls ─────────────────────────────────────── */
(function () {
  function wireSlider(sliderId, valId, fn) {
    var sl = document.getElementById(sliderId), vl = document.getElementById(valId);
    if (!sl) return;
    sl.addEventListener('input', function () {
      if (vl) vl.textContent = sl.value;
      fn(parseFloat(sl.value));
    });
  }

  // Charge — live: calls window._applyCharge() which does force.charge().start()
  wireSlider('chargeSlider', 'chargeVal', function(v) {
    if (window._applyCharge) window._applyCharge(v);
  });

  // Collision — stored in window._collisionOverride; force reads it in linkDistance()
  wireSlider('collisionSlider', 'collisionVal', function(v) {
    window._collisionOverride = v;
    if (window._applyCollision) window._applyCollision();
  });

  // Hull offset — requires redraw via window._applyHullOffset()
  wireSlider('hullSlider', 'hullVal', function(v) {
    if (window._applyHullOffset) window._applyHullOffset(v);
  });
})();

/* ── Export / Save ──────────────────────────────────────────────── */
(function () {
  // Save SVG
  var saveSvgBtn = document.getElementById('saveSvgBtn');
  if (saveSvgBtn) {
    saveSvgBtn.addEventListener('click', function () {
      var svg = document.querySelector('#graph-container svg');
      if (!svg) { alert('Graph not ready.'); return; }
      var serializer = new XMLSerializer();
      var source = serializer.serializeToString(svg);
      if (!source.match(/^<svg[^>]+xmlns=/)) {
        source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
      }
      var blob = new Blob([source], { type: 'image/svg+xml;charset=utf-8' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'elasticgraph.svg';
      document.body.appendChild(a);
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
    });
  }

  // Export JSON
  var saveJsonBtn = document.getElementById('saveJsonBtn');
  if (saveJsonBtn) {
    saveJsonBtn.addEventListener('click', function () {
      var payload = {{ json_data }};
      var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      var a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'elasticgraph-data.json';
      document.body.appendChild(a);
      a.click();
      setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
    });
  }
})();

/* ── Extra CSS for force-hidden labels ──────────────────────────── */
(function () {
  var style = document.createElement('style');
  style.textContent = [
    'svg.labels-force-hidden text.label,',
    'svg.labels-force-hidden text.edge-label { display: none; }',
    'svg.edge-labels-hidden text.edge-label { display: none; }'
  ].join('\n');
  document.head.appendChild(style);
})();
</script>
</body>
</html>
