<!DOCTYPE html>
<!--
Library     : d3blocks
Author      : E.Taskesen
Github      : https://github.com/d3blocks/d3blocks
License     : GPL3
Chart       : Elasticgraph (elastic force-directed network)
-->
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
    <style>{% include "elasticgraph.css" %}</style>
</head>
<body{% if not dark_mode %} class="light"{% endif %}>

<!-- ── Top bar ──────────────────────────────────────────────────── -->
<div class="top-panel">
  <div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
      <img src="{% include 'logo.txt' %}" alt="D3Blocks"
           style="width:150px;height:auto;display:block">
    </a>
  </div>
  <div class="top-panel-center"></div>
  <div class="top-panel-right">
    <button class="button-switch" id="themeBtn" type="button">
      {% if not dark_mode %}☀{% else %}🌙{% endif %}
    </button>
  </div>
</div>

{% if show_controls %}
<!-- ── Panel: Export / Save ─────────────────────────────────────── -->
<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true">
    Export / Save
    <span class="stats-panel-toggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
  </div>
  <div class="stats-panel-body">
    {% if save_button %}
    <button id="saveSvgBtn" class="button-switch" style="width:100%;margin:4px 0" type="button">💾 Save SVG</button>
    {% endif %}
    <button id="saveJsonBtn" class="button-switch" style="width:100%;margin:4px 0" type="button">⬇ Export JSON</button>
  </div>
</div>

<!-- ── Panel: Physics ───────────────────────────────────────────── -->
<div class="stats-panel collapsed" id="physicsPanel">
  <div class="stats-panel-title" draggable="true">
    Physics
    <span class="stats-panel-toggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
  </div>
  <div class="stats-panel-body">
    <div class="physics-control">
      <label>Charge <span id="chargeVal">{{ charge_abs }}</span></label>
      <input type="range" id="chargeSlider" min="50" max="5000" step="50" value="{{ charge_abs }}">
    </div>
    <div class="physics-control">
      <label>Collision <span id="collisionVal">{{ collision }}</span></label>
      <input type="range" id="collisionSlider" min="0.1" max="3.0" step="0.1" value="{{ collision }}">
    </div>
    <div class="physics-control">
      <label>Hull offset <span id="hullVal">{{ hull_offset }}</span></label>
      <input type="range" id="hullSlider" min="0" max="60" step="1" value="{{ hull_offset }}">
    </div>
  </div>
</div>

<!-- ── Panel: Display ───────────────────────────────────────────── -->
<div class="stats-panel collapsed" id="displayPanel">
  <div class="stats-panel-title" draggable="true">
    Display
    <span class="stats-panel-toggle"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></span>
  </div>
  <div class="stats-panel-body">
    <label><input type="checkbox" id="toggleLabels" checked> Show labels</label>
    <label><input type="checkbox" id="toggleEdgeLabels" checked> Show edge labels</label>
    <label><input type="checkbox" id="toggleSticky" {% if sticky %}checked{% endif %}> Sticky nodes</label>
    <label><input type="checkbox" id="toggleSingleClick" {% if single_click_expand %}checked{% endif %}> Single-click expand</label>
    <hr>
    <div class="physics-control">
      <label>Label size <span id="labelSizeVal">{{ point_radius + 8 }}</span> px</label>
      <input type="range" id="labelSizeSlider" min="6" max="32" step="1" value="{{ point_radius + 8 }}">
    </div>
    <div class="physics-control">
      <label>Node size <span id="nodeSizeVal">{{ point_radius }}</span></label>
      <input type="range" id="nodeSizeSlider" min="1" max="30" step="1" value="{{ point_radius }}">
    </div>
    <div class="physics-control">
      <label>Hide labels below zoom <span id="labelZoomVal">{{ label_zoom_threshold }}</span></label>
      <input type="range" id="labelZoomSlider" min="0.1" max="2.0" step="0.05" value="{{ label_zoom_threshold }}">
    </div>
    <hr>
    <button id="resetZoomBtn" class="button-switch" style="width:100%;margin:2px 0" type="button">⌖ Reset zoom</button>
    <button id="unpinAllBtn"  class="button-switch" style="width:100%;margin:2px 0" type="button">📌 Unpin all nodes</button>
    <p class="panel-note">Right-click a pinned node to release it.</p>
  </div>
</div>
{% endif %}

<!-- ── Graph host ────────────────────────────────────────────────── -->
<div id="graph-container"></div>

<script>{% include "d3.v2.js" %}</script>
<script>{% include "elasticgraph.js" %}</script>

<script>
'use strict';

/* ── Init graph ─────────────────────────────────────────────────── */
window.addEventListener('DOMContentLoaded', function () {
  d3graphscript({{ json_data }}, {
    width:                0,
    height:               0,
    dr:                   {{ point_radius }},
    off:                  {{ hull_offset }},
    debug:                {{ debug }},
    single_click_expand:  {{ single_click_expand | int }},
    collision:            {{ collision }},
    charge:               {{ charge }},           // already negative
    sticky:               {{ sticky | int }},
    label_zoom_threshold: {{ label_zoom_threshold }}
  });

  // Set initial label-size override to match the slider's starting value
  window._labelSizeOverride = {{ point_radius + 8 }};
  window._stickyOverride      = {{ sticky | int }} === 1;
  window._singleClickExpand   = {{ single_click_expand | int }} === 1;
  window._labelZoomThreshold  = {{ label_zoom_threshold }};
  window._collisionOverride   = {{ collision }};
});

/* ── Panel infrastructure ───────────────────────────────────────── */
(function () {
  var PANEL_ORDER = ['exportPanel', 'physicsPanel', 'displayPanel'];

  function positionSidePanels() {
    var bar = document.querySelector('.top-panel');
    var gc  = document.getElementById('graph-container');
    var panelW = 0;
    PANEL_ORDER.forEach(function (id) {
      var p = document.getElementById(id);
      if (p) panelW = Math.max(panelW, p.getBoundingClientRect().right);
    });
    if (gc) gc.style.left = (panelW > 0 ? panelW + 8 : 0) + 'px';

    var y = bar ? bar.getBoundingClientRect().bottom + 8 : 60;
    PANEL_ORDER.forEach(function (id) {
      var p = document.getElementById(id);
      if (!p) return;
      p.style.top = y + 'px';
      p.style.maxHeight = Math.max(80, window.innerHeight - y - 12) + 'px';
      y += p.getBoundingClientRect().height + 10;
    });
  }

  window.addEventListener('resize', positionSidePanels);
  window.addEventListener('load',   positionSidePanels);
  requestAnimationFrame(positionSidePanels);
  if (typeof ResizeObserver !== 'undefined') {
    var bar = document.querySelector('.top-panel');
    if (bar) new ResizeObserver(positionSidePanels).observe(bar);
    PANEL_ORDER.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) new ResizeObserver(positionSidePanels).observe(el);
    });
  }

  // Collapse toggle
  PANEL_ORDER.forEach(function (id) {
    var panel = document.getElementById(id); if (!panel) return;
    var title = panel.querySelector('.stats-panel-title'); if (!title) return;
    title.addEventListener('click', function () {
      if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
      var collapsing = !panel.classList.contains('collapsed');
      if (collapsing && panel.style.height) panel.dataset.expandedHeight = panel.style.height;
      else if (panel.dataset.expandedHeight) panel.style.height = panel.dataset.expandedHeight;
      panel.classList.toggle('collapsed');
      setTimeout(positionSidePanels, 0);
    });
  });

  // Drag-reorder
  PANEL_ORDER.forEach(function (panelId) {
    var panel = document.getElementById(panelId); if (!panel) return;
    var title = panel.querySelector('.stats-panel-title'); if (!title) return;
    title.addEventListener('dragstart', function (e) {
      e.dataTransfer.setData('text/plain', panelId);
      e.dataTransfer.effectAllowed = 'move';
    });
    title.addEventListener('dragend', function () {
      title.dataset.justDragged = '1';
      setTimeout(function () { title.dataset.justDragged = '0'; }, 0);
    });
    panel.addEventListener('dragover', function (e) { e.preventDefault(); panel.classList.add('drag-over'); });
    panel.addEventListener('dragleave', function () { panel.classList.remove('drag-over'); });
    panel.addEventListener('drop', function (e) {
      e.preventDefault(); panel.classList.remove('drag-over');
      var from = PANEL_ORDER.indexOf(e.dataTransfer.getData('text/plain'));
      var to   = PANEL_ORDER.indexOf(panelId);
      if (from < 0 || to < 0 || from === to) return;
      var item = PANEL_ORDER.splice(from, 1)[0];
      PANEL_ORDER.splice(to, 0, item);
      positionSidePanels();
    });
  });

  // Theme toggle
  document.getElementById('themeBtn').addEventListener('click', function () {
    document.body.classList.toggle('light');
    var light = document.body.classList.contains('light');
    this.textContent = light ? '☀' : '🌙';
    // Refresh label colours (they read --text from body style at render time)
    if (window._applyLabelSize) window._applyLabelSize(window._labelSizeOverride || 12);
  });
})();

/* ── Physics sliders ────────────────────────────────────────────── */
(function () {
  function sl(id, valId, fn) {
    var el = document.getElementById(id), vl = document.getElementById(valId);
    if (!el) return;
    el.addEventListener('input', function () {
      if (vl) vl.textContent = parseFloat(el.value).toFixed(el.step < 1 ? 1 : 0);
      fn(parseFloat(el.value));
    });
  }

  // Charge — live: force.charge(-v).start()
  sl('chargeSlider', 'chargeVal', function (v) {
    if (window._applyCharge) window._applyCharge(v);
  });

  // Collision — update override then reheat sim
  sl('collisionSlider', 'collisionVal', function (v) {
    window._collisionOverride = v;
    if (window._applyCollision) window._applyCollision();
  });

  // Hull offset — full redraw via _applyHullOffset
  sl('hullSlider', 'hullVal', function (v) {
    if (window._applyHullOffset) window._applyHullOffset(v);
  });
})();

/* ── Display controls ───────────────────────────────────────────── */
(function () {
  function sl(id, valId, fn) {
    var el = document.getElementById(id), vl = document.getElementById(valId);
    if (!el) return;
    el.addEventListener('input', function () {
      if (vl) vl.textContent = parseFloat(el.value).toFixed(el.step < 1 ? 2 : 0);
      fn(parseFloat(el.value));
    });
  }
  function cb(id, fn) {
    var el = document.getElementById(id);
    if (el) el.addEventListener('change', function () { fn(el.checked); });
  }

  // Label size (px)
  sl('labelSizeSlider', 'labelSizeVal', function (v) {
    if (window._applyLabelSize) window._applyLabelSize(v);
  });

  // Node size (dr / point_radius)
  sl('nodeSizeSlider', 'nodeSizeVal', function (v) {
    if (window._applyNodeSize) window._applyNodeSize(v);
  });

  // Label zoom threshold
  sl('labelZoomSlider', 'labelZoomVal', function (v) {
    window._labelZoomThreshold = v;
  });

  // Show/hide labels
  cb('toggleLabels', function (on) {
    var svg = document.querySelector('#graph-container svg');
    if (svg) svg.classList.toggle('labels-force-hidden', !on);
  });

  // Show/hide edge labels
  cb('toggleEdgeLabels', function (on) {
    var svg = document.querySelector('#graph-container svg');
    if (svg) svg.classList.toggle('edge-labels-hidden', !on);
  });

  // Sticky — dragended() reads window._stickyOverride live
  cb('toggleSticky', function (on) { window._stickyOverride = on; });

  // Single-click expand — toggle the behaviour flag read by the click handler
  cb('toggleSingleClick', function (on) { window._singleClickExpand = on; });

  // Reset zoom
  var resetBtn = document.getElementById('resetZoomBtn');
  if (resetBtn) resetBtn.addEventListener('click', function () {
    var z = window._zoomBehavior, svg = d3.select('#graph-container svg');
    if (z && svg) { z.translate([0,0]).scale(1); svg.transition().duration(400).call(z.event); }
  });

  // Unpin all
  var unpinBtn = document.getElementById('unpinAllBtn');
  if (unpinBtn) unpinBtn.addEventListener('click', function () {
    d3.selectAll('#graph-container circle.node').each(function (d) {
      if (d) d.fixed = 0;
      d3.select(this).style('stroke-dasharray', null);
    });
    if (window._forceRef) window._forceRef.resume();
  });
})();

/* ── Export / Save ──────────────────────────────────────────────── */
(function () {
  var saveSvg = document.getElementById('saveSvgBtn');
  if (saveSvg) saveSvg.addEventListener('click', function () {
    var svg = document.querySelector('#graph-container svg');
    if (!svg) { alert('Graph not ready.'); return; }
    var s = new XMLSerializer().serializeToString(svg);
    if (!s.match(/^<svg[^>]+xmlns=/)) s = s.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
    var a = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(new Blob([s], {type:'image/svg+xml'})),
      download: 'elasticgraph.svg'
    });
    document.body.appendChild(a); a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
  });

  var saveJson = document.getElementById('saveJsonBtn');
  if (saveJson) saveJson.addEventListener('click', function () {
    var a = Object.assign(document.createElement('a'), {
      href: URL.createObjectURL(new Blob([JSON.stringify({{ json_data }}, null, 2)], {type:'application/json'})),
      download: 'elasticgraph-data.json'
    });
    document.body.appendChild(a); a.click();
    setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 0);
  });
})();

/* ── Extra CSS ──────────────────────────────────────────────────── */
(function () {
  var s = document.createElement('style');
  s.textContent =
    'svg.labels-force-hidden text.label,' +
    'svg.labels-force-hidden text.edge-label { display:none }' +
    'svg.edge-labels-hidden text.edge-label { display:none }';
  document.head.appendChild(s);
})();
</script>
</body>
</html>
