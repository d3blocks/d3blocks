<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{ TITLE }}</title>
{{ SUPPORT }}
<style>{% include "radialgraph.css" %}</style>
<script>{% include "d3.v7.min.js" %}</script>
</head>
<body{% if darkMode == 'false' %} class="light"{% endif %}>
{% if showControls == 'true' %}

<div class="top-panel" role="toolbar" aria-label="Top controls">
<div class="top-panel-left">
    <a href="https://d3blocks.github.io/d3blocks/" title="D3Blocks">
        <img src="{% include 'logo.txt' %}" alt="D3Blocks" style="width:150px;height:auto;display:block;pointer-events:auto" />
    </a>
</div>
<div class="top-panel-center">
  <div class="search-wrap top-search">
    <input class="search-input" id="searchInput" type="search" placeholder="Find a node…" autocomplete="off" spellcheck="false" />
    <div class="search-results" id="searchResults"></div>
  </div>
</div>
<div class="top-panel-right">
  <button class="button-switch" id="flowDiffButton" type="button">Flow diffusion</button>
  <button class="button-switch" id="rippleBtnTop" type="button">Ripple expand</button>
  <button class="button-switch" id="themeBtn" type="button" title="{% if darkMode == 'false' %}Theme: Light{% else %}Theme: Dark{% endif %}">{% if darkMode == 'false' %}☀{% else %}🌙{% endif %}</button>
</div>
<!-- Hidden anchor button with the id expected by the main script. The visible
     top-panel 'Ripple expand' button will forward clicks to this so the
     existing handlers in d3.radialgraph.js continue to work. -->
<button id="rippleBtn" style="display:none;" aria-hidden="true"></button>
</div>

<div class="stats-panel collapsed" id="exportPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Export<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <button id="exportDataButton" class="button-switch">Export Data</button>
    {{ SAVE_BUTTON_START }}<button id="saveButton" class="button-switch">Save</button>{{ SAVE_BUTTON_STOP }}
  </div>
</div>

<div class="stats-panel collapsed" id="layoutPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Layout<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label><input type="radio" name="layoutMode" value="rings" checked> Rings (radial)</label>
    <label><input type="radio" name="layoutMode" value="global"> Global (force)</label>

    <label><input type="checkbox" id="autoRingSpacingToggle" {% if autoRingSpacing == 'true' %}checked{% endif %}> Auto ring spacing</label>

    <div class="physics-control">
      <label for="ringSpacingSlider">Ring spacing <span id="ringSpacingVal">{{ ringSpacing }}</span></label>
      <input type="range" id="ringSpacingSlider" min="40" max="160" step="5" value="{{ ringSpacing }}" />
    </div>

    <div class="physics-control">
      <label for="rippleDelaySlider">Ripple delay (ms) <span id="rippleDelayVal">{{ rippleDelayMs }}</span></label>
      <input type="range" id="rippleDelaySlider" min="0" max="3000" step="50" value="{{ rippleDelayMs }}" />
    </div>

    <div class="physics-control">
      <label for="nodeSizeMultSlider">Node Size <span id="nodeSizeMultVal">1.0</span>×</label>
      <input type="range" id="nodeSizeMultSlider" min="0.1" max="5" step="0.1" value="1" />
    </div>

    <div class="physics-control">
      <label for="edgeWidthMultSlider">Edge Width <span id="edgeWidthMultVal">1.0</span>×</label>
      <input type="range" id="edgeWidthMultSlider" min="0.1" max="5" step="0.1" value="1" />
    </div>

  </div>
</div>

{% if showStatsPanel == 'true' %}
<div class="stats-panel collapsed" id="statsPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Network Statistic<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label><input type="radio" name="statMetric" value="user_default" checked> Default</label>
    <label><input type="radio" name="statMetric" value="node_proba"> Significance</label>
    <label><input type="radio" name="statMetric" value="node_pagerank"> PageRank</label>
    <label><input type="radio" name="statMetric" value="node_hits_hub"> HITS (Hub)</label>
    <label><input type="radio" name="statMetric" value="node_hits_authority"> HITS (Authority)</label>
    <label><input type="radio" name="statMetric" value="node_degree_centrality"> Degree Centrality</label>
    <label><input type="radio" name="statMetric" value="node_closeness_centrality"> Closeness Centrality</label>
    <label><input type="radio" name="statMetric" value="node_betweenness_centrality"> Betweenness Centrality</label>
    <label><input type="radio" name="statMetric" value="network_clustering"> Network Clustering</label>
  </div>
</div>
{% endif %}

<div class="stats-panel collapsed" id="edgeStatPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Edge Statistics<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label><input type="radio" name="edgeStatMode" value="default" checked> Default</label>
    <label><input type="radio" name="edgeStatMode" value="community"> Community</label>
    <input type="radio" name="edgeStatMode" value="flow-home" style="display:none">
  </div>
</div>
<div class="stats-panel collapsed" id="edgeFilterPanel">
  <div class="stats-panel-title" draggable="true" title="Drag to reorder panels">Edge Filters<span class="stats-panel-toggle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg></span></div>
  <div class="stats-panel-body">
    <label><input type="checkbox" id="crossLinksToggle" checked> Show cross-links</label>
    <label><input type="checkbox" name="edgeDirFilter" value="outbound" checked> Outbound</label>
    <label><input type="checkbox" name="edgeDirFilter" value="inbound" checked> Inbound</label>
    <label><input type="checkbox" name="edgeDirFilter" value="bidirectional" checked> Bidirectional</label>
    <label><input type="checkbox" id="hideIsolatedToggle"> Hide nodes without edges</label>
  </div>
</div>

{% endif %}
<div id="radialgraph-container"></div>
<div class="radialgraph-tooltip" id="radialgraph-tooltip"></div>
<div id="hint">tap to expand/collapse · double-tap to focus · drag · scroll/pinch to zoom</div>
{% if showNodePanel == 'true' %}
<div id="nodePanel" role="dialog" aria-label="Node details">
  <div id="nodePanelResizer" class="node-panel-resizer" title="Drag to resize" aria-hidden="false"></div>
  <div class="node-panel-header">
    <div><div class="node-panel-title" id="nodePanelTitle">—</div><div class="node-panel-sub" id="nodePanelSub"></div></div>
    <div style="display:flex;gap:8px;align-items:center">
      <button class="button-switch" id="nodeFlowBtn" type="button">Flow from here</button>
      <button class="button-switch" id="nodeCenterBtn" type="button">Set as center</button>
      <button class="node-panel-close" id="nodePanelClose" type="button">✕</button>
    </div>
  </div>
  <div class="node-panel-body">
    <div class="node-stats-grid" id="nodeStatsGrid"></div>
    <div class="node-importance" id="nodeImportance"></div>
  </div>
</div>
{% endif %}
<script>
  const radialgraphData = {{ json_data }};
  const radialgraphConfig = {
    "width": {{ WIDTH }}, "height": {{ HEIGHT }}, "fontSize": {{ fontsize }},
    "center": {{ center }}, "ringSpacing": {{ ringSpacing }},
    "autoRingSpacing": {{ autoRingSpacing }}, "radialStrength": {{ radialStrength }},
    "rippleDelayMs": {{ rippleDelayMs }}, "charge": {{ charge }},
    "collision": {{ collision }}, "linkDistance": {{ linkDistance }},
    "linkStrength": {{ linkStrength }}, "sticky": {{ sticky }},
    "significanceAlpha": {{ SIGNIFICANCE_ALPHA }}, "darkMode": {{ darkMode }},
    "showStatsPanel": {{ showStatsPanel }}, "showNodePanel": {{ showNodePanel }},
    "showControls": {{ showControls }},
    "expandAllOnLoad": {{ expandAllOnLoad }}
  };
</script>
<script>{% include "d3.radialgraph.js" %}</script>
<script>
function positionSidePanels() {
  var panels = Array.from(document.querySelectorAll(".stats-panel"));
  var topPanel = document.querySelector('.top-panel');
  var y = 10 + (topPanel ? topPanel.getBoundingClientRect().height + 8 : 0);
  var maxRight = 0;
  panels.forEach(function (panel) {
    panel.style.top = y + "px";
    panel.style.left = "10px";
    panel.style.maxHeight = "calc(100vh - " + Math.round(y + 10) + "px)";
    y += panel.getBoundingClientRect().height + 8;
    var r = panel.getBoundingClientRect().right;
    if (r > maxRight) maxRight = r;
  });

  // If the left-side menu is collapsed, panels are hidden and the left inset
  // should be 0. Otherwise make the bottom nodePanel and hints start after
  // the right edge of the widest visible panel (plus a small gap).
  var nodePanel = document.getElementById('nodePanel');
  var radialContainer = document.getElementById('radialgraph-container');
  var hint = document.getElementById('hint');
  var collapsed = document.body.classList.contains('panel-collapsed');
  var leftInset = collapsed ? 0 : Math.max(220, Math.ceil(maxRight) + 8);
  if (nodePanel) nodePanel.style.left = leftInset + 'px';
  if (radialContainer) radialContainer.style.left = leftInset + 'px';
  if (hint) hint.style.left = leftInset + 'px';
}

	window.addEventListener("DOMContentLoaded", positionSidePanels);
	window.addEventListener("resize", positionSidePanels);
	if (window.ResizeObserver) {
	  var o = new ResizeObserver(positionSidePanels);
	  document.querySelectorAll(".stats-panel").forEach(function (p) { o.observe(p); });
	  var tp = document.querySelectorAll('.top-panel'); tp.forEach(function (p) { o.observe(p); });
	}
	document.querySelectorAll(".stats-panel-title").forEach(function (title) {
	  title.addEventListener("click", function () {
	    if (title.dataset.justDragged === '1') { title.dataset.justDragged = '0'; return; }
	    var panel = title.parentElement, collapsing = !panel.classList.contains("collapsed");
	    if (collapsing) { if (panel.style.height) panel.dataset.expandedHeight = panel.style.height; panel.style.height = ""; }
	    else if (panel.dataset.expandedHeight) panel.style.height = panel.dataset.expandedHeight;
	    panel.classList.toggle("collapsed"); positionSidePanels();
	  });
	});

	// —— Drag-and-drop panel reordering ——————————————————————————
	// Unlike scatter/sankey, positionSidePanels() here stacks panels by
	// querying document.querySelectorAll(".stats-panel") in DOM order
	// (rather than a separate order array), so reordering is done by
	// physically moving the panel node in the DOM via insertBefore, then
	// reflowing -- no separate order list to keep in sync.
	(function setupPanelReordering() {
	  document.querySelectorAll(".stats-panel").forEach(function (panel) {
	    var title = panel.querySelector(".stats-panel-title");
	    if (!title) return;
	    title.addEventListener("dragstart", function (e) {
	      e.dataTransfer.setData("text/plain", panel.id);
	      e.dataTransfer.effectAllowed = "move";
	    });
	    title.addEventListener("dragend", function () {
	      title.dataset.justDragged = "1";
	      setTimeout(function () { title.dataset.justDragged = "0"; }, 0);
	    });
	    panel.addEventListener("dragover", function (e) {
	      e.preventDefault();
	      e.dataTransfer.dropEffect = "move";
	      panel.classList.add("drag-over");
	    });
	    panel.addEventListener("dragleave", function () {
	      panel.classList.remove("drag-over");
	    });
	    panel.addEventListener("drop", function (e) {
	      e.preventDefault();
	      panel.classList.remove("drag-over");
	      var draggedId = e.dataTransfer.getData("text/plain");
	      if (!draggedId || draggedId === panel.id) return;
	      var draggedEl = document.getElementById(draggedId);
	      if (!draggedEl || !panel.parentNode) return;
	      panel.parentNode.insertBefore(draggedEl, panel);
	      positionSidePanels();
	    });
	  });
	})();

	// —— Theme button: 🌙/☀ instead of text ——————————————————————
	// Now handled directly in d3_radialgraph.js's toggleTheme() (it sets
	// themeBtn.textContent based on document.body's 'light' class, not by
	// reading prior text, so it was safe to change there directly) and via
	// the initial Jinja-rendered emoji above. Nothing else needed here.

	// —— Node panel resizer: drag to change height, double-click to toggle collapsed ——
	(function () {
	  var nodePanel = document.getElementById('nodePanel');
	  var resizer = document.getElementById('nodePanelResizer');
	  var dragging = false;
	  var startY = 0;
	  var startHeight = 0;
	  var minHeight = 40; // px, allow small so it can appear closed
	  var maxHeight = Math.round(window.innerHeight * 0.85);

	  if (!nodePanel || !resizer) return;

	  function clamp(h) { return Math.max(0, Math.min(h, Math.round(window.innerHeight * 0.95))); }

	  function setPanelHeight(h) {
	    if (h <= minHeight) {
	      // consider 'closed' when very small: remove open state
	      nodePanel.style.maxHeight = minHeight + 'px';
	      nodePanel.classList.remove('open');
	    } else {
	      nodePanel.style.maxHeight = h + 'px';
	      if (!nodePanel.classList.contains('open')) nodePanel.classList.add('open');
	    }
	  }

	  resizer.addEventListener('mousedown', startDrag);
	  resizer.addEventListener('touchstart', startDrag, { passive: false });

	  function startDrag(e) {
	    e.preventDefault();
	    dragging = true;
	    startY = (e.touches && e.touches[0]) ? e.touches[0].clientY : e.clientY;
	    startHeight = nodePanel.getBoundingClientRect().height;
	    document.documentElement.classList.add('resizing');
	    window.addEventListener('mousemove', onDrag);
	    window.addEventListener('touchmove', onDrag, { passive: false });
	    window.addEventListener('mouseup', stopDrag);
	    window.addEventListener('touchend', stopDrag);
	  }

	  function onDrag(e) {
	    if (!dragging) return;
	    e.preventDefault();
	    var y = (e.touches && e.touches[0]) ? e.touches[0].clientY : e.clientY;
	    var dy = startY - y; // move up increases height
	    var newHeight = clamp(startHeight + dy);
	    setPanelHeight(newHeight);
	  }

	  function stopDrag() {
	    if (!dragging) return;
	    dragging = false;
	    document.documentElement.classList.remove('resizing');
	    window.removeEventListener('mousemove', onDrag);
	    window.removeEventListener('touchmove', onDrag);
	    window.removeEventListener('mouseup', stopDrag);
	    window.removeEventListener('touchend', stopDrag);
	    // persist last height in dataset for later restore
	    var h = nodePanel.getBoundingClientRect().height;
	    nodePanel.dataset.lastHeight = String(h);
	  }

	  // double-click toggles fully closed/open
	  resizer.addEventListener('dblclick', function () {
	    if (!nodePanel.classList.contains('open')) {
	      // restore last height or default
	      var h = parseInt(nodePanel.dataset.lastHeight || Math.round(window.innerHeight * 0.35), 10);
	      setPanelHeight(clamp(h));
	    } else {
	      // close
	      nodePanel.classList.remove('open');
	      nodePanel.dataset.lastHeight = String(nodePanel.getBoundingClientRect().height);
	      nodePanel.style.maxHeight = minHeight + 'px';
	    }
	  });

	})();
	</script>
<script>
// Export Data button: download the raw JSON for the current graph
const exportDataBtn = document.getElementById('exportDataButton');
if (exportDataBtn) {
  exportDataBtn.addEventListener('click', function () {
    try {
      const dataStr = JSON.stringify(radialgraphData, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '{{ TITLE }}_data.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      console.error('Export failed', err);
      alert('Failed to export data.');
    }
  });
}

// Flow diffusion top-button: toggle the edgeStatMode between 'flow-home' and the default
const flowBtn = document.getElementById('flowDiffButton');
if (flowBtn) {
  // initialize visual state if script set flow mode prior
  try { if (typeof edgeStatMode !== 'undefined' && edgeStatMode === 'flow-home') flowBtn.classList.add('active'); } catch(e){}
  flowBtn.addEventListener('click', function () {
    try {
      // Use the existing radio change handlers in d3.radialgraph.js by toggling
      // a hidden 'flow-home' radio and dispatching a change event. This keeps
      // all metric recomputation and animation startup in one place.
      const flowRadio = document.querySelector('input[name="edgeStatMode"][value="flow-home"]');
      const defaultRadio = document.querySelector('input[name="edgeStatMode"][value="default"]');
      if (!flowRadio) {
        console.warn('flow radio not present');
        return;
      }
      if (flowRadio.checked) {
        // turn off flow: select default radio
        if (defaultRadio) {
          defaultRadio.checked = true;
          defaultRadio.dispatchEvent(new Event('change', { bubbles: true }));
        } else {
          // fallback: uncheck flow and manually trigger update
          flowRadio.checked = false;
          flowRadio.dispatchEvent(new Event('change', { bubbles: true }));
        }
        flowBtn.classList.remove('active');
      } else {
        // turn on flow by checking the hidden radio and firing change
        flowRadio.checked = true;
        flowRadio.dispatchEvent(new Event('change', { bubbles: true }));
        flowBtn.classList.add('active');
      }
    } catch (err) {
      console.error('Flow toggle failed', err);
    }
  });
}

// Forward top-panel ripple button clicks to the hidden rippleBtn so the
// existing ripple logic in d3.radialgraph.js (which attaches to #rippleBtn)
// runs unchanged.
const rippleTop = document.getElementById('rippleBtnTop');
const rippleHidden = document.getElementById('rippleBtn');
if (rippleTop && rippleHidden) {
  rippleTop.addEventListener('click', function (e) { rippleHidden.click(); });
  // Keep visual active state in sync: when hidden button text changes the
  // script may set disabled/text; observe attribute changes and mirror active state
  const obs = new MutationObserver(() => {
    if (!rippleHidden) return;
    const isBusy = rippleHidden.disabled || (rippleHidden.textContent || '').toLowerCase().includes('rippl');
    rippleTop.disabled = rippleHidden.disabled;
    rippleTop.classList.toggle('active', rippleHidden.classList.contains('active') || isBusy);
  });
  obs.observe(rippleHidden, { attributes: true, childList: true, subtree: true, characterData: true });
}
</script>
<script>{{ SAVE_TO_SVG_SCRIPT }}</script>
</body>
</html>
